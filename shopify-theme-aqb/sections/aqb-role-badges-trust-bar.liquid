{%- if page.handle == 'role-badges' or template.suffix == 'role-badges' or page.handle == 'church-religious-catalog' or template.suffix == 'church-religious-catalog' -%}
<div class="aqb-rb-trust-bar">
  <div class="aqb-rb-trust-inner">
    {%- for block in section.blocks -%}
      <div class="aqb-rb-trust-tile" {{ block.shopify_attributes }}>
        <span class="aqb-rb-trust-icon" aria-hidden="true">{{ block.settings.emoji }}</span>
        <div>
          <div class="aqb-rb-trust-label">{{ block.settings.title | escape }}</div>
          {%- if block.settings.subtitle != blank -%}
            <div class="aqb-rb-trust-desc">{{ block.settings.subtitle | escape }}</div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "AQB Role Badges Trust Bar",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ships same day" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Role Badges Trust Bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "emoji": "⚡",
            "title": "Ships same day",
            "subtitle": "Orders placed before 2 PM Eastern leave the same day, Monday–Friday."
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "📦",
            "title": "Free shipping at 5+",
            "subtitle": "Order 5 or more packs and shipping is always on us."
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "✓",
            "title": "Professional finish",
            "subtitle": "Clear, durable printing on standard 1×3\" badge blanks."
          }
        },
        {
          "type": "item",
          "settings": {
            "emoji": "📉",
            "title": "Volume discounts",
            "subtitle": "Pricing drops automatically as you add more packs to your cart."
          }
        }
      ]
    }
  ]
}
{% endschema %}
