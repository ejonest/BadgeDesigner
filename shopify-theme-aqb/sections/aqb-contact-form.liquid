{%- if page.handle == 'contact' or template.suffix == 'contact' -%}
<section class="aqb-ct-form-section" id="contact-form">
  <div class="aqb-ct-form-section__inner">
    <div class="aqb-ct-form-main">
      <div class="aqb-ct-form-card">
        {%- if section.settings.form_badge != blank -%}
          <div class="aqb-ct-form-card__badge">{{ section.settings.form_badge | escape }}</div>
        {%- endif -%}

        {%- if section.settings.form_heading != blank -%}
          <h2 class="aqb-ct-form-card__heading">{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.form_subheading != blank -%}
          <p class="aqb-ct-form-card__sub">{{ section.settings.form_subheading | escape }}</p>
        {%- endif -%}

        {%- form 'contact', id: 'AqbContactForm', class: 'aqb-ct-form' -%}
          <input type="hidden" name="contact[Subject]" value="{{ section.settings.email_subject | escape }}">

          {%- if form.posted_successfully? -%}
            <div class="aqb-ct-form-status aqb-ct-form-status--success" tabindex="-1" autofocus>
              {{ section.settings.success_message | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="aqb-ct-form-status aqb-ct-form-status--error" role="alert" tabindex="-1" autofocus>
              {{ section.settings.error_message | escape }}
            </div>
          {%- endif -%}

          <div class="aqb-ct-form-grid">
            <div class="aqb-ct-field">
              <label for="AqbContactForm-name">{{ section.settings.name_label | escape }} <span>*</span></label>
              <input
                type="text"
                id="AqbContactForm-name"
                name="contact[Name]"
                autocomplete="name"
                required
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>

            <div class="aqb-ct-field">
              <label for="AqbContactForm-phone">{{ section.settings.phone_field_label | escape }}</label>
              <input
                type="tel"
                id="AqbContactForm-phone"
                name="contact[Phone]"
                autocomplete="tel"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              >
            </div>

            <div class="aqb-ct-field aqb-ct-field--full">
              <label for="AqbContactForm-email">{{ section.settings.email_field_label | escape }} <span>*</span></label>
              <input
                type="email"
                id="AqbContactForm-email"
                name="contact[email]"
                autocomplete="email"
                required
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </div>

            <div class="aqb-ct-field aqb-ct-field--full">
              <label for="AqbContactForm-topic">{{ section.settings.topic_label | escape }} <span>*</span></label>
              <select id="AqbContactForm-topic" name="contact[Topic]" required>
                <option value="" disabled selected>{{ section.settings.topic_placeholder | escape }}</option>
                {%- for block in section.blocks -%}
                  {%- if block.type == 'topic_option' -%}
                    <option value="{{ block.settings.value | escape }}">{{ block.settings.label | escape }}</option>
                  {%- endif -%}
                {%- endfor -%}
              </select>
            </div>

            <div class="aqb-ct-field aqb-ct-field--full">
              <label for="AqbContactForm-order">{{ section.settings.order_label | escape }}</label>
              <input
                type="text"
                id="AqbContactForm-order"
                name="contact[Order Number]"
                placeholder="{{ section.settings.order_placeholder | escape }}"
              >
            </div>

            <div class="aqb-ct-field aqb-ct-field--full">
              <label for="AqbContactForm-message">{{ section.settings.message_label | escape }} <span>*</span></label>
              <textarea
                id="AqbContactForm-message"
                name="contact[body]"
                required
                placeholder="{{ section.settings.message_placeholder | escape }}"
              >{{- form.body -}}</textarea>
            </div>
          </div>

          <button type="submit" class="aqb-ct-form-submit">{{ section.settings.submit_label | escape }}</button>
          {%- if section.settings.fine_print != blank -%}
            <p class="aqb-ct-form-fine">{{ section.settings.fine_print | escape }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <aside class="aqb-ct-form-sidebar">
      {%- if section.settings.info_intro != blank -%}
        <p class="aqb-ct-sidebar__intro">{{ section.settings.info_intro | escape }}</p>
      {%- endif -%}

      {%- if section.settings.address != blank -%}
        <div class="aqb-ct-address-card">
          <div class="aqb-ct-address-card__label">{{ section.settings.address_label | escape }}</div>
          <div class="aqb-ct-address-card__value">{{ section.settings.address | newline_to_br }}</div>
        </div>
      {%- endif -%}

      {%- assign quick_links = section.blocks | where: 'type', 'quick_link' -%}
      {%- if quick_links.size > 0 -%}
        <div class="aqb-ct-quick-links">
          {%- for block in quick_links -%}
            {%- if block.settings.label != blank and block.settings.url != blank -%}
              <a href="{{ block.settings.url }}" class="aqb-ct-quick-link" {{ block.shopify_attributes }}>
                {{- block.settings.label | escape -}}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.promise_heading != blank or section.settings.promise_text != blank -%}
        <div class="aqb-ct-promise-card">
          {%- if section.settings.promise_heading != blank -%}
            <h3>{{ section.settings.promise_heading | escape }}</h3>
          {%- endif -%}
          {%- if section.settings.promise_text != blank -%}
            <p>{{ section.settings.promise_text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.phone != blank or section.settings.email != blank -%}
        <details class="aqb-ct-alt-contact">
          <summary class="aqb-ct-alt-contact__toggle">
            {{ section.settings.alt_contact_label | escape }}
          </summary>
          <div class="aqb-ct-alt-contact__panel">
            {%- if section.settings.alt_contact_note != blank -%}
              <p class="aqb-ct-alt-contact__note">{{ section.settings.alt_contact_note | escape }}</p>
            {%- endif -%}
            <ul class="aqb-ct-alt-contact__list">
              {%- if section.settings.phone != blank -%}
                <li>
                  <span>{{ section.settings.phone_label | escape }}</span>
                  <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
                    {{- section.settings.phone | escape -}}
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.email != blank -%}
                <li>
                  <span>{{ section.settings.email_label | escape }}</span>
                  <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </details>
      {%- endif -%}
    </aside>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "AQB Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "textarea", "id": "info_intro", "label": "Sidebar intro", "default": "Send us a message using the form — it's the fastest way to reach our team. We typically reply the same business day." },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone" },
    { "type": "text", "id": "phone", "label": "Phone number", "default": "(310) 534-1138" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "email", "label": "Email address", "default": "info@allquality.com" },
    { "type": "text", "id": "address_label", "label": "Address label", "default": "Mailing address" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "All Quality Badges\n2782 Gundry Ave\nSignal Hill, CA 90755" },
    { "type": "text", "id": "alt_contact_label", "label": "Alt contact toggle", "default": "Prefer phone or email instead?" },
    { "type": "textarea", "id": "alt_contact_note", "label": "Alt contact note", "default": "We still monitor these, but the contact form helps us route your request faster." },
    { "type": "text", "id": "promise_heading", "label": "Promise card heading", "default": "Same-day responses when we can" },
    { "type": "textarea", "id": "promise_text", "label": "Promise card text", "default": "Messages received Monday through Friday during business hours are usually answered the same day. For bulk or volume pricing, visit our Bulk Orders page for a faster quote." },
    { "type": "text", "id": "form_badge", "label": "Form badge", "default": "Preferred contact method" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "text", "id": "form_subheading", "label": "Form subheading", "default": "Fill out the form below and our team will get back to you — usually the same business day." },
    { "type": "text", "id": "email_subject", "label": "Email subject line", "default": "Contact Form — All Quality Badges" },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "phone_field_label", "label": "Phone field label", "default": "Your phone" },
    { "type": "text", "id": "email_field_label", "label": "Email field label", "default": "Your email" },
    { "type": "text", "id": "topic_label", "label": "Topic label", "default": "What can we help with?" },
    { "type": "text", "id": "topic_placeholder", "label": "Topic placeholder", "default": "Select a topic..." },
    { "type": "text", "id": "order_label", "label": "Order number label", "default": "Order number (optional)" },
    { "type": "text", "id": "order_placeholder", "label": "Order number placeholder", "default": "If your question is about an existing order" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Your message" },
    { "type": "textarea", "id": "message_placeholder", "label": "Message placeholder", "default": "Tell us how we can help..." },
    { "type": "text", "id": "submit_label", "label": "Submit button", "default": "Send Message →" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By submitting, you agree to be contacted about your inquiry." },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thank you — your message has been sent. We'll get back to you as soon as we can." },
    { "type": "textarea", "id": "error_message", "label": "Error message", "default": "Please check your email address and required fields, then try again." }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Bulk orders" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "topic_option",
      "name": "Topic option",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "General inquiry" },
        { "type": "text", "id": "value", "label": "Value", "default": "General inquiry" }
      ]
    }
  ],
  "presets": [{ "name": "AQB Contact Form" }]
}
{% endschema %}
