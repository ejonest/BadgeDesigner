{%- if collection.handle == 'all' -%}
{%- liquid
  assign ap_collection = collection
  if section.settings.collection != blank
    assign ap_collection = section.settings.collection
  endif
  assign products_per_page = section.settings.products_per_page | default: 12
  assign catalogue_base = section.settings.catalogue_base | default: '/collections/all'
-%}

<section class="aqb-ap-catalogue" id="all-products-catalogue">
  <div class="aqb-ap-catalogue__inner">
    <div class="aqb-ap-layout">
      <aside class="aqb-ap-sidebar" id="all-products-catalogue-filters" aria-label="Filter products">
        <button type="button" class="aqb-ap-sidebar__toggle" id="all-products-filter-toggle" aria-expanded="false" aria-controls="all-products-filter-panel">
          <span>Filters</span>
          <span class="aqb-ap-sidebar__toggle-icon" aria-hidden="true"></span>
        </button>

        <div class="aqb-ap-sidebar__panel" id="all-products-filter-panel">
          <div class="aqb-ap-filter-section">
            <h3 class="aqb-ap-filter-section__title">Product Type</h3>
            <ul class="aqb-ap-filter-list" id="all-products-filter-types">
              {%- for block in section.blocks -%}
                {%- if block.type == 'product_type' -%}
                  <li>
                    <label class="aqb-ap-filter-check">
                      <input
                        type="checkbox"
                        name="product-type"
                        value="{{ block.settings.type_id | escape }}"
                        data-product-type="{{ block.settings.type_id | escape }}"
                      >
                      <span>{{ block.settings.label | escape }}</span>
                    </label>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

          <div class="aqb-ap-filter-section">
            <h3 class="aqb-ap-filter-section__title">Sort &amp; Filters</h3>

            <label class="aqb-ap-filter-field" for="all-products-sort">
              <span class="aqb-ap-filter-field__label">Sort by</span>
              <select id="all-products-sort" class="aqb-ap-filter-select">
                <option value="featured">Featured</option>
                <option value="price-asc">Price: low to high</option>
                <option value="price-desc">Price: high to low</option>
                <option value="bestseller">Best sellers</option>
                <option value="alpha-asc">Alphabetical (A–Z)</option>
                <option value="alpha-desc">Alphabetical (Z–A)</option>
              </select>
            </label>

            <div class="aqb-ap-filter-field">
              <span class="aqb-ap-filter-field__label">Price range</span>
              <div class="aqb-ap-price-range">
                <label class="aqb-ap-price-range__field">
                  <span class="visually-hidden">Minimum price</span>
                  <span class="aqb-ap-price-range__prefix">$</span>
                  <input type="number" id="all-products-price-min" class="aqb-ap-price-input" min="0" step="0.01" placeholder="Min">
                </label>
                <span class="aqb-ap-price-range__sep" aria-hidden="true">–</span>
                <label class="aqb-ap-price-range__field">
                  <span class="visually-hidden">Maximum price</span>
                  <span class="aqb-ap-price-range__prefix">$</span>
                  <input type="number" id="all-products-price-max" class="aqb-ap-price-input" min="0" step="0.01" placeholder="Max">
                </label>
              </div>
            </div>

            <ul class="aqb-ap-filter-list">
              <li>
                <label class="aqb-ap-filter-check">
                  <input type="checkbox" id="all-products-adult" value="1">
                  <span>Include 18+ products</span>
                </label>
              </li>
            </ul>

            <button type="button" class="aqb-ap-filter-clear" id="all-products-filter-clear">Clear all filters</button>
          </div>
        </div>
      </aside>

      <div class="aqb-ap-main">
        <div class="aqb-ap-section-header">
          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="aqb-ap-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2>{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
          <div class="aqb-ap-section-count" id="all-products-product-count">Showing products</div>
        </div>

        <div
          class="aqb-ap-product-grid"
          id="all-products-product-grid"
          data-page-size="{{ products_per_page }}"
          data-catalogue-base="{{ catalogue_base | escape }}"
          data-collection-handle="{{ ap_collection.handle | escape }}"
          data-total-products="{{ ap_collection.products_count | default: 0 }}"
          data-add-label="{{ section.settings.add_label | escape }}"
          data-cart-add-url="{{ routes.cart_add_url }}"
        >
          {%- if ap_collection != blank -%}
            {%- paginate ap_collection.products by 250 -%}
              {%- for product in ap_collection.products -%}
                {%- render 'aqb-all-products-catalogue-card',
                  product: product,
                  section: section,
                  product_index: forloop.index0
                -%}
              {%- endfor -%}
            {%- endpaginate -%}
          {%- endif -%}
        </div>

        <div class="aqb-ap-load-more-wrap" id="all-products-load-more-wrap" hidden>
          <button type="button" class="aqb-ap-btn-outline" id="all-products-load-more">
            {{ section.settings.load_more_label | escape }}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="aqb-ap-scroll-controls" id="all-products-scroll-controls" aria-label="Scroll navigation">
  <button type="button" class="aqb-ap-scroll-btn" id="all-products-scroll-top" aria-label="Scroll to top">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3L3 9h10L8 3z" fill="currentColor"/></svg>
  </button>
  <button type="button" class="aqb-ap-scroll-btn" id="all-products-scroll-bottom" aria-label="Scroll to bottom">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 13L3 7h10l-5 6z" fill="currentColor"/></svg>
  </button>
</div>

<script type="application/json" id="all-products-filter-config">
{
  "productTypes": [
    {%- assign type_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'product_type' -%}
        {%- unless type_first -%},{%- endunless -%}
        {"id":{{ block.settings.type_id | json }},"label":{{ block.settings.label | json }},"tags":{{ block.settings.tags | downcase | split: ',' | json }}}
        {%- assign type_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
<script src="{{ 'aqb-all-products-catalogue.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "AQB All Products Catalog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection",
      "info": "Defaults to the current collection when using the All Products template."
    },
    {
      "type": "text",
      "id": "catalogue_base",
      "label": "Catalog page path",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop All"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Browse all <em>products</em>"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "Show more products"
    }
  ],
  "blocks": [
    {
      "type": "product_type",
      "name": "Product type filter",
      "settings": [
        { "type": "text", "id": "type_id", "label": "Type ID", "default": "role-badges" },
        { "type": "text", "id": "label", "label": "Label", "default": "Role Badges" },
        { "type": "text", "id": "tags", "label": "Matching tags (comma-separated)", "default": "role-badge", "info": "Used when loading additional products via JSON." }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB All Products Catalog",
      "blocks": [
        { "type": "product_type", "settings": { "type_id": "role-badges", "label": "Role Badges", "tags": "role-badge" } },
        { "type": "product_type", "settings": { "type_id": "desk-plates", "label": "Desk Name Plates", "tags": "desk-sign" } },
        { "type": "product_type", "settings": { "type_id": "name-tag-blanks", "label": "Name Tag Blanks", "tags": "name-tag-blank, blank-name-tag, type_blank" } },
        { "type": "product_type", "settings": { "type_id": "custom-badges", "label": "Custom Badges", "tags": "custom" } }
      ]
    }
  ]
}
{% endschema %}
