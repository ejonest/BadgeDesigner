{% comment %}
  Section: AQB Email Signup with Offer
  CSS lives in assets/base.css — search for "AQB SECTIONS CSS"
{% endcomment %}

<div class="aqb-email-signup color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    <div class="aqb-email-signup__inner">

      <div class="aqb-email-signup__content">
        {% if section.settings.eyebrow != blank %}
          <p class="aqb-email-signup__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 class="aqb-email-signup__title {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
        {% if section.settings.subheading != blank %}
          <p class="aqb-email-signup__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </div>

      <div class="aqb-email-signup__form-wrap">
        {% form 'customer', id: 'aqb-email-form', class: 'aqb-email-signup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,homepage-offer">
          <div class="aqb-email-signup__field-row">
            <label for="aqb-email-input" class="visually-hidden">{{ section.settings.input_placeholder | default: 'Email address' | escape }}</label>
            <input
              id="aqb-email-input"
              type="email"
              name="contact[email]"
              class="aqb-email-signup__input field__input"
              placeholder="{{ section.settings.input_placeholder | default: 'Enter your email' | escape }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="aqb-email-signup__btn button button--primary">
              {{ section.settings.button_label | default: 'Get 10% Off' | escape }}
            </button>
          </div>
          {% if form.errors %}
            <p class="aqb-email-signup__error" role="alert">{{ form.errors | default_errors }}</p>
          {% endif %}
          {% if form.posted_successfully? %}
            <p class="aqb-email-signup__success" role="status">{{ section.settings.success_message | default: "You're in! Check your email for your discount code." | escape }}</p>
          {% endif %}
        {% endform %}
        {% if section.settings.disclaimer != blank %}
          <p class="aqb-email-signup__disclaimer">{{ section.settings.disclaimer | escape }}</p>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Email Signup with Offer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Exclusive Offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% Off Your First Order" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Join our list for deals, new products, and bulk pricing tips." },
    { "type": "text", "id": "input_placeholder", "label": "Email input placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get 10% Off" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in! Check your email for your discount code." },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer text", "default": "We respect your privacy. Unsubscribe anytime." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "presets": [{ "name": "Email Signup with Offer" }]
}
{% endschema %}
