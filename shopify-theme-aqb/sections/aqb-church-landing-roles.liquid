{%- if page.handle == 'church-and-congregation' or template.suffix == 'church-and-congregation' -%}
<section class="aqb-ch-roles" id="church-ministry-roles">
  <div class="aqb-ch-roles__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="aqb-ch-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="aqb-ch-section-h2">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <p class="aqb-ch-section-desc">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    <div class="aqb-ch-roles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_link = block.settings.link
          if block.settings.collection != blank
            assign card_link = block.settings.collection.url
          endif
          if card_link == blank
            assign card_link = '#'
          endif
        -%}
        <a href="{{ card_link }}" class="aqb-ch-role-card" {{ block.shopify_attributes }}>
          <div class="aqb-ch-role-card__photo{% if block.settings.image == blank %} aqb-ch-photo-placeholder{% endif %}">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: loading: 'lazy', widths: '300,400,600', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.title, class: ''
              }}
            {%- endif -%}
          </div>
          <div class="aqb-ch-role-card__info">
            <div class="aqb-ch-role-card__name">{{ block.settings.title | escape }}</div>
            {%- if block.settings.description != blank -%}
              <div class="aqb-ch-role-card__type">{{ block.settings.description | escape }}</div>
            {%- endif -%}
            {%- if block.settings.tag != blank -%}
              <div class="aqb-ch-role-card__tag">{{ block.settings.tag | escape }}</div>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <span class="aqb-ch-role-card__cta">{{ block.settings.cta_label | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "AQB Church Role Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by ministry role"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Everything your ministry <em>needs.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Browse pre-designed badges by role — each collection is ready to order in multi-packs with free US shipping."
    }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Role card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Greeters & Ushers" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Multi-packs available" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop collection →" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (overrides collection URL if set)" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Church Role Grid",
      "blocks": [
        {
          "type": "role",
          "settings": {
            "title": "Greeters & Ushers",
            "description": "Classic engraved badges for welcome teams, hospitality volunteers, greeters and ushers.",
            "tag": "★ Top seller",
            "cta_label": "Shop collection →"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Pastors & Leadership",
            "description": "Professional engraved name badges for pastors, elders, ministry leaders and church staff.",
            "tag": "Multi-packs available",
            "cta_label": "Shop Leadership →"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Welcome Ministry",
            "description": "Friendly, easy-to-read badges that help guests feel welcomed from the moment they arrive.",
            "tag": "Multi-packs available",
            "cta_label": "Shop Welcome Team →"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Spanish Ministry Collection",
            "description": "The only complete bilingual congregation badge collection for Hispanic ministries and Spanish-speaking congregations.",
            "tag": "🌎 En Español",
            "cta_label": "Shop Spanish Collection →"
          }
        }
      ]
    }
  ]
}
{% endschema %}
