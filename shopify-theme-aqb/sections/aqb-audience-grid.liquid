<style>
  .aqb-audience {
    padding: 80px 0;
    background: #ffffff;
  }

  .aqb-audience__container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .aqb-audience__kicker {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--aqb-blue);
    margin-bottom: 10px;
  }

  .aqb-audience__title {
    font-family: 'Syne', sans-serif;
    font-size: clamp(28px, 3.5vw, 42px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--aqb-ink);
    margin-bottom: 48px;
  }

  .aqb-audience__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .aqb-audience__card {
    background: #ffffff;
    border: 1.5px solid var(--aqb-border);
    border-radius: var(--aqb-radius-lg);
    padding: 32px 24px;
    text-decoration: none;
    color: var(--aqb-ink);
    transition: all 0.25s var(--aqb-ease);
    position: relative;
    overflow: hidden;
    display: block;
  }

  .aqb-audience__card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--aqb-blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--aqb-ease);
  }

  .aqb-audience__card:hover {
    border-color: var(--aqb-blue);
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(15, 31, 61, 0.12);
  }

  .aqb-audience__card:hover::after {
    transform: scaleX(1);
  }

  .aqb-audience__icon {
    font-size: 36px;
    margin-bottom: 16px;
    display: block;
  }

  .aqb-audience__card-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 10px;
    color: var(--aqb-ink);
  }

  .aqb-audience__card-desc {
    font-size: 14px;
    color: var(--aqb-mid);
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .aqb-audience__card-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--aqb-blue);
  }

  @media screen and (max-width: 989px) {
    .aqb-audience__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .aqb-audience {
      padding: 48px 0;
    }

    .aqb-audience__container {
      padding: 0 16px;
    }

    .aqb-audience__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>

<section class="aqb-audience">
  <div class="aqb-audience__container">
    <p class="aqb-audience__kicker">Shop by Use Case</p>
    <h2 class="aqb-audience__title">Who Are You Ordering For?</h2>
    <div class="aqb-audience__grid">
      <a class="aqb-audience__card" href="{{ section.settings.link_business }}">
        <span class="aqb-audience__icon">🏢</span>
        <div class="aqb-audience__card-title">Businesses & Corporate</div>
        <p class="aqb-audience__card-desc">Employee name badges, visitor passes, conference tags, and team identifiers for offices of all sizes.</p>
        <span class="aqb-audience__card-link">Browse Corporate Tags →</span>
      </a>
      <a class="aqb-audience__card" href="{{ section.settings.link_school }}">
        <span class="aqb-audience__icon">🏫</span>
        <div class="aqb-audience__card-title">Schools & Churches</div>
        <p class="aqb-audience__card-desc">Staff ID badges, student name tags, volunteer badges, and event credentials for education and faith communities.</p>
        <span class="aqb-audience__card-link">Browse School Tags →</span>
      </a>
      <a class="aqb-audience__card" href="{{ section.settings.link_events }}">
        <span class="aqb-audience__icon">🎪</span>
        <div class="aqb-audience__card-title">Events & Conferences</div>
        <p class="aqb-audience__card-desc">Attendee badges, speaker tags, exhibitor credentials, and trade show name tags that make a great first impression.</p>
        <span class="aqb-audience__card-link">Browse Event Tags →</span>
      </a>
      <a class="aqb-audience__card" href="{{ section.settings.link_diy }}">
        <span class="aqb-audience__icon">✂️</span>
        <div class="aqb-audience__card-title">DIY Crafters</div>
        <p class="aqb-audience__card-desc">Blank badge packs, printable inserts for home crafters, teachers, and small business owners.</p>
        <span class="aqb-audience__card-link">Browse DIY Blanks →</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AQB Audience Grid",
  "settings": [
    {
      "type": "url",
      "id": "link_business",
      "label": "Business card link"
    },
    {
      "type": "url",
      "id": "link_school",
      "label": "School card link"
    },
    {
      "type": "url",
      "id": "link_events",
      "label": "Events card link"
    },
    {
      "type": "url",
      "id": "link_diy",
      "label": "DIY card link"
    }
  ],
  "presets": [
    {
      "name": "AQB Audience Grid"
    }
  ]
}
{% endschema %}