<section class="aqb-home-hero" id="aqb-home-hero-{{ section.id }}">
  <div class="aqb-home-hero__left">
    {%- if section.settings.eyebrow != blank -%}
      <div class="aqb-home-hero__eyebrow">
        <span class="aqb-home-hero__pulse" aria-hidden="true"></span>
        <span class="aqb-home-hero__eyebrow-text">{{ section.settings.eyebrow | escape }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="aqb-home-hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="aqb-home-hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="aqb-home-hero__perks">
        {%- for block in section.blocks -%}
          {%- if block.type == 'strength' -%}
            <div class="aqb-home-hero__perk" {{ block.shopify_attributes }}>
              <span class="aqb-home-hero__perk-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'price-tag' -%}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 12.5 8.5 19c.2.2.52.2.72 0l8.5-8.6a.5.5 0 0 0 .15-.36V2.5A.5.5 0 0 0 17.32 2H10.5a.5.5 0 0 0-.36.15L2 10.5a.5.5 0 0 0 0 .72Z" stroke="currentColor" stroke-width="1.2"/><circle cx="13.5" cy="6.5" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'edit' -%}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13.5 3.5 16.5 6.5 7 16H4V13L13.5 3.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="M11.5 5.5 14.5 8.5" stroke="currentColor" stroke-width="1.2"/></svg>
                  {%- when 'reorder' -%}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.5 7.5H5.5a4 4 0 0 0 0 8h1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M13.5 4.5 16.5 7.5 13.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 10s2.8-5.5 7.5-5.5S17.5 10 17.5 10s-2.8 5.5-7.5 5.5S2.5 10 2.5 10Z" stroke="currentColor" stroke-width="1.2"/><circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.2"/></svg>
                {%- endcase -%}
              </span>
              <span class="aqb-home-hero__perk-label">{{ block.settings.title | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="aqb-home-hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link }}" class="aqb-home-hero__btn-primary">
          {{ section.settings.primary_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link }}" class="aqb-home-hero__btn-secondary">
          {{ section.settings.secondary_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.show_amazon_review -%}
      <div class="aqb-home-hero__amazon">
        <div class="aqb-home-hero__amazon-copy">
          <div class="aqb-home-hero__amazon-rating-row">
            <span class="aqb-home-hero__amazon-stars" aria-hidden="true">
              {%- for i in (1..5) -%}<span class="aqb-home-hero__amazon-star">★</span>{%- endfor -%}
            </span>
            <span class="aqb-home-hero__amazon-rating">{{ section.settings.amazon_rating | escape }}</span>
          </div>
          {%- if section.settings.amazon_subtitle != blank -%}
            <p class="aqb-home-hero__amazon-headline">{{ section.settings.amazon_subtitle | escape }}</p>
          {%- endif -%}
        </div>

        <div class="aqb-home-hero__amazon-avatars" aria-hidden="true">
          <span class="aqb-home-hero__amazon-avatar">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="8.5" r="3.25" fill="currentColor"/>
              <path d="M6.5 18.5c0-3 2.46-5.5 5.5-5.5s5.5 2.5 5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </span>
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="aqb-home-hero__right">
    {%- liquid
      assign hero_alt = 'Custom name badge examples'
      if section.settings.hero_image != blank and section.settings.hero_image.alt != blank
        assign hero_alt = section.settings.hero_image.alt
      endif
      assign has_uploaded_hero = false
      if section.settings.hero_image != blank
        assign has_uploaded_hero = true
      endif
    -%}
    {%- if has_uploaded_hero or section.settings.hero_image_asset != blank -%}
      <div class="aqb-home-hero__photo">
        {%- if has_uploaded_hero -%}
          {{
            section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '600,900,1200',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: hero_alt,
              class: 'aqb-home-hero__photo-img'
          }}
        {%- else -%}
          <img
            class="aqb-home-hero__photo-img"
            src="{{ section.settings.hero_image_asset | asset_url }}"
            alt="{{ hero_alt | escape }}"
            width="1024"
            height="1024"
            loading="eager"
          >
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign show_editor_screenshot = false
      unless section.settings.editor_preview_mode == 'built_in'
        if section.settings.editor_preview_image != blank or section.settings.editor_preview_asset != blank
          assign show_editor_screenshot = true
        endif
      endunless
      assign has_editor_upload = false
      if section.settings.editor_preview_image != blank
        assign has_editor_upload = true
      endif
    -%}

    {%- if show_editor_screenshot -%}
      <div class="aqb-home-hero__tool-wrap">
        <a
          href="{{ section.settings.primary_link }}"
          class="aqb-home-hero__tool-preview"
          aria-label="{{ section.settings.primary_label | escape }}"
        >
          {%- if section.settings.editor_preview_cta_label != blank -%}
            <span class="aqb-home-hero__tool-cta">
              {{- section.settings.editor_preview_cta_label | escape -}}
            </span>
          {%- endif -%}
          <span class="aqb-home-hero__tool aqb-home-hero__tool--screenshot">
            <span class="aqb-home-hero__tool-frame">
              {%- if has_editor_upload -%}
                {{
                  section.settings.editor_preview_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'eager',
                    widths: '640,800,1024,1200,1400',
                    sizes: '(min-width: 990px) min(720px, 50vw), 94vw',
                    alt: 'Badge customizer — live preview and design controls',
                    class: 'aqb-home-hero__tool-screenshot'
                }}
              {%- else -%}
                <img
                  class="aqb-home-hero__tool-screenshot"
                  src="{{ section.settings.editor_preview_asset | asset_url }}"
                  alt="Badge customizer — live preview and design controls"
                  width="1024"
                  height="634"
                  loading="eager"
                >
              {%- endif -%}
            </span>
          </span>
        </a>
      </div>
    {%- else -%}
      <div class="aqb-home-hero__tool">
        <div class="aqb-home-hero__tool-chrome">
          <div class="aqb-home-hero__dots" aria-hidden="true">
            <span class="aqb-home-hero__dot aqb-home-hero__dot--r"></span>
            <span class="aqb-home-hero__dot aqb-home-hero__dot--y"></span>
            <span class="aqb-home-hero__dot aqb-home-hero__dot--g"></span>
          </div>
          <div class="aqb-home-hero__url">{{ section.settings.tool_url_label | escape }}</div>
        </div>
        <div class="aqb-home-hero__tool-body">
          <div class="aqb-home-hero__preview">
            <span class="aqb-home-hero__preview-label">Live preview</span>
            <div class="aqb-home-hero__badge">
              <div class="aqb-home-hero__badge-org">{{ section.settings.preview_org_1 | escape }}</div>
              <div class="aqb-home-hero__badge-name">{{ section.settings.preview_name_1 | escape }}</div>
              <div class="aqb-home-hero__badge-role">{{ section.settings.preview_role_1 | escape }}</div>
            </div>
            <div class="aqb-home-hero__badge aqb-home-hero__badge--dark">
              <div class="aqb-home-hero__badge-org">{{ section.settings.preview_org_2 | escape }}</div>
              <div class="aqb-home-hero__badge-name">{{ section.settings.preview_name_2 | escape }}</div>
              <div class="aqb-home-hero__badge-role">{{ section.settings.preview_role_2 | escape }}</div>
            </div>
          </div>
        </div>
        <div class="aqb-home-hero__tool-footer">
          <span class="aqb-home-hero__qty">Qty {{ section.settings.preview_qty | escape }}</span>
          <span class="aqb-home-hero__price">
            {{- section.settings.preview_price | escape -}}
            <span>{{ section.settings.preview_price_note | escape }}</span>
          </span>
          <a href="{{ section.settings.primary_link }}" class="aqb-home-hero__add">
            {{ section.settings.tool_cta_label | escape }}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AQB Home Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Custom Badge Tool — Live Now"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Personalized name badges<br><em>designed live in minutes.</em>"
    },
    {
      "type": "html",
      "id": "subheading",
      "label": "Subheading",
      "default": "Design online, preview instantly and order with confidence. Perfect for businesses, schools, churches, and organizations of any size."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Start Designing Now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Shop All Badges"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image",
      "info": "Badge variations photo behind the editor. Upload here, or rely on the theme asset below (survives theme push)."
    },
    {
      "type": "text",
      "id": "hero_image_asset",
      "label": "Default hero image (theme asset)",
      "default": "aqb-hero-badge-variations.png",
      "info": "Used when no hero image is uploaded in the picker above."
    },
    {
      "type": "select",
      "id": "editor_preview_mode",
      "label": "Editor preview style",
      "options": [
        { "value": "screenshot", "label": "Screenshot (accurate — recommended)" },
        { "value": "built_in", "label": "Built-in simplified mock" }
      ],
      "default": "screenshot"
    },
    {
      "type": "image_picker",
      "id": "editor_preview_image",
      "label": "Editor preview screenshot",
      "info": "Full customizer UI (wide screenshot). Overrides aqb-hero-editor-preview.png when uploaded."
    },
    {
      "type": "text",
      "id": "editor_preview_asset",
      "label": "Default editor preview (theme asset)",
      "default": "aqb-hero-editor-preview.png"
    },
    {
      "type": "text",
      "id": "editor_preview_cta_label",
      "label": "Editor preview CTA label",
      "default": "Click here to design now →",
      "info": "Shown above the design tool screenshot. Links to the primary button URL."
    },
    {
      "type": "text",
      "id": "tool_url_label",
      "label": "Design studio URL label",
      "default": "allqualitybadges.com — Design Studio"
    },
    {
      "type": "text",
      "id": "preview_org_1",
      "default": "Grace Community Church",
      "label": "Preview badge 1 — organization"
    },
    {
      "type": "text",
      "id": "preview_name_1",
      "default": "Sarah",
      "label": "Preview badge 1 — name"
    },
    {
      "type": "text",
      "id": "preview_role_1",
      "default": "Greeter",
      "label": "Preview badge 1 — role"
    },
    {
      "type": "text",
      "id": "preview_org_2",
      "default": "Iglesia Nueva Vida",
      "label": "Preview badge 2 — organization"
    },
    {
      "type": "text",
      "id": "preview_name_2",
      "default": "Carlos",
      "label": "Preview badge 2 — name"
    },
    {
      "type": "text",
      "id": "preview_role_2",
      "default": "Ujier",
      "label": "Preview badge 2 — role"
    },
    {
      "type": "text",
      "id": "preview_qty",
      "default": "25",
      "label": "Preview quantity"
    },
    {
      "type": "text",
      "id": "preview_price",
      "default": "$47.25",
      "label": "Preview price"
    },
    {
      "type": "text",
      "id": "preview_price_note",
      "default": "($1.89 each)",
      "label": "Preview price note"
    },
    {
      "type": "text",
      "id": "tool_cta_label",
      "default": "Add to Cart",
      "label": "Tool footer CTA label"
    },
    {
      "type": "header",
      "content": "Amazon review"
    },
    {
      "type": "checkbox",
      "id": "show_amazon_review",
      "label": "Show Amazon review",
      "default": true
    },
    {
      "type": "text",
      "id": "amazon_rating",
      "label": "Amazon rating text",
      "default": "4.8/5 from 6,000+ reviews"
    },
    {
      "type": "text",
      "id": "amazon_subtitle",
      "label": "Amazon headline",
      "default": "Millions of badges sold on Amazon"
    },
    {
      "type": "image_picker",
      "id": "amazon_avatars",
      "label": "Customer avatars image",
      "info": "Optional. Overrides the default avatar strip shown to the right of the rating."
    },
    {
      "type": "text",
      "id": "amazon_avatars_asset",
      "label": "Default avatars (theme asset)",
      "default": "aqb-hero-amazon-avatars.png"
    }
  ],
  "blocks": [
    {
      "type": "strength",
      "name": "Perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "eye", "label": "Eye" },
            { "value": "price-tag", "label": "Price tag" },
            { "value": "edit", "label": "Pencil / edit" },
            { "value": "reorder", "label": "Reorder" }
          ],
          "default": "eye"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "See it before you buy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Home Hero",
      "blocks": [
        {
          "type": "strength",
          "settings": {
            "icon": "eye",
            "title": "See it before you buy"
          }
        },
        {
          "type": "strength",
          "settings": {
            "icon": "price-tag",
            "title": "Badges as low as $4.99"
          }
        },
        {
          "type": "strength",
          "settings": {
            "icon": "edit",
            "title": "Design it live in minutes"
          }
        },
        {
          "type": "strength",
          "settings": {
            "icon": "reorder",
            "title": "Reorder in one click"
          }
        }
      ]
    }
  ]
}
{% endschema %}
