{{ 'aqb-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'aqb-header-nav.js' | asset_url }}" defer></script>
<script src="{{ 'aqb-header-search.js' | asset_url }}" defer></script>

{%- liquid
  assign sign_in_url = routes.account_login_url
  if shop.customer_accounts_enabled
    assign return_to_encoded = request.path | url_encode
    assign sign_in_url = '/customer_authentication/login?return_to=' | append: return_to_encoded
  endif

  assign shop_all_url = section.settings.shop_all_url
  if shop_all_url == blank
    assign shop_all_url = routes.all_products_collection_url
  endif
  assign home_url = routes.root_url
  assign cart_url = routes.cart_url
  assign cart_count = cart.item_count
  assign cart_active = false
  if request.path == cart_url or request.path contains '/cart'
    assign cart_active = true
  endif
-%}

<nav class="aqb-store-nav" aria-label="Main navigation" data-aqb-nav>
  <div class="aqb-store-nav__inner">
    <a href="{{ home_url }}" class="aqb-store-nav__logo">
      <span class="aqb-store-nav__logo-mark" aria-hidden="true">{{ section.settings.logo_mark | escape }}</span>
      <span class="aqb-store-nav__logo-text" data-nav-collapsible data-nav-priority="75">
        {{- section.settings.logo_text_before | escape -}}
        <span>{{ section.settings.logo_text_accent | escape }}</span>
      </span>
    </a>

    <ul class="aqb-store-nav__links" role="list">
      {%- render 'aqb-header-nav-items', section: section, context: 'desktop' -%}
    </ul>

    <div class="aqb-store-nav__right">
      {%- render 'aqb-header-search', results_url: shop_all_url, context_id: section.id -%}
      <a href="{{ sign_in_url }}" class="aqb-store-nav__btn-ghost" data-nav-collapsible data-nav-priority="85">
        <svg class="aqb-store-nav__signin-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
        </svg>
        <span class="aqb-store-nav__signin-text" data-nav-collapsible data-nav-priority="84">{{ section.settings.sign_in_label | escape }}</span>
      </a>
      <a
        href="{{ cart_url }}"
        class="aqb-store-nav__btn-cart{% if cart_active %} is-active{% endif %}"
        data-nav-collapsible
        data-nav-priority="90"
        {% if cart_active %}aria-current="page"{% endif %}
        aria-label="{{ section.settings.cart_label | escape }}{% if cart_count > 0 %} ({{ cart_count }} items){% endif %}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
        </svg>
        <span class="aqb-store-nav__cart-label">{{ section.settings.cart_label | escape }}</span>
        {%- if cart_count > 0 -%}
          <span class="aqb-store-nav__cart-count">{{ cart_count }}</span>
        {%- endif -%}
      </a>
      <a href="{{ shop_all_url }}" class="aqb-store-nav__btn-gold" data-nav-collapsible data-nav-priority="48">
        {{ section.settings.shop_all_label | escape }}
      </a>
      <button
        type="button"
        class="aqb-store-nav__menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="aqb-nav-drawer-{{ section.id }}"
        data-aqb-nav-open
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="aqb-nav-drawer-{{ section.id }}"
    class="aqb-store-nav__drawer"
    data-aqb-nav-drawer
    hidden
  >
    <div class="aqb-store-nav__drawer-backdrop" data-aqb-nav-close tabindex="-1" aria-hidden="true"></div>
    <div class="aqb-store-nav__drawer-panel" role="dialog" aria-modal="true" aria-label="Menu">
      <button type="button" class="aqb-store-nav__drawer-close" data-aqb-nav-close aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
      <ul class="aqb-store-nav__drawer-links" role="list">
        {%- render 'aqb-header-nav-items', section: section, context: 'drawer' -%}
      </ul>
      <div class="aqb-store-nav__drawer-actions">
        {%- assign drawer_search_id = section.id | append: '-drawer' -%}
        {%- render 'aqb-header-search', results_url: shop_all_url, context_id: drawer_search_id, compact: true -%}
        <a href="{{ sign_in_url }}" class="aqb-store-nav__btn-ghost">{{ section.settings.sign_in_label | escape }}</a>
        <a
          href="{{ cart_url }}"
          class="aqb-store-nav__btn-cart{% if cart_active %} is-active{% endif %}"
          {% if cart_active %}aria-current="page"{% endif %}
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
          </svg>
          <span>{{ section.settings.cart_label | escape }}</span>
          {%- if cart_count > 0 -%}
            <span class="aqb-store-nav__cart-count">{{ cart_count }}</span>
          {%- endif -%}
        </a>
        <a href="{{ shop_all_url }}" class="aqb-store-nav__btn-gold">{{ section.settings.shop_all_label | escape }}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  (function () {
    var root = document.querySelector('[data-aqb-nav]');
    if (!root) return;
    var drawer = root.querySelector('[data-aqb-nav-drawer]');
    var openBtn = root.querySelector('[data-aqb-nav-open]');
    var closeEls = root.querySelectorAll('[data-aqb-nav-close]');

    function openDrawer() {
      drawer.hidden = false;
      drawer.classList.add('is-open');
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('aqb-nav-drawer-open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('aqb-nav-drawer-open');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openDrawer);
    closeEls.forEach(function (el) {
      el.addEventListener('click', closeDrawer);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) closeDrawer();
    });

    root.querySelectorAll('[data-nav-accordion]').forEach(function (group) {
      var toggle = group.querySelector('.aqb-store-nav__drawer-group-toggle');
      var submenu = group.querySelector('.aqb-store-nav__drawer-submenu');
      if (!toggle || !submenu) return;
      toggle.addEventListener('click', function () {
        var expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        submenu.hidden = expanded;
        group.classList.toggle('is-open', !expanded);
      });
    });

    root.querySelectorAll('[data-nav-dropdown]').forEach(function (item) {
      var trigger = item.querySelector('.aqb-store-nav__dropdown-trigger');
      var panel = item.querySelector('.aqb-store-nav__dropdown-panel');
      if (!trigger || !panel) return;

      function openPanel() {
        root.querySelectorAll('[data-nav-dropdown].is-open').forEach(function (other) {
          if (other === item) return;
          var otherTrigger = other.querySelector('.aqb-store-nav__dropdown-trigger');
          var otherPanel = other.querySelector('.aqb-store-nav__dropdown-panel');
          if (otherPanel) otherPanel.hidden = true;
          if (otherTrigger) otherTrigger.setAttribute('aria-expanded', 'false');
          other.classList.remove('is-open');
        });
        panel.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
        item.classList.add('is-open');
      }

      function closePanel() {
        panel.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        item.classList.remove('is-open');
      }

      closePanel();

      var hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      var closeTimer = null;

      function scheduleClose() {
        if (closeTimer) window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(function () {
          closePanel();
          closeTimer = null;
        }, 120);
      }

      function cancelClose() {
        if (closeTimer) {
          window.clearTimeout(closeTimer);
          closeTimer = null;
        }
      }

      if (hoverCapable) {
        item.addEventListener('mouseenter', function () {
          cancelClose();
          openPanel();
        });
        item.addEventListener('mouseleave', scheduleClose);
        panel.addEventListener('mouseenter', cancelClose);
        panel.addEventListener('mouseleave', scheduleClose);
      }

      trigger.addEventListener('click', function (e) {
        if (item.classList.contains('is-open')) {
          closePanel();
        } else {
          e.preventDefault();
          openPanel();
        }
      });

      item.addEventListener('focusin', function () {
        openPanel();
      });
      item.addEventListener('focusout', function (e) {
        if (!item.contains(e.relatedTarget)) closePanel();
      });
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('[data-nav-dropdown]')) {
        root.querySelectorAll('[data-nav-dropdown].is-open').forEach(function (item) {
          var trigger = item.querySelector('.aqb-store-nav__dropdown-trigger');
          var panel = item.querySelector('.aqb-store-nav__dropdown-panel');
          if (panel) panel.hidden = true;
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
          item.classList.remove('is-open');
        });
      }
    });
  })();

  (function () {
    var ticker = document.querySelector('.shopify-section.aqb-announcement-ticker-section');
    var navSection = document.querySelector('.shopify-section.aqb-header-section');

    function setSiteHeaderHeight() {
      var total = 0;
      if (ticker) total += ticker.offsetHeight;
      if (navSection) total += navSection.offsetHeight;
      if (total > 0) {
        document.documentElement.style.setProperty('--aqb-site-header-height', total + 'px');
      }
    }

    setSiteHeaderHeight();
    window.addEventListener('resize', setSiteHeaderHeight);
    if (typeof ResizeObserver !== 'undefined') {
      var ro = new ResizeObserver(setSiteHeaderHeight);
      if (ticker) ro.observe(ticker);
      if (navSection) ro.observe(navSection);
    }
  })();
</script>

{% schema %}
{
  "name": "AQB Header",
  "class": "aqb-header-section",
  "settings": [
    {
      "type": "text",
      "id": "logo_mark",
      "label": "Logo mark text",
      "default": "AQ"
    },
    {
      "type": "text",
      "id": "logo_text_before",
      "label": "Logo text (before accent)",
      "default": "All Quality "
    },
    {
      "type": "text",
      "id": "logo_text_accent",
      "label": "Logo accent word",
      "default": "Badges"
    },
    {
      "type": "text",
      "id": "sign_in_label",
      "label": "Sign in button label",
      "default": "Sign In"
    },
    {
      "type": "url",
      "id": "shop_all_url",
      "label": "Shop all badges link"
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop all button label",
      "default": "Shop All Badges"
    },
    {
      "type": "text",
      "id": "cart_label",
      "label": "Cart button label",
      "default": "Cart"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Nav link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "text",
          "id": "label_short",
          "label": "Short label (compact bar)",
          "info": "Used on smaller screens when the full label does not fit."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "active_paths",
          "label": "Active when URL contains (comma-separated)",
          "info": "Example: /products/custom-1x3-badge"
        }
      ]
    },
    {
      "type": "nav_dropdown",
      "name": "Nav dropdown",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Menu"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Parent link"
        },
        {
          "type": "text",
          "id": "active_paths",
          "label": "Active when URL contains (comma-separated)"
        },
        {
          "type": "text",
          "id": "menu_id",
          "label": "Menu ID",
          "info": "Match dropdown items to this ID (e.g. church, desk, roles)"
        },
        {
          "type": "select",
          "id": "columns",
          "label": "Dropdown columns",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" }
          ],
          "default": "1"
        }
      ]
    },
    {
      "type": "nav_dropdown_item",
      "name": "Dropdown item",
      "settings": [
        {
          "type": "text",
          "id": "menu_id",
          "label": "Menu ID",
          "info": "Must match parent nav dropdown Menu ID"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Header",
      "blocks": [
        {
          "type": "nav_link",
          "settings": {
            "label": "Design Your Badge",
            "url": "/products/custom-1x3-badge",
            "active_paths": "/products/custom-1x3-badge"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Name Tag Blanks",
            "url": "/pages/name-tag-blanks",
            "active_paths": "/pages/name-tag-blanks,/collections/blank-name-tags"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Church & Congregation",
            "url": "/pages/church-and-congregation",
            "active_paths": "/pages/church-and-congregation,/collections/church-name-tags"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Role Badges",
            "url": "/pages/role-badges",
            "active_paths": "/pages/role-badges"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Desk Name Plates",
            "url": "/pages/desk-signs",
            "active_paths": "/pages/desk-signs,/collections/acrylic-desk-signs,/collections/desk"
          }
        },
        {
          "type": "nav_link",
          "settings": {
            "label": "Bulk Orders",
            "url": "/pages/bulk",
            "active_paths": "/pages/bulk,/pages/bulk-orders"
          }
        }
      ]
    }
  ]
}
{% endschema %}
