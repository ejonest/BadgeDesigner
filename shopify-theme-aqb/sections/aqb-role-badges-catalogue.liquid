{%- if page.handle == 'role-badges' or template.suffix == 'role-badges' -%}
{%- liquid
  assign rb_collection = section.settings.collection
  if rb_collection == blank
    assign rb_collection = collections['role-badges']
  endif
  assign products_per_page = section.settings.products_per_page | default: 12
  assign catalogue_base = section.settings.catalogue_base | default: '/pages/role-badges'
-%}

<section class="aqb-rb-catalogue" id="role-badges-catalogue">
  <div class="aqb-rb-catalogue__inner">
    <div class="aqb-rb-layout">
      <aside class="aqb-rb-sidebar" id="role-badges-catalogue-filters" aria-label="Filter role badges">
        <button type="button" class="aqb-rb-sidebar__toggle" id="role-badges-filter-toggle" aria-expanded="false" aria-controls="role-badges-filter-panel">
          <span>Filters</span>
          <span class="aqb-rb-sidebar__toggle-icon" aria-hidden="true"></span>
        </button>

        <div class="aqb-rb-sidebar__panel" id="role-badges-filter-panel">
          <div class="aqb-rb-filter-section">
            <h3 class="aqb-rb-filter-section__title">Role</h3>
            <ul class="aqb-rb-filter-list" id="role-badges-filter-roles">
              {%- for block in section.blocks -%}
                {%- if block.type == 'category' -%}
                  <li>
                    <label class="aqb-rb-filter-check">
                      <input
                        type="checkbox"
                        name="role"
                        value="{{ block.settings.category_id | escape }}"
                        data-role="{{ block.settings.category_id | escape }}"
                        data-tag="{{ block.settings.tag | downcase | escape }}"
                      >
                      <span>{{ block.settings.label | escape }}</span>
                    </label>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

          <div class="aqb-rb-filter-section aqb-rb-subfilter-group" data-for-role="church" id="role-badges-subfilter-church" hidden>
            <h3 class="aqb-rb-filter-section__title">Church Sub Category</h3>
            <ul class="aqb-rb-filter-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'church_subcategory' -%}
                  <li>
                    <label class="aqb-rb-filter-check">
                      <input
                        type="checkbox"
                        name="church-subcategory"
                        value="{{ block.settings.subcategory_id | escape }}"
                        data-subcategory="{{ block.settings.subcategory_id | escape }}"
                        data-tags="{{ block.settings.tags | downcase | escape }}"
                        data-for-role="church"
                      >
                      <span>{{ block.settings.label | escape }}</span>
                    </label>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

          <div class="aqb-rb-filter-section">

            <label class="aqb-rb-filter-field" for="role-badges-sort">
              <span class="aqb-rb-filter-field__label">Sort by</span>
              <select id="role-badges-sort" class="aqb-rb-filter-select">
                <option value="featured">Featured</option>
                <option value="price-asc">Price: low to high</option>
                <option value="price-desc">Price: high to low</option>
                <option value="bestseller">Best sellers</option>
                <option value="alpha-asc">Alphabetical (A–Z)</option>
                <option value="alpha-desc">Alphabetical (Z–A)</option>
              </select>
            </label>

            <div class="aqb-rb-filter-field">
              <span class="aqb-rb-filter-field__label">Price range</span>
              <div class="aqb-rb-price-range">
                <label class="aqb-rb-price-range__field">
                  <span class="visually-hidden">Minimum price</span>
                  <span class="aqb-rb-price-range__prefix">$</span>
                  <input type="number" id="role-badges-price-min" class="aqb-rb-price-input" min="0" step="0.01" placeholder="Min">
                </label>
                <span class="aqb-rb-price-range__sep" aria-hidden="true">–</span>
                <label class="aqb-rb-price-range__field">
                  <span class="visually-hidden">Maximum price</span>
                  <span class="aqb-rb-price-range__prefix">$</span>
                  <input type="number" id="role-badges-price-max" class="aqb-rb-price-input" min="0" step="0.01" placeholder="Max">
                </label>
              </div>
            </div>

            <ul class="aqb-rb-filter-list">
              <li>
                <label class="aqb-rb-filter-check">
                  <input type="checkbox" id="role-badges-adult" value="1">
                  <span>Include 18+ badges</span>
                </label>
              </li>
            </ul>

            <button type="button" class="aqb-rb-filter-clear" id="role-badges-filter-clear">Clear all filters</button>
          </div>
        </div>
      </aside>

      <div class="aqb-rb-main">
        <div class="aqb-rb-section-header">
          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="aqb-rb-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2>{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
          <div class="aqb-rb-section-count" id="role-badges-product-count">Showing badges</div>
        </div>

        <div
          class="aqb-rb-product-grid"
          id="role-badges-product-grid"
          data-page-size="{{ products_per_page }}"
          data-catalogue-base="{{ catalogue_base | escape }}"
          data-collection-handle="{{ rb_collection.handle | escape }}"
          data-total-products="{{ rb_collection.products_count | default: 0 }}"
          data-add-label="{{ section.settings.add_label | escape }}"
          data-pack-label="{{ section.settings.pack_label | escape }}"
          data-price-subtext="{{ section.settings.price_subtext | escape }}"
          data-cart-add-url="{{ routes.cart_add_url }}"
        >
          {%- if rb_collection != blank -%}
            {%- paginate rb_collection.products by 250 -%}
              {%- for product in rb_collection.products -%}
                {%- render 'aqb-role-badges-catalogue-card',
                  product: product,
                  section: section,
                  product_index: forloop.index0
                -%}
              {%- endfor -%}
            {%- endpaginate -%}
          {%- endif -%}
        </div>

        <div class="aqb-rb-load-more-wrap" id="role-badges-load-more-wrap" hidden>
          <button type="button" class="aqb-rb-btn-outline" id="role-badges-load-more">
            {{ section.settings.load_more_label | escape }}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="aqb-rb-scroll-controls" id="role-badges-scroll-controls" aria-label="Scroll navigation">
  <button type="button" class="aqb-rb-scroll-btn" id="role-badges-scroll-top" aria-label="Scroll to top">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3L3 9h10L8 3z" fill="currentColor"/></svg>
  </button>
  <button type="button" class="aqb-rb-scroll-btn" id="role-badges-scroll-bottom" aria-label="Scroll to bottom">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 13L3 7h10l-5 6z" fill="currentColor"/></svg>
  </button>
</div>

<script type="application/json" id="role-badges-filter-config">
{
  "roles": [
    {%- assign role_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- unless role_first -%},{%- endunless -%}
        {"id":{{ block.settings.category_id | json }},"tag":{{ block.settings.tag | downcase | json }},"label":{{ block.settings.label | json }}}
        {%- assign role_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "churchSubcategories": [
    {%- assign church_first = true -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'church_subcategory' -%}
        {%- unless church_first -%},{%- endunless -%}
        {"id":{{ block.settings.subcategory_id | json }},"tags":{{ block.settings.tags | downcase | split: ',' | json }},"label":{{ block.settings.label | json }}}
        {%- assign church_first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
<script src="{{ 'aqb-role-badges.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "AQB Role Badges Catalog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "text",
      "id": "catalogue_base",
      "label": "Catalog page path",
      "default": "/pages/role-badges"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pre-Printed Badges"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Find your <em>role</em>"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "label": "Products shown initially",
      "default": 12
    },
    {
      "type": "text",
      "id": "pack_label",
      "label": "Pack pill label",
      "default": "3-Pack"
    },
    {
      "type": "text",
      "id": "price_subtext",
      "label": "Price subtext",
      "default": "per 3-pack + shipping"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "load_more_label",
      "label": "Load more label",
      "default": "Show more badges"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Role filter",
      "settings": [
        { "type": "text", "id": "category_id", "label": "Category ID", "default": "healthcare" },
        { "type": "text", "id": "label", "label": "Label", "default": "Healthcare" },
        { "type": "text", "id": "tag", "label": "Product tag to match", "default": "healthcare" }
      ]
    },
    {
      "type": "church_subcategory",
      "name": "Church subcategory",
      "settings": [
        { "type": "text", "id": "subcategory_id", "label": "Subcategory ID", "default": "greeters-ushers" },
        { "type": "text", "id": "label", "label": "Label", "default": "Greeters & Ushers" },
        { "type": "text", "id": "tags", "label": "Product tags (comma-separated)", "default": "greeter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Role Badges Catalog",
      "blocks": [
        { "type": "category", "settings": { "category_id": "healthcare", "label": "Healthcare", "tag": "healthcare" } },
        { "type": "category", "settings": { "category_id": "church", "label": "Church & Religious", "tag": "church" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "greeters-ushers", "label": "Greeters & Ushers", "tags": "greeter" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "pastors-leadership", "label": "Pastors & Leadership", "tags": "pastor, leadership" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "welcome", "label": "Welcome", "tags": "welcome" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "spanish", "label": "Spanish", "tags": "spanish" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "deacon", "label": "Deacon", "tags": "deacon" } },
        { "type": "church_subcategory", "settings": { "subcategory_id": "usher", "label": "Usher", "tags": "usher" } },
        { "type": "category", "settings": { "category_id": "corporate", "label": "Corporate & Office", "tag": "corporate" } },
        { "type": "category", "settings": { "category_id": "fitness", "label": "Fitness & Wellness", "tag": "fitness" } },
        { "type": "category", "settings": { "category_id": "hospitality", "label": "Hospitality", "tag": "hospitality" } },
        { "type": "category", "settings": { "category_id": "security", "label": "Security", "tag": "security" } },
        { "type": "category", "settings": { "category_id": "retail", "label": "Retail & Service", "tag": "retail" } },
        { "type": "category", "settings": { "category_id": "novelty", "label": "Novelty", "tag": "novelty" } },
        { "type": "category", "settings": { "category_id": "education", "label": "Education", "tag": "education" } },
        { "type": "category", "settings": { "category_id": "airfare", "label": "Airfare", "tag": "airfare" } },
        { "type": "category", "settings": { "category_id": "first-responders", "label": "First Responders", "tag": "first_responders" } },
        { "type": "category", "settings": { "category_id": "trades", "label": "Trades", "tag": "trades" } },
        { "type": "category", "settings": { "category_id": "government", "label": "Government", "tag": "government" } },
        { "type": "category", "settings": { "category_id": "events", "label": "Events", "tag": "events" } },
        { "type": "category", "settings": { "category_id": "other", "label": "Other", "tag": "other" } },
        { "type": "category", "settings": { "category_id": "blanks", "label": "Blanks", "tag": "blanks" } }
      ]
    }
  ]
}
{% endschema %}
