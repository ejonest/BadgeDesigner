{%- if page.handle == 'about-us' or template.suffix == 'about-us' -%}
  {%- render 'aqb-about-us-page' -%}
{%- else -%}
{%- unless page.handle == 'church-and-congregation' or template.suffix == 'church-and-congregation' or page.handle == 'church-religious-catalog' or template.suffix == 'church-religious-catalog' or page.handle == 'role-badges' or template.suffix == 'role-badges' or page.handle == 'name-tag-blanks' or page.handle == 'badge-blank' or template.suffix == 'name-tag-blanks' or page.handle == 'desk-signs' or template.suffix == 'desk-signs' or page.handle == 'desk-signs-catalogue' or template.suffix == 'desk-signs-catalogue' or page.handle == 'bulk' or page.handle == 'bulk-orders' or template.suffix == 'bulk-orders' or page.handle == 'contact' or template.suffix == 'contact' or page.handle == 'how-it-works' or template.suffix == 'how-it-works' or page.handle == 'faq' or template.suffix == 'faq' or page.handle == 'shipping-delivery' or template.suffix == 'shipping-delivery' -%}
{{ 'section-main-page.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if page.handle == 'shipping-delivery-1' -%}
      {%- capture aqb_intl_customers_block -%}
<div class="vc_column_container col-md-6">
<div class="wpb_wrapper vc_column-inner">
<div class="porto-u-heading" data-hspacer="no_spacer" data-halign="left">
<div class="porto-u-main-heading">
<h3></h3>
<h3>INTERNATIONAL CUSTOMERS</h3>
</div>
<div class="porto-u-sub-heading">We charge a flat rate of $22.50 for international shipping.</div>
</div>
</div>
</div>
      {%- endcapture -%}
      {{ page.content | remove: aqb_intl_customers_block }}
    {%- else -%}
      {{ page.content }}
    {%- endif -%}
  </div>
</div>
{%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
