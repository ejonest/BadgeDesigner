{%- if page.handle == 'church-and-congregation' or template.suffix == 'church-and-congregation' -%}
<section class="aqb-ch-multipacks">
  <div class="aqb-ch-multipacks__inner">
    <div class="aqb-ch-multipacks__img">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 800
          | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 990px) 40vw, 100vw', alt: section.settings.heading | strip_html | escape
        }}
      {%- elsif section.settings.image_asset != blank -%}
        <img
          src="{{ section.settings.image_asset | asset_url }}"
          alt="{{ section.settings.heading | strip_html | escape }}"
          width="800"
          height="600"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="aqb-ch-multipacks__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="aqb-ch-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="aqb-ch-section-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="aqb-ch-section-desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      <div class="aqb-ch-multipacks__points">
        {%- for block in section.blocks -%}
          <div class="aqb-ch-multipacks__point" {{ block.shopify_attributes }}>
            <span class="aqb-ch-multipacks__check" aria-hidden="true">✓</span>
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="aqb-ch-hero__btn-primary">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "AQB Church Multipacks",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Multi-packs" },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Multi-packs built<br><em>for congregations.</em>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Most ministry roles ship in convenient 3-packs — order exactly what your team needs without overbuying."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_asset", "label": "Theme asset", "default": "aqb-church-multipack.png" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Ministry Badges →" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "settings": [
        {
          "type": "html",
          "id": "text",
          "label": "Text",
          "default": "<strong>3-pack minimum</strong> on most pre-made church role badges"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Church Multipacks",
      "blocks": [
        { "type": "point", "settings": { "text": "<strong>3-pack minimum</strong> on most pre-made church role badges" } },
        { "type": "point", "settings": { "text": "<strong>Mix and match</strong> roles across your welcome team, ushers, and deacons" } },
        { "type": "point", "settings": { "text": "<strong>Free USA shipping</strong> on every order — no minimum" } }
      ]
    }
  ]
}
{% endschema %}
