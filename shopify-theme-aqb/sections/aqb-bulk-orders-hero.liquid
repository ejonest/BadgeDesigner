{%- if page.handle == 'bulk' or page.handle == 'bulk-orders' or template.suffix == 'bulk-orders' -%}
{{ 'aqb-bulk-orders.css' | asset_url | stylesheet_tag }}

<section class="aqb-bo-hero" id="aqb-bo-hero-{{ section.id }}">
  <div class="aqb-bo-hero__inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <div class="aqb-bo-hero__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1>{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="aqb-bo-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="aqb-bo-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link }}" class="aqb-bo-btn-gold">{{ section.settings.primary_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="aqb-bo-btn-ghost">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>

      <div class="aqb-bo-hero__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_point' -%}
            <div class="aqb-bo-hero__trust-item" {{ block.shopify_attributes }}>
              <span class="aqb-bo-hero__trust-check" aria-hidden="true">✓</span>
              {{ block.settings.label | escape }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="aqb-bo-hero__panel">
      {%- if section.settings.panel_heading != blank -%}
        <h3>{{ section.settings.panel_heading | escape }}</h3>
      {%- endif -%}
      {%- if section.settings.panel_text != blank -%}
        <p>{{ section.settings.panel_text | escape }}</p>
      {%- endif -%}
      <div class="aqb-bo-hero__panel-steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div class="aqb-bo-hero__panel-step" {{ block.shopify_attributes }}>
              <span class="aqb-bo-hero__panel-num">{{ forloop.index }}</span>
              <span>{{ block.settings.text | escape }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "AQB Bulk Orders Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Volume & trade pricing" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Bulk orders,<br><em>handled by a real person.</em>" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Request a quote for blank badges, desk signs, custom badges, and more. A representative will review your order and follow up with discounted pricing — usually the same business day." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Request a Quote →" },
    { "type": "text", "id": "primary_link", "label": "Primary link", "default": "#bulk-quote-form" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Browse products" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "How it works" },
    { "type": "textarea", "id": "panel_text", "label": "Panel text", "default": "No automated checkout for large orders yet — every bulk request is reviewed by our team so you get the right price and lead time." }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust point",
      "settings": [{ "type": "text", "id": "label", "label": "Label", "default": "Same-day response" }]
    },
    {
      "type": "step",
      "name": "Process step",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Submit your request with quantities and product details" }]
    }
  ],
  "presets": [{ "name": "AQB Bulk Orders Hero" }]
}
{% endschema %}
