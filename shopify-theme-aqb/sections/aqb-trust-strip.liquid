<style>
  .aqb-trust-strip {
    background: var(--aqb-sky);
    border-top: 1px solid #c7d9fb;
    border-bottom: 1px solid #c7d9fb;
    padding: 18px 0;
  }

  .aqb-trust-strip__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .aqb-trust-strip__item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: var(--aqb-navy);
  }

  .aqb-trust-strip__icon {
    width: 36px;
    height: 36px;
    background: #ffffff;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    box-shadow: 0 2px 8px rgba(15, 31, 61, 0.08);
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .aqb-trust-strip__inner {
      padding: 0 16px;
      justify-content: center;
    }

    .aqb-trust-strip__item {
      width: calc(50% - 8px);
      font-size: 13px;
    }
  }
</style>

<div class="aqb-trust-strip">
  <div class="aqb-trust-strip__inner">
    <div class="aqb-trust-strip__item">
      <div class="aqb-trust-strip__icon">🎨</div>
      <span>Full-color printing, your logo & text</span>
    </div>
    <div class="aqb-trust-strip__item">
      <div class="aqb-trust-strip__icon">📐</div>
      <span>6+ badge sizes & styles</span>
    </div>
    <div class="aqb-trust-strip__item">
      <div class="aqb-trust-strip__icon">🔁</div>
      <span>We keep your files for easy reorders</span>
    </div>
    <div class="aqb-trust-strip__item">
      <div class="aqb-trust-strip__icon">📦</div>
      <span>Blank packs for DIY projects</span>
    </div>
    <div class="aqb-trust-strip__item">
      <div class="aqb-trust-strip__icon">🤝</div>
      <span>Bulk pricing at 50, 100, 500+ units</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AQB Trust Strip",
  "settings": [],
  "presets": [
    {
      "name": "AQB Trust Strip"
    }
  ]
}
{% endschema %}