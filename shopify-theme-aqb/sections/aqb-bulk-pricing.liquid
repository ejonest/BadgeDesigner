{% comment %}
  Section: AQB Bulk Pricing Callout
  CSS lives in assets/base.css — search for "AQB SECTIONS CSS"
{% endcomment %}

<div class="aqb-bulk-pricing color-{{ section.settings.color_scheme }} gradient" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">

    <div class="aqb-bulk-pricing__header">
      {% if section.settings.heading != blank %}
        <h2 class="aqb-bulk-pricing__title {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="aqb-bulk-pricing__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </div>

    <div class="aqb-bulk-pricing__body">
      <ul class="aqb-bulk-pricing__tiers list-unstyled" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'tier' %}
            <li class="aqb-bulk-pricing__tier{% if block.settings.is_featured %} aqb-bulk-pricing__tier--featured{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.is_featured and section.settings.featured_label != blank %}
                <span class="aqb-bulk-pricing__badge">{{ section.settings.featured_label | escape }}</span>
              {% endif %}
              <span class="aqb-bulk-pricing__qty">{{ block.settings.quantity | escape }}</span>
              <span class="aqb-bulk-pricing__label">badges</span>
              {% if block.settings.price_note != blank %}
                <span class="aqb-bulk-pricing__price">{{ block.settings.price_note | escape }}</span>
              {% endif %}
              {% if block.settings.savings_note != blank %}
                <span class="aqb-bulk-pricing__savings">{{ block.settings.savings_note | escape }}</span>
              {% endif %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
        <div class="aqb-bulk-pricing__cta">
          <a href="{{ section.settings.cta_link }}" class="button button--primary">
            {{ section.settings.cta_label | escape }}
          </a>
          {% if section.settings.cta_note != blank %}
            <p class="aqb-bulk-pricing__cta-note">{{ section.settings.cta_note | escape }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Bulk Pricing Callout",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy More, Save More" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The more you order, the more you save. No coupon needed." },
    { "type": "text", "id": "featured_label", "label": "Featured tier badge label", "default": "Most Popular" },
    { "type": "url", "id": "cta_link", "label": "CTA button link" },
    { "type": "text", "id": "cta_label", "label": "CTA button label", "default": "Shop Blank Name Tags" },
    { "type": "text", "id": "cta_note", "label": "Note below CTA button", "default": "Free shipping on all US orders. No minimum." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 60 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 60 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pricing Tier",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "quantity", "label": "Quantity", "default": "10" },
        { "type": "text", "id": "price_note", "label": "Price note", "default": "$1.49 each" },
        { "type": "text", "id": "savings_note", "label": "Savings note", "placeholder": "e.g. Save 10%" },
        { "type": "checkbox", "id": "is_featured", "label": "Highlight this tier", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bulk Pricing Callout",
      "blocks": [
        { "type": "tier", "settings": { "quantity": "10", "price_note": "$1.99 each", "is_featured": false } },
        { "type": "tier", "settings": { "quantity": "50", "price_note": "$1.49 each", "savings_note": "Save 25%", "is_featured": false } },
        { "type": "tier", "settings": { "quantity": "100", "price_note": "$1.19 each", "savings_note": "Save 40%", "is_featured": true } },
        { "type": "tier", "settings": { "quantity": "500+", "price_note": "Contact us", "savings_note": "Best price", "is_featured": false } }
      ]
    }
  ]
}
{% endschema %}
