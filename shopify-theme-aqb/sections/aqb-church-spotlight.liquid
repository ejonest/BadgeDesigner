<section class="aqb-church">
  <div class="aqb-church__inner">
    <div class="aqb-church__left">
      {%- if section.settings.eyebrow != blank -%}
        <div class="aqb-church__eyebrow">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="aqb-church__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="aqb-church__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.settings.bilingual_title != blank -%}
        <div class="aqb-church__bilingual">
          <span aria-hidden="true">🌎</span>
          <div>
            <div class="aqb-church__bil-title">{{ section.settings.bilingual_title | escape }}</div>
            <div class="aqb-church__bil-text">{{ section.settings.bilingual_text | escape }}</div>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="aqb-church__btn">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}

      <div class="aqb-church__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_point' -%}
            <div class="aqb-church__trust-item" {{ block.shopify_attributes }}>
              <span class="aqb-church__check" aria-hidden="true">✓</span>
              {{ block.settings.label | escape }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="aqb-church__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'badge_card' -%}
          <a href="{{ block.settings.link }}" class="aqb-church__card" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="aqb-church__card-photo">
                {{
                  block.settings.image
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '200,400', sizes: '(min-width: 990px) 25vw, 50vw', alt: block.settings.title
                }}
              </div>
            {%- endif -%}
            <div class="aqb-church__card-info">
              <div class="aqb-church__card-name">{{ block.settings.title | escape }}</div>
              <div class="aqb-church__card-type">{{ block.settings.badge_type | escape }}</div>
              {%- if block.settings.tag != blank -%}
                <div class="aqb-church__card-tag">{{ block.settings.tag | escape }}</div>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AQB Church Spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✝ Houses of Worship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The badge collection built for your congregation."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "From Sunday greeters to Wednesday deacons — every ministry role, ready to order in multi-packs. We're the only badge supplier with a full Spanish-language congregation collection."
    },
    {
      "type": "text",
      "id": "bilingual_title",
      "label": "Bilingual box title",
      "default": "Fully bilingual — English & Spanish."
    },
    {
      "type": "textarea",
      "id": "bilingual_text",
      "label": "Bilingual box text",
      "default": "Ujier, Diácono, Acomodador, Jr Ujier and more. Your congregation deserves to see their roles in their own language."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Congregation Collection →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "trust_point",
      "name": "Trust point",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Premium materials"
        }
      ]
    },
    {
      "type": "badge_card",
      "name": "Badge card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Greeter"
        },
        {
          "type": "text",
          "id": "badge_type",
          "label": "Badge type",
          "default": "Printed Badge"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Multi-packs available"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AQB Church Spotlight",
      "blocks": [
        { "type": "trust_point", "settings": { "label": "Premium materials" } },
        { "type": "trust_point", "settings": { "label": "Built to last" } },
        { "type": "trust_point", "settings": { "label": "Bulk discounts" } },
        { "type": "trust_point", "settings": { "label": "English & Spanish" } },
        {
          "type": "badge_card",
          "settings": { "title": "Greeter", "badge_type": "Printed Badge", "tag": "Multi-packs available" }
        },
        {
          "type": "badge_card",
          "settings": { "title": "Ujier", "badge_type": "Printed Badge", "tag": "Multi-packs available" }
        },
        {
          "type": "badge_card",
          "settings": { "title": "Diácono", "badge_type": "Printed Badge", "tag": "Multi-packs available" }
        },
        {
          "type": "badge_card",
          "settings": { "title": "Deaconess", "badge_type": "Printed Badge", "tag": "Multi-packs available" }
        }
      ]
    }
  ]
}
{% endschema %}
