{% comment %}
  Badge + Desk Sign + Sign + Plaque designer iframe embed
  - Badge: custom-1x3-badge and custom-1x3-{icon}-badge listings → /badge-designer-redesign
    (optional ?badgeIconId= from handle, e.g. custom-1x3-airplane-badge)
  - Desk sign: product handle custom-desk-sign → /desk-sign-designer
    (use product template: desk-sign-designer)
  - Sign: product handle custom-sign → ?variant=sign or /sign-designer (Shape × Size variants, live price).
  - Plaque: product handle custom-plaque → ?variant=plaque or /plaque-designer (parallel to sign).

  Usage: Copy to theme snippets, then in your product template add: {% render 'badge-designer-embed' %}
{% endcomment %}

{% comment %}
  Replace with your actual Vercel app URL. Must match exactly where the iframe loads from.
{% endcomment %}
{% assign badge_designer_origin = 'https://all-quality-design-tool.vercel.app' %}

<script>
  (function() {
    var DESIGNER_ORIGIN = {{ badge_designer_origin | json }};

    function isAllowedDesignerOrigin(origin) {
      if (origin === DESIGNER_ORIGIN) return true;
      if (/^https?:\/\/localhost(:\d+)?$/.test(origin)) return true;
      if (/^https:\/\/.*\.vercel\.app$/.test(origin)) return true;
      return false;
    }

    function replyToDesigner(event, requestId, success, error) {
      if (!requestId || !event || !event.source) return;
      try {
        event.source.postMessage({
          action: 'add-to-cart-result',
          requestId: requestId,
          success: success,
          error: error || null
        }, event.origin);
      } catch (e) {
        console.error('Badge designer: could not ack iframe', e);
      }
    }

    /**
     * Remove the cart lines the edited design replaces. The edited design always
     * carries a new Design ID, so matching the old one cannot hit the new lines.
     * Removing every line for that Design ID keeps multi-badge designs in sync
     * with the proof PDF and the new cart set.
     */
    function aqbRemoveReplacedCartLines(cartRoot, replaceDesignId) {
      if (!replaceDesignId) return Promise.resolve();
      var base = cartRoot.replace(/\/$/, '');
      return fetch(base + '/cart.js', { headers: { 'Accept': 'application/json' } })
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          var stale = (cart.items || []).filter(function(item) {
            var props = item.properties || {};
            var id = props['_Design ID'] || props['Design ID'];
            return id === replaceDesignId;
          });
          // Sequential: each change.js response invalidates the previous line keys.
          return stale.reduce(function(chain, item) {
            return chain.then(function() {
              return fetch(base + '/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: item.key, quantity: 0 })
              });
            });
          }, Promise.resolve());
        })
        .catch(function(err) {
          // The new design is already in the cart; leaving the old line is better than failing.
          console.error('Badge designer: could not remove replaced cart lines', err);
        });
    }

    function aqbDesignerCartAdd(items, event, requestId, replaceDesignId) {
      if (!items || !items.length) {
        console.error('Badge designer: no cart items to add');
        replyToDesigner(event, requestId, false, 'No cart items to add');
        return;
      }
      var cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
      var cartAddUrl = cartRoot.replace(/\/$/, '') + '/cart/add.js';
      var payload = {
        items: items.map(function(item) {
          var variantId = parseInt(String(item.variantId), 10);
          return {
            id: variantId,
            quantity: item.quantity || 1,
            properties: item.properties || {}
          };
        })
      };
      fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function(res) {
          return res.json().then(function(body) {
            if (!res.ok) {
              var msg = (body && (body.description || body.message)) || ('HTTP ' + res.status);
              throw new Error(msg);
            }
            return body;
          });
        })
        .then(function() {
          return aqbRemoveReplacedCartLines(cartRoot, replaceDesignId);
        })
        .then(function() {
          replyToDesigner(event, requestId, true);
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        })
        .catch(function(err) {
          console.error('Badge designer: cart/add.js failed', err);
          var message = err && err.message ? err.message : String(err);
          replyToDesigner(event, requestId, false, message);
          alert('Could not add your design to the cart. Please try again or contact support.\n\n' + message);
        });
    }

    function getEditDesignRequest() {
      var params = new URLSearchParams(window.location.search);
      var designId = (params.get('editDesignId') || '').trim();
      if (!designId) return null;
      var badgeIndex = parseInt(params.get('editBadgeIndex'), 10);
      return {
        action: 'edit-design',
        designId: designId,
        badgeIndex: isNaN(badgeIndex) ? 0 : badgeIndex
      };
    }

    /**
     * Mirror the visual viewport into CSS vars. When the software keyboard opens
     * the visual viewport shrinks and scrolls inside the layout viewport, which
     * would otherwise push the pinned designer's preview off the top of the
     * screen while the customer types.
     */
    function aqbSyncVisualViewport() {
      var vv = window.visualViewport;
      if (!vv) return;
      var root = document.documentElement;
      root.style.setProperty('--aqb-vv-height', Math.round(vv.height) + 'px');
      root.style.setProperty('--aqb-vv-top', Math.round(vv.offsetTop) + 'px');
    }

    if (window.visualViewport) {
      var aqbVvFrame = null;
      var aqbOnViewportChange = function() {
        if (aqbVvFrame) return;
        aqbVvFrame = window.requestAnimationFrame(function() {
          aqbVvFrame = null;
          aqbSyncVisualViewport();
        });
      };
      window.visualViewport.addEventListener('resize', aqbOnViewportChange);
      window.visualViewport.addEventListener('scroll', aqbOnViewportChange);
      aqbSyncVisualViewport();
    }

    window.addEventListener('message', function(event) {
      if (!isAllowedDesignerOrigin(event.origin)) return;
      var data = event.data;
      if (!data || !data.action) return;

      // Liquid cannot read query params, so the designer asks once it is mounted
      // and we hand back the design the customer clicked in the cart.
      if (data.action === 'designer-ready') {
        var editRequest = getEditDesignRequest();
        if (editRequest && event.source) {
          try {
            event.source.postMessage(editRequest, event.origin);
          } catch (e) {
            console.error('Badge designer: could not send edit-design', e);
          }
        }
        return;
      }

      if (data.action === 'redirect-to-login') {
        var returnTo = window.location.pathname + window.location.search;
        window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent(returnTo);
        return;
      }

      if (data.action === 'add-to-cart' && data.payload) {
        aqbDesignerCartAdd([data.payload], event, data.requestId, data.payload.replaceDesignId);
        return;
      }

      if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
        aqbDesignerCartAdd(data.payload.items, event, data.requestId, data.payload.replaceDesignId);
        return;
      }

      if (data.action === 'design-saved') {
        console.log('Design saved:', data.payload);
        return;
      }

      if (data.action === 'designer-chrome') {
        setDesignerChromeCollapsed(!!data.collapsed);
        return;
      }

      if (data.action === 'designer-focus') {
        setDesignerFocus(!!data.locked, data.scrollTo || null);
      }
    });

    function setDesignerChromeCollapsed(collapsed) {
      if (document.documentElement.classList.contains('aqb-nav-drawer-open')) {
        return;
      }
      document.documentElement.classList.toggle(
        'aqb-designer-chrome-collapsed',
        !!collapsed
      );
    }

    var designerFocusLocked = false;
    var designerFocusScrollY = 0;

    function getDesignerEmbedEl() {
      return (
        document.querySelector('.aqb-designer-embed') ||
        document.querySelector('.badge-designer-iframe-outer') ||
        document.getElementById('badge-designer-iframe')
      );
    }

    function setDesignerFocus(locked, scrollTo) {
      var html = document.documentElement;
      var body = document.body;
      if (!body || !body.classList.contains('aqb-designer-product')) return;

      if (locked) {
        if (!designerFocusLocked) {
          designerFocusScrollY = window.scrollY || window.pageYOffset || 0;
        }
        designerFocusLocked = true;
        html.classList.add('aqb-designer-focus');
        setDesignerChromeCollapsed(true);

        var embed = getDesignerEmbedEl();
        if (embed && typeof embed.scrollIntoView === 'function') {
          embed.scrollIntoView({ block: 'start' });
        }

        body.style.overflow = 'hidden';
        body.style.overscrollBehavior = 'none';
        body.style.touchAction = 'none';
        html.style.overscrollBehavior = 'none';
        return;
      }

      if (!designerFocusLocked && scrollTo !== 'below') return;
      designerFocusLocked = false;
      html.classList.remove('aqb-designer-focus');
      setDesignerChromeCollapsed(false);
      body.style.overflow = '';
      body.style.overscrollBehavior = '';
      body.style.touchAction = '';
      html.style.overscrollBehavior = '';

      window.requestAnimationFrame(function() {
        if (scrollTo === 'below') {
          var embedEl = getDesignerEmbedEl();
          if (embedEl) {
            var rect = embedEl.getBoundingClientRect();
            var top =
              rect.bottom + (window.scrollY || window.pageYOffset || 0) + 8;
            window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
            return;
          }
        }
        window.scrollTo(0, designerFocusScrollY || 0);
      });
    }
  })();
</script>

{% comment %} Custom desk sign product {% endcomment %}
{% if product and product.handle == 'custom-desk-sign' %}

{% assign desk_sign_v0 = product.selected_or_first_available_variant | default: product.variants[0] %}
<div class="aqb-designer-embed">
  <iframe
    id="desk-sign-designer-iframe"
    title="Design your custom desk sign"
    src="{{ badge_designer_origin }}/desk-sign-designer?embedded=1&amp;shop={{ shop.permanent_domain | url_param_escape }}&amp;storeUrl={{ shop.permanent_domain | url_param_escape }}&amp;product={{ product.id | url_param_escape }}&amp;deskSignProductHandle={{ product.handle | url_param_escape }}&amp;variantIdSign={{ desk_sign_v0.id | url_param_escape }}{% if customer %}&amp;customerId={{ customer.id | url_param_escape }}{% endif %}"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>

{% comment %} Custom sign product (Shape × Size variants, live price from Shopify) {% endcomment %}
{% elsif product and product.handle == 'custom-sign' %}

{% assign sign_v0 = product.selected_or_first_available_variant | default: product.variants[0] %}
<div style="width:100%; min-height:900px;">
  <iframe
    id="sign-designer-iframe"
    src="{{ badge_designer_origin }}?embedded=1&amp;variant=sign&amp;shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&signProductHandle={{ product.handle | url_param_escape }}&variantIdSign={{ sign_v0.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
    style="width:100%; height:900px; border:0;"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>

{% comment %} Custom plaque product {% endcomment %}
{% elsif product and product.handle == 'custom-plaque' %}

{% assign plaque_v0 = product.selected_or_first_available_variant | default: product.variants[0] %}
<div style="width:100%; min-height:900px;">
  <iframe
    id="plaque-designer-iframe"
    src="{{ badge_designer_origin }}/plaque-designer?embedded=1&amp;shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&plaqueProductHandle={{ product.handle | url_param_escape }}&variantIdSign={{ plaque_v0.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
    style="width:100%; height:900px; border:0;"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>

{% comment %} Custom badge product + icon listing products (pin / magnetic / adhesive) {% endcomment %}
{% else %}
{% assign aqb_is_badge_designer_product = false %}
{% assign aqb_badge_icon_preset = '' %}
{% assign aqb_bd_handle = product.handle | default: '' | strip | downcase %}
{% if aqb_bd_handle == 'custom-1x3-badge' %}
  {% assign aqb_is_badge_designer_product = true %}
{% elsif aqb_bd_handle contains 'custom-1x3-' %}
  {% assign aqb_bd_after = aqb_bd_handle | replace_first: 'custom-1x3-', '' %}
  {% if aqb_bd_after != blank and aqb_bd_after != 'badge' %}
    {% assign aqb_badge_icon_preset = aqb_bd_after | replace: '-badge', '' %}
    {% if aqb_badge_icon_preset != blank and aqb_badge_icon_preset != aqb_bd_after %}
      {% assign aqb_is_badge_designer_product = true %}
    {% endif %}
  {% endif %}
{% endif %}
{% if aqb_is_badge_designer_product == false and product.tags contains 'custom-icon-badge' %}
  {% assign aqb_is_badge_designer_product = true %}
  {% if aqb_badge_icon_preset == blank and aqb_bd_handle contains 'custom-1x3-' %}
    {% assign aqb_bd_after = aqb_bd_handle | replace_first: 'custom-1x3-', '' %}
    {% if aqb_bd_after != blank and aqb_bd_after != 'badge' %}
      {% assign aqb_badge_icon_preset = aqb_bd_after | replace: '-badge', '' %}
    {% endif %}
  {% endif %}
{% endif %}
{% if product and aqb_is_badge_designer_product %}

{% assign badge_designer_path = '/badge-designer-redesign' %}

{% assign v0 = product.variants[0] %}
{% assign v1 = product.variants[1] | default: v0 %}
{% assign v2 = product.variants[2] | default: v0 %}
{% comment %} Duplicate-set variants only apply to the original custom-1x3-badge product. {% endcomment %}
{% assign duplicate_params = '' %}
{% if product.handle == 'custom-1x3-badge' %}
  {% assign duplicate_product = all_products['custom-1x3-badge-duplicate'] %}
  {% if duplicate_product and duplicate_product.variants.size >= 3 %}
    {% assign dup0 = duplicate_product.variants[0] %}
    {% assign dup1 = duplicate_product.variants[1] %}
    {% assign dup2 = duplicate_product.variants[2] %}
    {% assign duplicate_params = '&variantIdPinDuplicate=' | append: dup0.id %}
    {% assign duplicate_params = duplicate_params | append: '&variantIdMagneticDuplicate=' | append: dup1.id %}
    {% assign duplicate_params = duplicate_params | append: '&variantIdAdhesiveDuplicate=' | append: dup2.id %}
  {% endif %}
{% endif %}
{% assign badge_icon_param = '' %}
{% if aqb_badge_icon_preset != blank %}
  {% assign badge_icon_param = '&badgeIconId=' | append: aqb_badge_icon_preset | append: '&completeEarlySteps=1' %}
{% endif %}
<div class="aqb-designer-embed">
  <iframe
    id="badge-designer-iframe"
    title="Design your custom badge"
    src="{{ badge_designer_origin }}{{ badge_designer_path }}?embedded=1&amp;shop={{ shop.permanent_domain | url_param_escape }}&amp;storeUrl={{ shop.permanent_domain | url_param_escape }}&amp;product={{ product.id | url_param_escape }}&amp;variantIdPin={{ v0.id | url_param_escape }}&amp;variantIdMagnetic={{ v1.id | url_param_escape }}&amp;variantIdAdhesive={{ v2.id | url_param_escape }}{{ duplicate_params }}{{ badge_icon_param }}{% if customer %}&amp;customerId={{ customer.id | url_param_escape }}{% endif %}"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>
{% render 'aqb-badge-designer-seo' %}

{% endif %}
{% endif %}
