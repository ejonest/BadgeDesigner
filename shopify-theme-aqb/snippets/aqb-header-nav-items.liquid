{%- liquid
  assign nav_context = context | default: 'desktop'
  assign is_first_desktop_nav = true
-%}
{%- for block in section.blocks -%}
  {%- if block.type == 'nav_link' -%}
    {%- liquid
      assign link_url = block.settings.url
      assign is_active = false
      if block.settings.active_paths != blank
        assign path_checks = block.settings.active_paths | split: ','
        for path_part in path_checks
          assign path_trim = path_part | strip
          if path_trim != blank and request.path contains path_trim
            assign is_active = true
            break
          endif
        endfor
      endif
    -%}
    {%- liquid
      assign nav_priority = 60
      case block.settings.label
        when 'Bulk Orders'
          assign nav_priority = 50
        when 'Design Your Badge'
          assign nav_priority = 80
        when 'Name Tag Blanks'
          assign nav_priority = 60
      endcase
    -%}
    {%- if nav_context == 'desktop' -%}
      <li
        class="aqb-store-nav__nav-item{% if is_first_desktop_nav %} aqb-store-nav__item--primary{% endif %}"
        data-nav-collapsible
        data-nav-priority="{{ nav_priority }}"
        {{ block.shopify_attributes }}
      >
        <a
          href="{{ link_url }}"
          class="{% if is_active %}is-active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
        >
          {%- liquid
            assign short_label = block.settings.label_short
            if short_label == blank and block.settings.label == 'Design Your Badge'
              assign short_label = 'Design Badge'
            endif
          -%}
          {%- if short_label != blank -%}
            <span class="aqb-store-nav__label-full" data-nav-collapsible data-nav-priority="79">{{ block.settings.label | escape }}</span>
            <span class="aqb-store-nav__label-short">{{ short_label | escape }}</span>
          {%- else -%}
            {{ block.settings.label | escape }}
          {%- endif -%}
        </a>
      </li>
      {%- assign is_first_desktop_nav = false -%}
    {%- else -%}
      <li>
        <a href="{{ link_url }}" class="{% if is_active %}is-active{% endif %}">
          {{ block.settings.label | escape }}
        </a>
      </li>
    {%- endif -%}
  {%- elsif block.type == 'nav_dropdown' -%}
    {%- liquid
      assign menu_id = block.settings.menu_id | strip
      assign dropdown_url = block.settings.url
      assign is_active = false
      if block.settings.active_paths != blank
        assign path_checks = block.settings.active_paths | split: ','
        for path_part in path_checks
          assign path_trim = path_part | strip
          if path_trim != blank and request.path contains path_trim
            assign is_active = true
            break
          endif
        endfor
      endif
      assign item_count = 0
      for item_block in section.blocks
        if item_block.type == 'nav_dropdown_item' and item_block.settings.menu_id == menu_id
          assign item_count = item_count | plus: 1
        endif
      endfor
      assign columns = block.settings.columns | default: '1'
      assign nav_priority = 60
      case block.settings.menu_id
        when 'church'
          assign nav_priority = 55
        when 'roles'
          assign nav_priority = 70
        when 'desk'
          assign nav_priority = 65
      endcase
    -%}
    {%- if nav_context == 'desktop' -%}
      <li
        class="aqb-store-nav__dropdown aqb-store-nav__nav-item{% if item_count > 0 %} has-menu{% endif %}{% if is_first_desktop_nav %} aqb-store-nav__item--primary{% endif %}"
        data-nav-collapsible
        data-nav-priority="{{ nav_priority }}"
        {{ block.shopify_attributes }}
        data-nav-dropdown
      >
        <a
          href="{{ dropdown_url }}"
          class="aqb-store-nav__dropdown-trigger{% if is_active %} is-active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
          {% if item_count > 0 %}aria-haspopup="true" aria-expanded="false"{% endif %}
        >
          <span>{{ block.settings.label | escape }}</span>
          {%- if item_count > 0 -%}
            <svg class="aqb-store-nav__dropdown-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- endif -%}
        </a>
        {%- if item_count > 0 -%}
          <div class="aqb-store-nav__dropdown-panel{% if columns == '2' %} is-two-col{% endif %}" role="menu" hidden>
            {%- for item_block in section.blocks -%}
              {%- if item_block.type == 'nav_dropdown_item' and item_block.settings.menu_id == menu_id -%}
                <a href="{{ item_block.settings.url }}" class="aqb-store-nav__dropdown-link" role="menuitem">
                  {{ item_block.settings.label | escape }}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </li>
      {%- assign is_first_desktop_nav = false -%}
    {%- else -%}
      <li class="aqb-store-nav__drawer-group{% if item_count > 0 %} has-submenu{% endif %}" data-nav-accordion {{ block.shopify_attributes }}>
        {%- if item_count > 0 -%}
          <button type="button" class="aqb-store-nav__drawer-group-toggle{% if is_active %} is-active{% endif %}" aria-expanded="false">
            <span>{{ block.settings.label | escape }}</span>
            <svg class="aqb-store-nav__drawer-caret" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3.5L5 6.5L8 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul class="aqb-store-nav__drawer-submenu" hidden>
            {%- for item_block in section.blocks -%}
              {%- if item_block.type == 'nav_dropdown_item' and item_block.settings.menu_id == menu_id -%}
                <li>
                  <a href="{{ item_block.settings.url }}">{{ item_block.settings.label | escape }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- else -%}
          <a href="{{ dropdown_url }}" class="{% if is_active %}is-active{% endif %}">{{ block.settings.label | escape }}</a>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
