{% comment %}
  Cart details for custom designer lines.
  Internal props are underscore-prefixed (hidden in checkout); this snippet
  reads `_Name` with fallback to legacy `Name` for older cart lines.
  Customer-facing: text lines + attachment only.
  Pass: item (cart item)
{% endcomment %}
{%- liquid
  assign aqb_is_custom = false
  if item.properties['_Custom Badge Design'] == 'Yes' or item.properties['Custom Badge Design'] == 'Yes'
    assign aqb_is_custom = true
  endif
  assign aqb_backing = item.properties['_Backing Type'] | default: item.properties['Backing Type']
-%}
{%- if aqb_is_custom -%}
  <div class="badge-cart-details" style="margin-top: 8px; padding: 10px; background: #f8f9fa; border-radius: 6px; font-size: 0.9em;">
    {%- if item.properties['Badge Text Line 1'] != blank -%}
      <p style="margin: 2px 0;">{{ item.properties['Badge Text Line 1'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 2'] != blank -%}
      <p style="margin: 2px 0;">{{ item.properties['Badge Text Line 2'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 3'] != blank -%}
      <p style="margin: 2px 0;">{{ item.properties['Badge Text Line 3'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 4'] != blank -%}
      <p style="margin: 2px 0;">{{ item.properties['Badge Text Line 4'] }}</p>
    {%- endif -%}
    {%- if aqb_backing != blank -%}
      <p style="margin: 2px 0;"><strong>Attachment:</strong> {{ aqb_backing | capitalize }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
