{%- comment -%}
  ItemList JSON-LD for /pages/badge-blank — blank name tag configurator.
  Summary-page pattern: each ListItem has position + url only (no nested Product).
  Product details live on linked /products/ pages — mixing url + item on ListItem
  triggers Google's "mutually-exclusive properties" carousel error.
{%- endcomment -%}
{%- if page.handle == 'badge-blank' -%}
  {%- assign blanks_page_url = shop.url | append: page.url -%}

  {%- assign schema_p_rounded_1x3 = all_products['rounded-rectangle-1x3-brushed-gold'] -%}
  {%- assign schema_p_oval = all_products['oval-1-5x3-5-brushed-gold'] -%}
  {%- assign schema_p_square = all_products['square-corners-1x3-brushed-gold'] -%}
  {%- assign schema_p_designer = all_products['designer-brushed-gold'] -%}
  {%- assign schema_p_rounded_15 = all_products['rounded-rectangle-1-5x3-brushed-silver'] -%}

  {%- if schema_p_rounded_1x3 -%}
    {%- assign schema_url_rounded_1x3 = shop.url | append: schema_p_rounded_1x3.url -%}
  {%- else -%}
    {%- assign schema_url_rounded_1x3 = blanks_page_url -%}
  {%- endif -%}
  {%- if schema_p_oval -%}
    {%- assign schema_url_oval = shop.url | append: schema_p_oval.url -%}
  {%- else -%}
    {%- assign schema_url_oval = blanks_page_url -%}
  {%- endif -%}
  {%- if schema_p_square -%}
    {%- assign schema_url_square = shop.url | append: schema_p_square.url -%}
  {%- else -%}
    {%- assign schema_url_square = blanks_page_url -%}
  {%- endif -%}
  {%- if schema_p_designer -%}
    {%- assign schema_url_designer = shop.url | append: schema_p_designer.url -%}
  {%- else -%}
    {%- assign schema_url_designer = blanks_page_url -%}
  {%- endif -%}
  {%- if schema_p_rounded_15 -%}
    {%- assign schema_url_rounded_15 = shop.url | append: schema_p_rounded_15.url -%}
  {%- else -%}
    {%- assign schema_url_rounded_15 = blanks_page_url -%}
  {%- endif -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Blank Name Tags & Badge Blanks",
  "description": "High-quality blank name tags in multiple sizes, shapes and backing types.",
  "url": {{ blanks_page_url | json }},
  "numberOfItems": 5,
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "url": {{ schema_url_rounded_1x3 | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "url": {{ schema_url_oval | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "url": {{ schema_url_square | json }}
    },
    {
      "@type": "ListItem",
      "position": 4,
      "url": {{ schema_url_designer | json }}
    },
    {
      "@type": "ListItem",
      "position": 5,
      "url": {{ schema_url_rounded_15 | json }}
    }
  ]
}
</script>
{%- endif -%}
