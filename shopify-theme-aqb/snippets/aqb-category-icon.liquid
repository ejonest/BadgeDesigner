{%- comment -%} Decorative icons for category card footers {%- endcomment -%}
<span class="cat-info__icon-svg" aria-hidden="true">
  {%- case icon -%}
    {%- when 'church' -%}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2L4 8v2h2v10h4v-6h4v6h4V10h2V8l-8-6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <path d="M12 5v3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    {%- when 'engraved' -%}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M5 18h14M7 14l3-8 3 5 2-3 2 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="18" cy="6" r="2" fill="currentColor"/>
      </svg>
    {%- when 'blanks' -%}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="3" y="7" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" stroke="currentColor" stroke-width="1.4"/>
        <path d="M12 11v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    {%- when 'desk' -%}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 16h16v3H4v-3z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <path d="M6 16V9h12v7" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
        <path d="M9 9V6h6v3" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
      </svg>
    {%- else -%}
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="4" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.4"/>
      </svg>
  {%- endcase -%}
</span>
