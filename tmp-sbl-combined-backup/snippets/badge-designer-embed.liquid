{% comment %}
  Badge designer — ONE iframe only (same layout rules as sign-designer-embed / plaque-designer-embed).

  DUPLICATE / WRONG PAGE SAFETY
  - This snippet only outputs when the current product is the custom-1x3-badge product (same rule as
    product-template-default's is_badge_designer_product). Sync the handle/title check below with that
    section if you change the product slug.
  - Variant order matters: variants[0] = pin, [1] = magnet, [2] = adhesive.

  Optional: {% render 'badge-designer-embed', badge_designer_force: true %} to bypass the product check
  (advanced / debugging only).

  Set badge_designer_url to your Vercel origin (no path, no trailing slash).
{% endcomment %}
{% liquid
  assign badge_designer_url = 'https://all-quality-design-tool.vercel.app'
  assign badge_designer_match = false
  if badge_designer_force
    assign badge_designer_match = true
  elsif product != blank
    if product.handle == 'custom-1x3-badge' or product.title == 'Custom 1x3 Badge'
      assign badge_designer_match = true
    endif
  endif
%}
{% if badge_designer_match %}
{% assign badge_v0 = product.variants[0] %}
{% assign badge_v1 = product.variants[1] | default: badge_v0 %}
{% assign badge_v2 = product.variants[2] | default: badge_v0 %}
<iframe
  class="badge-designer-iframe"
  data-badge-designer-embed-root
  title="Badge designer"
  src="{{ badge_designer_url }}/badge-designer-redesign?embedded=1&shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&variantIdPin={{ badge_v0.id | url_param_escape }}&variantIdMagnetic={{ badge_v1.id | url_param_escape }}&variantIdAdhesive={{ badge_v2.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
  style="display:block;width:100%;height:min(90vh,900px);border:0;"
  loading="lazy"
  allow="clipboard-read; clipboard-write"
></iframe>

<script>
(function () {
  var iframeEl = document.currentScript && document.currentScript.previousElementSibling;
  if (!iframeEl || iframeEl.tagName !== 'IFRAME' || iframeEl.getAttribute('data-badge-designer-embed-root') == null) {
    return;
  }
  var all = document.querySelectorAll('iframe.badge-designer-iframe[data-badge-designer-embed-root]');
  if (all.length > 1) {
    for (var d = 1; d < all.length; d++) {
      all[d].remove();
    }
  }
  if (!iframeEl.isConnected) {
    return;
  }

  if (window.__badgeDesignerEmbedMessageBound) {
    return;
  }
  window.__badgeDesignerEmbedMessageBound = true;

  var designerOrigin = '{{ badge_designer_url }}'.replace(/\/$/, '');
  var cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/').replace(/\/$/, '');

  function replyToDesigner(event, requestId, success, error) {
    if (!requestId || !event.source) return;
    event.source.postMessage({ action: 'add-to-cart-result', requestId: requestId, success: success, error: error || null }, event.origin);
  }

  function removeReplacedCartLines(replaceDesignId) {
    if (!replaceDesignId) return Promise.resolve();
    return fetch(cartRoot + '/cart.js', { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var stale = (cart.items || []).filter(function (item) {
          var props = item.properties || {};
          return (props['_Design ID'] || props['Design ID']) === replaceDesignId;
        });
        // Sequential: each change.js response invalidates the previous line keys.
        return stale.reduce(function (chain, item) {
          return chain.then(function () {
            return fetch(cartRoot + '/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: item.key, quantity: 0 })
            });
          });
        }, Promise.resolve());
      })
      .catch(function (err) {
        console.error('Badge designer: could not remove replaced cart lines', err);
      });
  }

  function addToCart(items, event, requestId, replaceDesignId) {
    if (!items || !items.length) {
      replyToDesigner(event, requestId, false, 'No cart items to add');
      return;
    }
    fetch(cartRoot + '/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        items: items.map(function (item) {
          return { id: parseInt(String(item.variantId), 10), quantity: item.quantity || 1, properties: item.properties || {} };
        })
      })
    })
      .then(function (res) {
        return res.json().then(function (body) {
          if (!res.ok) throw new Error((body && (body.description || body.message)) || ('HTTP ' + res.status));
          return body;
        });
      })
      .then(function () { return removeReplacedCartLines(replaceDesignId); })
      .then(function () {
        replyToDesigner(event, requestId, true);
        window.location.href = cartRoot + '/cart';
      })
      .catch(function (err) {
        var message = err && err.message ? err.message : String(err);
        console.error('Badge designer: cart/add.js failed', err);
        replyToDesigner(event, requestId, false, message);
        alert('Could not add your badge to the cart. Please try again.\n\n' + message);
      });
  }

  function getEditDesignRequest() {
    var params = new URLSearchParams(window.location.search);
    var designId = (params.get('editDesignId') || '').trim();
    if (!designId) return null;
    var badgeIndex = parseInt(params.get('editBadgeIndex'), 10);
    return { action: 'edit-design', designId: designId, badgeIndex: isNaN(badgeIndex) ? 0 : badgeIndex };
  }

  window.addEventListener('message', function (event) {
    if (event.origin !== designerOrigin) return;
    var data = event.data;
    if (!data || !data.action) return;
    if (data.action === 'designer-ready') {
      var editRequest = getEditDesignRequest();
      if (editRequest && event.source) event.source.postMessage(editRequest, event.origin);
      return;
    }
    if (data.action === 'redirect-to-login') {
      var returnTo = window.location.pathname + window.location.search;
      window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent(returnTo);
      return;
    }
    if (data.action === 'add-to-cart' && data.payload) {
      addToCart([data.payload], event, data.requestId, data.payload.replaceDesignId);
      return;
    }
    if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
      addToCart(data.payload.items, event, data.requestId, data.payload.replaceDesignId);
    }
  });
})();
</script>
{% endif %}
