# Copy to .env for local overrides (not committed).

# Supabase (server-only; never expose the service-role key to browser code)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional pen-only override. The shared AQB storefront normally uses
# LINK_ORDER_SECRET and SHOPIFY_WEBHOOK_SECRET_AQB already configured in Vercel.
# LINK_ORDER_SECRET_PEN=

# Plaque designer (Gadget + link-order; mirror sign vars)
# GADGET_PLAQUE_API_URL=https://your-plaque-app--development.gadget.app
# GADGET_PLAQUE_API_KEY=
# LINK_ORDER_SECRET_PLAQUE=

# Gavel designer (dedicated Gadget app — see docs/GADGET_GAVEL_SETUP.md)
# GADGET_GAVEL_API_URL=https://gavels-fast-connection--development.gadget.app
# GADGET_GAVEL_API_KEY=
# LINK_ORDER_SECRET_GAVEL=

# Trophy designer (optional; falls back to LINK_ORDER_SECRET)
# LINK_ORDER_SECRET_TROPHY=
# GADGET_TROPHY_API_URL=
# GADGET_TROPHY_API_KEY=

# Native Shopify orders/paid HMAC for Gavels Fast (gavel, pen, trophy, plaque)
# SHOPIFY_WEBHOOK_SECRET_GAVEL=

# Shopify Admin inventory lookup — without these the designer falls back to the
# storefront "available" flag, which stays true for variants set to continue
# selling when out of stock. Custom app scopes: read_products, read_inventory.
# SHOPIFY_ADMIN_SHOP=gavelsfast.myshopify.com
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_...
# SHOPIFY_ADMIN_API_VERSION=2026-07

# Shopify Admin production-order block. Paste ONLY the Client secret
# (starts with shpss_) from Dev Dashboard → that app → Settings / Credentials.
# Do not use the Client ID, an Admin API access token (shpat_…), or JSON.
# SHOPIFY_ADMIN_GF_CLIENT_SECRET=shpss_...
# SHOPIFY_ADMIN_AQB_CLIENT_SECRET=shpss_...
# SHOPIFY_ADMIN_SBL_CLIENT_SECRET=shpss_...

# Design library: fake Shopify user + shop in Vite dev only (browser must see VITE_*).
# Or open the designer with ?designLibraryDummy=1 instead of setting this.
# Redesign sandbox route (same APIs as /): /badge-designer-redesign?designLibraryDummy=1
# VITE_DESIGN_LIBRARY_DUMMY_MODE=true
# VITE_DESIGN_LIBRARY_DUMMY_USER_ID=local-test-customer
# VITE_DESIGN_LIBRARY_DUMMY_SHOP_ID=test-shop.myshopify.com
