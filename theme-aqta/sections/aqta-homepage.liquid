<section id="aqta-home" class="aqta-home" data-aqta-home>
  {% render 'aqta-header', section_id: section.id %}

  <div class="aqta-home__hero">
    <div class="aqta-home__wrap aqta-home__hero-grid">
      <div>
        <p class="aqta-home__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <div class="aqta-home__picker">
          <h1 class="aqta-home__hero-title">
            {{ section.settings.hero_heading | escape }}
            <button type="button" class="aqta-home__rotator" data-aqta-rotator aria-expanded="false" aria-controls="aqta-menu-panel-{{ section.id }}">
              <span class="aqta-home__rotator-word"><span data-aqta-rotator-label>team</span><span aria-hidden="true">.</span></span>
              <svg class="aqta-home__rotator-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.2 6.1 8 10.4l4.8-4.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
          </h1>
          <div class="aqta-home__menu" id="aqta-menu-panel-{{ section.id }}" data-aqta-menu hidden>
            <button type="button" class="aqta-home__menu-close" data-aqta-menu-close aria-label="Close award list">×</button>
            <p class="aqta-home__menu-label">Popular awards</p>
            <div class="aqta-home__menu-pills">
              <button type="button" data-aqta-pick="team">Team trophies</button>
              <button type="button" data-aqta-pick="school">Academic awards</button>
              <button type="button" data-aqta-pick="company">Corporate recognition</button>
              <button type="button" data-aqta-pick="champion">Victory trophies</button>
              <button type="button" data-aqta-pick="league">Sports trophies</button>
              <button type="button" data-aqta-pick="church">Classic awards</button>
            </div>
            <p class="aqta-home__menu-label">By occasion</p>
            <div class="aqta-home__menu-cols">
              <div>
                <p>Sports</p>
                <a href="/pages/trophies">League trophies</a>
                <a href="/pages/medals">Finish medals</a>
              </div>
              <div>
                <p>Schools</p>
                <a href="/pages/plaques">Honor plaques</a>
                <a href="/pages/trophies">Academic trophies</a>
              </div>
              <div>
                <p>Work &amp; community</p>
                <a href="/pages/trophies">Employee awards</a>
                <a href="/pages/plaques">Service plaques</a>
              </div>
            </div>
            <p class="aqta-home__menu-note">Product pages will be linked here once the awards catalog is imported.</p>
          </div>
        </div>
        <p class="aqta-home__hero-text">{{ section.settings.hero_text | escape }}</p>
        <div class="aqta-home__quick-links" aria-label="Award types">
          <button type="button" data-aqta-pick="team" aria-current="true">team</button>
          <button type="button" data-aqta-pick="school">school</button>
          <button type="button" data-aqta-pick="company">company</button>
          <button type="button" data-aqta-pick="champion">champion</button>
          <button type="button" data-aqta-pick="league">league</button>
          <button type="button" data-aqta-pick="church">church</button>
        </div>
        <div class="aqta-home__start">
          <div class="aqta-home__start-copy">
            <span>Your award can say anything</span>
            <strong>Add a name, date, and message</strong>
          </div>
          <a class="aqta-home__button aqta-home__button--gold" href="#aqta-trophies">See award styles <span aria-hidden="true">→</span></a>
        </div>
        <div class="aqta-home__hero-notes">
          <span>✓ Trophies, medals, and plaques</span>
          <span>✓ Custom engraving</span>
          <span>✓ Bulk sets for teams and schools</span>
        </div>
      </div>

      <div class="aqta-home__stage">
        <span class="aqta-home__stage-kicker">Award styles <span>· for your <span data-aqta-card-word>team</span></span></span>
        <div class="aqta-home__stage-frame">
          <img class="aqta-home__slide" data-aqta-slide="team" data-active="true" src="{{ 'aqta-team-trophy.jpg' | asset_url }}" alt="Gold team player trophy with a black base and an engraving plate" width="800" height="800" loading="eager">
          <img class="aqta-home__slide" data-aqta-slide="school" src="{{ 'aqta-honor-trophy.jpg' | asset_url }}" alt="Gold honor roll trophy with a graduation cap emblem" width="800" height="800" loading="lazy">
          <img class="aqta-home__slide" data-aqta-slide="company" src="{{ 'aqta-employee-trophy.jpg' | asset_url }}" alt="Gold employee of the month trophy" width="800" height="800" loading="lazy">
          <img class="aqta-home__slide" data-aqta-slide="champion" src="{{ 'aqta-victory-trophy.jpg' | asset_url }}" alt="Gold victory figurine trophy with a purple engraving plate" width="800" height="1000" loading="lazy">
          <img class="aqta-home__slide" data-aqta-slide="league" src="{{ 'aqta-medal-soccer.png' | asset_url }}" alt="Gold, silver, and bronze soccer medals with place ribbons" width="900" height="900" loading="lazy">
          <img class="aqta-home__slide" data-aqta-slide="church" src="{{ 'aqta-star-trophy.jpg' | asset_url }}" alt="Gold star trophy on a black base" width="800" height="1000" loading="lazy">
        </div>
        <span class="aqta-home__stage-note">Catalog links will be added with the new products.</span>
      </div>
    </div>
  </div>

  <div class="aqta-home__search-wrap" id="aqta-search">
    <div class="aqta-home__wrap">
      <form class="aqta-home__search" action="{{ routes.search_url }}" method="get" role="search">
        <span class="aqta-home__search-icon" aria-hidden="true">⌕</span>
        <label class="aqta-home__visually-hidden" for="aqta-search-input-{{ section.id }}">Search awards</label>
        <input id="aqta-search-input-{{ section.id }}" type="search" name="q" placeholder="Search trophies, medals, and plaques" autocomplete="off">
        <input type="hidden" name="type" value="product">
        <button type="submit">Search</button>
      </form>
    </div>
  </div>

  <div class="aqta-home__proof">
    <div class="aqta-home__wrap aqta-home__proof-grid">
      <div><strong>Trophies</strong><span>Figurines, stars, and sports awards</span></div>
      <div><strong>Medals</strong><span>Finish medals for races, teams, and events</span></div>
      <div><strong>Plaques</strong><span>Photo plaques and engraved recognition</span></div>
      <div><strong>Bulk sets</strong><span>Matching awards for a whole roster</span></div>
    </div>
  </div>

  <div class="aqta-home__section aqta-home__section--cream" id="aqta-categories">
    <div class="aqta-home__wrap">
      <div class="aqta-home__heading-row">
        <div>
          <p class="aqta-home__section-label">The lineup</p>
          <h2>{{ section.settings.categories_heading | escape }}</h2>
        </div>
      </div>
      <div class="aqta-home__category-grid">
        <a class="aqta-home__category-card" id="aqta-trophies" href="/pages/trophies">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-star-trophy.jpg' | asset_url }}" alt="Gold star trophy" width="800" height="1000" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Trophies</h3><p>Stars, figurines, and sports trophies with an engraving plate.</p><span>View styles</span></div>
        </a>
        <a class="aqta-home__category-card" id="aqta-medals" href="/pages/medals">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-medal-gold.png' | asset_url }}" alt="Gold first place medal hanging from its ribbon" width="900" height="900" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Medals</h3><p>Gold, silver, and bronze medals for races, teams, and ceremonies.</p><span>View styles</span></div>
        </a>
        <a class="aqta-home__category-card" id="aqta-plaques" href="/pages/plaques">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-plaque-boss.jpg' | asset_url }}" alt="Full wooden best boss award plaque on an easel" width="900" height="900" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Plaques</h3><p>Wooden award plaques with a full engraved plate and easel stand.</p><span>View styles</span></div>
        </a>
        <a class="aqta-home__category-card" href="/pages/occasions#sports">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-medal-baseball.png' | asset_url }}" alt="Gold, silver, and bronze baseball medals with place ribbons" width="900" height="900" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Sports</h3><p>Baseball, soccer, and action awards for leagues and tournaments.</p><span>View styles</span></div>
        </a>
        <a class="aqta-home__category-card" href="/pages/occasions#companies">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-employee-trophy.jpg' | asset_url }}" alt="Employee of the month trophy" width="800" height="800" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Corporate</h3><p>Employee, sales, and service awards with a custom plate.</p><span>View styles</span></div>
        </a>
        <a class="aqta-home__category-card" href="/pages/occasions#schools">
          <div class="aqta-home__category-image"><img src="{{ 'aqta-medal-spelling.png' | asset_url }}" alt="Spelling bee medallion with a star border" width="900" height="900" loading="lazy"></div>
          <div class="aqta-home__category-copy"><h3>Academic</h3><p>Honor roll, attendance, and graduation recognition.</p><span>View styles</span></div>
        </a>
      </div>
    </div>
  </div>

  <div class="aqta-home__section aqta-home__section--navy" id="aqta-occasions">
    <div class="aqta-home__wrap">
      <div class="aqta-home__heading-row aqta-home__heading-row--light">
        <div>
          <p class="aqta-home__section-label">Shop by occasion</p>
          <h2>{{ section.settings.occasions_heading | escape }}</h2>
        </div>
        <a href="/pages/occasions">All occasions</a>
      </div>
      <div class="aqta-home__occasion-grid">
        <a class="aqta-home__occasion-card" href="/pages/occasions#sports">
          <img src="{{ 'aqta-medal-soccer.png' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Sports &amp; teams</strong><small>Trophies and medals for the season</small></span>
        </a>
        <a class="aqta-home__occasion-card" href="/pages/occasions#schools">
          <img src="{{ 'aqta-plaque-graduation.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Schools</strong><small>Honor roll, sports, and graduation</small></span>
        </a>
        <a class="aqta-home__occasion-card" href="/pages/occasions#companies">
          <img src="{{ 'aqta-plaque-employee.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Companies</strong><small>Employee and sales recognition</small></span>
        </a>
        <a class="aqta-home__occasion-card" href="/pages/occasions#churches">
          <img src="{{ 'aqta-plaque-service.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Churches</strong><small>Service and volunteer awards</small></span>
        </a>
        <a class="aqta-home__occasion-card" href="/pages/occasions#youth">
          <img src="{{ 'aqta-medal-swim.png' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Youth leagues</strong><small>A matching award for every player</small></span>
        </a>
        <a class="aqta-home__occasion-card" href="/pages/bulk-orders">
          <img src="{{ 'aqta-plaque-honor.jpg' | asset_url }}" alt="" width="900" height="900" loading="lazy">
          <span><strong>Banquets</strong><small>Sets for the whole roster</small></span>
        </a>
      </div>
    </div>
  </div>

  <div class="aqta-home__band aqta-home__band--cream">
    <div class="aqta-home__wrap aqta-home__band-grid">
      <div>
        <p class="aqta-home__section-label">Trophies</p>
        <h2>Trophies made for your winners.</h2>
        <p>Choose a figure, star, or sports trophy, then add the name and the line that goes on the plate.</p>
        <a class="aqta-home__button aqta-home__button--gold" href="/pages/trophies">View trophy styles <span aria-hidden="true">→</span></a>
      </div>
      <div class="aqta-home__band-image">
        <img src="{{ 'aqta-victory-trophy.jpg' | asset_url }}" alt="Gold victory figurine trophy" width="800" height="1000" loading="lazy">
      </div>
    </div>
  </div>

  <div class="aqta-home__band aqta-home__band--navy">
    <div class="aqta-home__wrap aqta-home__band-grid aqta-home__band-grid--flip">
      <div class="aqta-home__band-image">
        <img src="{{ 'aqta-plaque-honor.jpg' | asset_url }}" alt="Full wooden honor roll plaque on an easel" width="900" height="900" loading="lazy">
      </div>
      <div>
        <p class="aqta-home__section-label">Plaques</p>
        <h2>The whole plaque, ready to present.</h2>
        <p>Wooden award plaques with the plate, the frame, and the easel. Add the name, the date, and the line you want remembered.</p>
        <a class="aqta-home__button aqta-home__button--gold" href="/pages/plaques">View plaque styles <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="aqta-home__band aqta-home__band--cream">
    <div class="aqta-home__wrap aqta-home__band-grid">
      <div>
        <p class="aqta-home__section-label">Medals</p>
        <h2>A medal for every finish.</h2>
        <p>Race medals, participation medals, and championship medals, ready for a name and an event date.</p>
        <a class="aqta-home__button aqta-home__button--navy" href="/pages/medals">View medal styles <span aria-hidden="true">→</span></a>
      </div>
      <div class="aqta-home__band-image">
        <img src="{{ 'aqta-medal-set.png' | asset_url }}" alt="Gold, silver, and bronze victory medals with place ribbons" width="900" height="900" loading="lazy">
      </div>
    </div>
  </div>

  <div class="aqta-home__section aqta-home__section--cream" id="aqta-bulk">
    <div class="aqta-home__wrap aqta-home__bulk">
      <div>
        <p class="aqta-home__section-label">Bulk &amp; banquet orders</p>
        <h2>{{ section.settings.bulk_heading | escape }}</h2>
        <p>{{ section.settings.bulk_text | escape }}</p>
        <ul>
          <li>✓ One look for the whole set</li>
          <li>✓ Change only the name on each award</li>
          <li>✓ A person reviews the roster and sends pricing</li>
        </ul>
        <a class="aqta-home__button aqta-home__button--navy" href="/pages/bulk-orders">Request a bulk quote <span aria-hidden="true">→</span></a>
      </div>
      <div class="aqta-home__band-image">
        <img src="{{ 'aqta-team-trophy.jpg' | asset_url }}" alt="Gold team player trophy for a group award set" width="800" height="800" loading="lazy">
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  body:has(#aqta-home) > header { display: none; }
  #aqta-home {
    --aqta-navy: #0f2744;
    --aqta-gold: #c9932e;
    --aqta-cream: #f5f1eb;
    --aqta-ink: #1b2433;
    --aqta-muted: #667085;
    --aqta-header: #f3eee4;
    background: var(--aqta-cream);
    color: var(--aqta-ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  #aqta-home * { box-sizing: border-box; }
  #aqta-home img { max-width: 100%; }
  .aqta-home__wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  .aqta-home__utility { background: #0a1c33; color: #e8dfcd; font-size: 13px; }
  .aqta-home__utility-row { display: flex; min-height: 38px; align-items: center; justify-content: space-between; gap: 16px; }
  .aqta-home__utility p { margin: 0; }
  .aqta-home__header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--aqta-header);
    border-bottom: 3px solid var(--aqta-gold);
    box-shadow: 0 10px 28px rgba(15, 39, 68, .12);
  }
  .aqta-home__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    width: min(1240px, calc(100% - 48px));
    max-width: 100%;
    min-height: 74px;
    margin: 0 auto;
  }
  .aqta-home__logo { display: inline-flex; align-items: baseline; gap: 8px; color: var(--aqta-navy); text-decoration: none; }
  .aqta-home__logo span { font-family: Georgia, "Times New Roman", serif; font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1; }
  .aqta-home__logo small { color: #8a6416; font-size: 11px; font-weight: 800; letter-spacing: .18em; }
  .aqta-home__check { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  .aqta-home__burger { display: none; }
  .aqta-home__nav { display: flex; min-width: 0; align-items: center; justify-content: center; gap: 18px; }
  .aqta-home__nav > a,
  .aqta-home__drop summary,
  .aqta-home__more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #24344c;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  .aqta-home__nav > a:hover,
  .aqta-home__more summary:hover { color: var(--aqta-navy); }
  .aqta-home__more { position: relative; }
  .aqta-home__more summary::-webkit-details-marker { display: none; }
  .aqta-home__more summary::after { content: ""; width: 7px; height: 7px; margin-top: -3px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: rotate(45deg); }
  .aqta-home__more-menu {
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    z-index: 5;
    display: grid;
    width: 280px;
    padding: 8px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(8, 26, 48, .28);
  }
  .aqta-home__more-menu a { display: grid; gap: 2px; padding: 12px 14px; border-radius: 10px; color: var(--aqta-navy); text-decoration: none; }
  .aqta-home__more-menu a:hover { background: #f6f1e8; }
  .aqta-home__more-menu strong { font-size: 15px; }
  .aqta-home__more-menu span { color: var(--aqta-muted); font-size: 13px; font-weight: 500; }
  .aqta-home__tools { display: flex; align-items: center; gap: 4px; }
  .aqta-home__icon { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; color: var(--aqta-navy); }
  .aqta-home__icon svg { width: 22px; height: 22px; }
  .aqta-home__cart { position: relative; }
  .aqta-home__cart span {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 99px;
    background: var(--aqta-gold);
    color: var(--aqta-navy);
    font-size: 10px;
    font-weight: 800;
    line-height: 16px;
    text-align: center;
  }
  .aqta-home__hero { background: var(--aqta-navy); color: #fff; padding: 68px 0 86px; }
  .aqta-home__hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: 64px; align-items: center; }
  .aqta-home__eyebrow,
  .aqta-home__section-label {
    margin: 0 0 12px;
    color: var(--aqta-gold);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .aqta-home__hero-title,
  #aqta-home h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    letter-spacing: -.025em;
  }
  .aqta-home__hero-title { max-width: 680px; color: #fff; font-size: clamp(46px, 5.4vw, 72px); line-height: 1.02; }
  .aqta-home__picker { position: relative; }
  .aqta-home__rotator {
    display: inline-flex;
    gap: .16em;
    align-items: center;
    padding: 0 0 .08em;
    border: 0;
    border-bottom: 2px dotted #d7b15a;
    background: transparent;
    color: #e6c66e;
    font: inherit;
    font-style: italic;
    line-height: 1;
    cursor: pointer;
  }
  .aqta-home__rotator-arrow { width: .28em; height: .28em; }
  .aqta-home__rotator[aria-expanded="true"] .aqta-home__rotator-arrow { transform: rotate(180deg); }
  .aqta-home__menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 16px);
    left: 0;
    width: min(720px, 100%);
    max-height: min(74vh, 640px);
    padding: 26px 26px 18px;
    overflow: auto;
    border-radius: 16px;
    background: #fff;
    color: var(--aqta-ink);
    box-shadow: 0 24px 60px rgba(8, 26, 48, .28);
  }
  .aqta-home__menu[hidden] { display: none; }
  .aqta-home__menu-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #98a2b3;
    font-size: 24px;
    cursor: pointer;
  }
  .aqta-home__menu-label { margin: 0 0 12px; color: var(--aqta-gold); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .aqta-home__menu-pills,
  .aqta-home__quick-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .aqta-home__menu-pills { margin-bottom: 22px; }
  .aqta-home__menu-pills button,
  .aqta-home__quick-links button {
    padding: 8px 14px;
    border: 1px solid #e6e0d6;
    border-radius: 999px;
    background: #fff;
    color: var(--aqta-navy);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .aqta-home__quick-links { margin-bottom: 24px; }
  .aqta-home__quick-links button { border-color: rgba(255, 255, 255, .24); background: transparent; color: #e9edf4; font-weight: 600; }
  .aqta-home__quick-links button[aria-current="true"],
  .aqta-home__menu-pills button:hover,
  .aqta-home__quick-links button:hover { border-color: var(--aqta-gold); background: rgba(201, 147, 46, .16); color: #fff; }
  .aqta-home__menu-pills button:hover { color: var(--aqta-navy); background: #f6f1e8; }
  .aqta-home__menu-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .aqta-home__menu-cols p { margin: 0 0 8px; color: #98a2b3; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .aqta-home__menu-cols a { display: block; margin-top: 8px; color: var(--aqta-navy); font-size: 16px; text-decoration: none; }
