{% javascript %}
  (() => {
    const root = document.querySelector('[data-aqta-home]');
    if (!root || root.dataset.aqtaReady === 'true') return;
    root.dataset.aqtaReady = 'true';
    const menuToggle = root.querySelector('.aqta-home__check');
    root.querySelectorAll('.aqta-home__nav a').forEach((link) => {
      link.addEventListener('click', () => {
        if (menuToggle) menuToggle.checked = false;
      });
    });
    const label = root.querySelector('[data-aqta-rotator-label]');
    const toggle = root.querySelector('[data-aqta-rotator]');
    const menu = root.querySelector('[data-aqta-menu]');
    const cardWord = root.querySelector('[data-aqta-card-word]');
    const picks = Array.from(root.querySelectorAll('[data-aqta-pick]'));
    const slides = Array.from(root.querySelectorAll('[data-aqta-slide]'));
    if (!label || picks.length === 0) return;

    const words = [];
    picks.forEach((pick) => {
      const word = pick.getAttribute('data-aqta-pick');
      if (word && words.indexOf(word) === -1) words.push(word);
    });
    let index = 0;
    let paused = false;
    let menuOpen = false;

    const show = (next) => {
      index = next;
      const word = words[index];
      label.textContent = word;
      if (cardWord) cardWord.textContent = word;
      picks.forEach((pick) => {
        if (pick.getAttribute('data-aqta-pick') === word) {
          pick.setAttribute('aria-current', 'true');
        } else {
          pick.removeAttribute('aria-current');
        }
      });
      slides.forEach((slide) => {
        slide.setAttribute('data-active', slide.getAttribute('data-aqta-slide') === word ? 'true' : 'false');
      });
    };

    const setMenu = (open) => {
      menuOpen = open;
      paused = open;
      if (!menu || !toggle) return;
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    if (toggle && menu) {
      toggle.addEventListener('click', () => setMenu(!menuOpen));
      const close = root.querySelector('[data-aqta-menu-close]');
      if (close) close.addEventListener('click', () => setMenu(false));
      document.addEventListener('click', (event) => {
        const picker = root.querySelector('.aqta-home__picker');
        if (menuOpen && picker && !picker.contains(event.target)) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuOpen) setMenu(false);
      });
    }

    picks.forEach((pick) => {
      pick.addEventListener('click', () => {
        const word = pick.getAttribute('data-aqta-pick');
        const next = words.indexOf(word);
        if (next >= 0) show(next);
        paused = true;
      });
      pick.addEventListener('mouseenter', () => {
        const next = words.indexOf(pick.getAttribute('data-aqta-pick'));
        if (next >= 0) show(next);
        paused = true;
      });
      pick.addEventListener('mouseleave', () => {
        if (!menuOpen) paused = false;
      });
    });

    if (words.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    window.setInterval(() => {
      if (!paused) show((index + 1) % words.length);
    }, 2800);
  })();
{% endjavascript %}

