{% render 'aqta-header', section_id: section.id, current: 'bulk' %}

<section class="aqta-bulk" id="aqta-bulk-page">
  <header class="aqta-bulk__hero">
    <div class="aqta-bulk__wrap aqta-bulk__hero-grid">
      <div class="aqta-bulk__hero-copy">
        <p class="aqta-bulk__eyebrow">Bulk orders</p>
        <h1>A list of names, <em>one award at a time.</em></h1>
        <p class="aqta-bulk__lead">Paste the roster in the designer. Medals, trophies, and plaques each keep their own wording, and the look stays the same across the set.</p>
      </div>
      <nav class="aqta-bulk__jumps" aria-label="Design tools">
        <a href="#bulk-medals">
          <span class="aqta-bulk__jump-photo">
            <img src="{{ 'aqta-medal-gold.png' | asset_url }}" alt="" width="900" height="900">
          </span>
          <span class="aqta-bulk__jump-copy">
            <strong>Medals</strong>
            <small>Paste a roster, one medal per line</small>
          </span>
          <span class="aqta-bulk__jump-go" aria-hidden="true">→</span>
        </a>
        <a href="#bulk-trophies">
          <span class="aqta-bulk__jump-photo">
            <img src="{{ 'aqta-victory-trophy.jpg' | asset_url }}" alt="" width="800" height="1000">
          </span>
          <span class="aqta-bulk__jump-copy">
            <strong>Trophies</strong>
            <small>One design, a plate for every name</small>
          </span>
          <span class="aqta-bulk__jump-go" aria-hidden="true">→</span>
        </a>
        <a href="#bulk-plaques">
          <span class="aqta-bulk__jump-photo">
            <img src="{{ 'aqta-plaque-honor.jpg' | asset_url }}" alt="" width="900" height="900">
          </span>
          <span class="aqta-bulk__jump-copy">
            <strong>Plaques</strong>
            <small>One row for each plaque in the set</small>
          </span>
          <span class="aqta-bulk__jump-go" aria-hidden="true">→</span>
        </a>
      </nav>
    </div>
  </header>

  <article class="aqta-bulk__tool" id="bulk-medals">
    <div class="aqta-bulk__wrap aqta-bulk__tool-grid">
      <div>
        <p class="aqta-bulk__eyebrow">Medals</p>
        <h2>Open Bulk Order on the design step.</h2>
        <ol>
          <li>Choose the medal, then open Bulk Order.</li>
          <li>Paste one medal per line. A bar separates the lines of text on that medal.</li>
          <li>Open View all and check every name before you continue.</li>
        </ol>
        <a class="aqta-bulk__button" href="/products/custom-medal">Design medals <span aria-hidden="true">→</span></a>
      </div>
      <figure class="aqta-bulk__frame">
        <img
          src="{{ 'aqta-bulk-medal.jpg' | asset_url }}"
          alt="Medal designer View all grid of four personalized medals beside a live preview"
          width="1244"
          height="820"
        >
      </figure>
    </div>
  </article>

  <article class="aqta-bulk__tool aqta-bulk__tool--cream" id="bulk-trophies">
    <div class="aqta-bulk__wrap aqta-bulk__tool-grid">
      <div>
        <p class="aqta-bulk__eyebrow">Trophies</p>
        <h2>Bulk Order applies one design to every trophy.</h2>
        <ol>
          <li>Choose the trophy and the plate, then open Bulk Order.</li>
          <li>Paste one trophy per line. The award, plate, and formatting stay shared.</li>
          <li>View all shows every plate. Select one to preview that trophy.</li>
        </ol>
        <a class="aqta-bulk__button" href="/products/custom-trophy">Design trophies <span aria-hidden="true">→</span></a>
      </div>
      <figure class="aqta-bulk__frame">
        <img
          src="{{ 'aqta-bulk-trophy.jpg' | asset_url }}"
          alt="Trophy designer View all grid of four engraved plates beside a live trophy preview"
          width="1244"
          height="860"
        >
      </figure>
    </div>
  </article>

  <article class="aqta-bulk__tool" id="bulk-plaques">
    <div class="aqta-bulk__wrap aqta-bulk__tool-grid">
      <div>
        <p class="aqta-bulk__eyebrow">Plaques</p>
        <h2>Add Multiple Plaques, one row per plaque.</h2>
        <ol>
          <li>Open Add Multiple Plaques from the designer toolbar.</li>
          <li>Paste one plaque per line, with a comma between its lines of text.</li>
          <li>The preview lists every plaque. Add them, then open View all to check the set.</li>
        </ol>
        <a class="aqta-bulk__button" href="/products/custom-plaque">Design plaques <span aria-hidden="true">→</span></a>
      </div>
      <figure class="aqta-bulk__frame">
        <img
          src="{{ 'aqta-bulk-plaque.jpg' | asset_url }}"
          alt="Add or Create Multiple Plaques window with a pasted roster and a four-row preview"
          width="560"
          height="725"
        >
      </figure>
    </div>
  </article>
</section>

{% stylesheet %}
  body:has(#aqta-bulk-page) > header { display: none; }
  .aqta-bulk {
    --aqta-navy: #0f2744;
    --aqta-gold: #c9932e;
    --aqta-cream: #f7f4ee;
    --aqta-ink: #1b2433;
    --aqta-muted: #667085;
    background: #fff;
    color: var(--aqta-ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .aqta-bulk * { box-sizing: border-box; }
  .aqta-bulk__wrap { width: min(1120px, calc(100% - 48px)); margin: 0 auto; }
  .aqta-bulk__hero { background: var(--aqta-navy); color: #fff; padding: 64px 0 56px; }
  .aqta-bulk__hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr); gap: 48px; align-items: center; }
  .aqta-bulk__hero-copy { max-width: 640px; }
  .aqta-bulk__eyebrow { margin: 0 0 12px; color: var(--aqta-gold); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .aqta-bulk h1,
  .aqta-bulk h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-weight: 500; letter-spacing: -.025em; }
  .aqta-bulk h1 { font-size: clamp(40px, 5vw, 64px); line-height: 1.05; }
  .aqta-bulk h1 em { color: #e6c66e; font-style: italic; }
  .aqta-bulk h2 { color: var(--aqta-navy); font-size: clamp(32px, 4vw, 44px); line-height: 1.12; }
  .aqta-bulk__lead { max-width: 620px; margin: 18px 0 0; color: #d7dfeb; font-size: 17px; line-height: 1.6; }
  .aqta-bulk__jumps { display: grid; gap: 12px; }
  .aqta-bulk__jumps a {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 10px 16px 10px 10px;
    border-radius: 16px;
    background: #fff;
    color: var(--aqta-navy);
    text-decoration: none;
    box-shadow: 0 16px 36px rgba(0, 0, 0, .22);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .aqta-bulk__jumps a:hover { transform: translateY(-2px); box-shadow: 0 20px 40px rgba(0, 0, 0, .28); color: var(--aqta-navy); }
  .aqta-bulk__jump-photo {
    display: grid;
    height: 88px;
    place-items: center;
    overflow: hidden;
    border-radius: 12px;
    background: var(--aqta-cream);
  }
  .aqta-bulk__jump-photo img { width: 100%; height: 100%; object-fit: contain; }
  .aqta-bulk__jump-copy { display: grid; gap: 3px; min-width: 0; }
  .aqta-bulk__jump-copy strong { font-family: Georgia, "Times New Roman", serif; font-size: 22px; font-weight: 500; letter-spacing: -.02em; }
  .aqta-bulk__jump-copy small { color: var(--aqta-muted); font-size: 13px; line-height: 1.35; }
  .aqta-bulk__jump-go {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: #f6efe2;
    color: #9a6d12;
    font-size: 18px;
    font-weight: 800;
  }
  .aqta-bulk__jumps a:hover .aqta-bulk__jump-go { background: var(--aqta-gold); color: var(--aqta-navy); }
  .aqta-bulk__tool { padding: 72px 0; background: #fff; }
  .aqta-bulk__tool--cream { background: var(--aqta-cream); }
  .aqta-bulk__tool-grid { display: grid; grid-template-columns: minmax(0, .82fr) minmax(320px, 1.18fr); gap: 40px; align-items: center; }
  .aqta-bulk__tool ol { display: grid; margin: 22px 0 28px; padding: 0; gap: 14px; list-style: none; counter-reset: aqta-step; }
  .aqta-bulk__tool li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 12px; align-items: start; color: var(--aqta-ink); font-size: 16px; line-height: 1.5; }
  .aqta-bulk__tool li::before {
    counter-increment: aqta-step;
    content: counter(aqta-step);
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border-radius: 50%;
    background: var(--aqta-navy);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }
  .aqta-bulk__button {
    display: inline-flex;
    min-height: 50px;
    padding: 0 22px;
    align-items: center;
    border-radius: 7px;
    background: var(--aqta-navy);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }
  .aqta-bulk__button:hover { background: #18375f; color: #fff; }
  .aqta-bulk__frame {
    margin: 0;
    overflow: hidden;
    border: 1px solid #e6dfd4;
    border-radius: 16px;
    background: var(--aqta-cream);
  }
  .aqta-bulk__frame img { display: block; width: 100%; height: auto; }
  #bulk-medals,
  #bulk-trophies,
  #bulk-plaques { scroll-margin-top: 96px; }
  @media (max-width: 860px) {
    .aqta-bulk__wrap { width: min(100% - 28px, 1120px); }
    .aqta-bulk__hero { padding: 40px 0 36px; }
    .aqta-bulk__hero-grid,
    .aqta-bulk__tool-grid { grid-template-columns: 1fr; gap: 28px; }
    .aqta-bulk__tool { padding: 48px 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bulk orders",
  "settings": [],
  "presets": [
    { "name": "Bulk orders" }
  ]
}
{% endschema %}
