{%- liquid
  assign kind = page.handle
  if kind != 'trophies' and kind != 'medals' and kind != 'plaques' and kind != 'occasions'
    assign kind = 'occasions'
  endif
-%}

<section class="aqta-guide" id="aqta-guide" data-aqta-guide>
  {% render 'aqta-header', section_id: section.id, current: kind %}

  {%- if kind == 'occasions' -%}
    <div class="aqta-guide__hero">
      <div class="aqta-guide__wrap">
        <p class="aqta-guide__eyebrow">Shop by occasion</p>
        <h1>Awards for the day they earn it.</h1>
        <p class="aqta-guide__lead">Pick the event. Each list shows the trophies and medals in the store for that day. Plaque styles open the custom plaque designer.</p>
      </div>
    </div>

    <div class="aqta-guide__wrap aqta-guide__body">
      <div class="aqta-guide__picker">
        <a href="#sports" data-aqta-occasion="sports">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-medal-soccer.png' | asset_url }}" alt="" width="900" height="900"></span>
          <span class="aqta-guide__pick-copy"><strong>Sports &amp; teams</strong><span>Season trophies and finish medals</span></span>
        </a>
        <a href="#schools" data-aqta-occasion="schools">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-plaque-graduation.jpg' | asset_url }}" alt="" width="900" height="900"></span>
          <span class="aqta-guide__pick-copy"><strong>Schools</strong><span>Honor roll, sports, and graduation</span></span>
        </a>
        <a href="#companies" data-aqta-occasion="companies">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-plaque-employee.jpg' | asset_url }}" alt="" width="900" height="900"></span>
          <span class="aqta-guide__pick-copy"><strong>Companies</strong><span>Employee and sales recognition</span></span>
        </a>
        <a href="#churches" data-aqta-occasion="churches">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-plaque-service.jpg' | asset_url }}" alt="" width="900" height="900"></span>
          <span class="aqta-guide__pick-copy"><strong>Churches</strong><span>Service and volunteer awards</span></span>
        </a>
        <a href="#youth" data-aqta-occasion="youth">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-medal-swim.png' | asset_url }}" alt="" width="900" height="900"></span>
          <span class="aqta-guide__pick-copy"><strong>Youth leagues</strong><span>A matching award for every player</span></span>
        </a>
        <a href="#banquets" data-aqta-occasion="banquets">
          <span class="aqta-guide__pick-image"><img src="{{ 'aqta-team-trophy.jpg' | asset_url }}" alt="" width="800" height="800"></span>
          <span class="aqta-guide__pick-copy"><strong>Banquets</strong><span>Sets for the whole roster</span></span>
        </a>
      </div>

      <div class="aqta-guide__toolbar">
        <h2>All occasions</h2>
        <button type="button" data-aqta-show-all>Show all occasions</button>
      </div>

      <div class="aqta-guide__panel" id="sports" data-aqta-panel="sports">
        <p class="aqta-guide__eyebrow">Sports &amp; teams</p>
        <h2>For the season and the championship.</h2>
        <p class="aqta-guide__panel-lead">Finish medals for every place, and trophies for the players you want standing out.</p>
        {% render 'aqta-occasion-catalog', occasion: 'sports' %}
      </div>

      <div class="aqta-guide__panel" id="schools" data-aqta-panel="schools">
        <p class="aqta-guide__eyebrow">Schools</p>
        <h2>Honor roll, sports, and graduation.</h2>
        <p class="aqta-guide__panel-lead">Academic medals, honor trophies, and plaques that can hang in a classroom or go home.</p>
        {% render 'aqta-occasion-catalog', occasion: 'schools' %}
      </div>

      <div class="aqta-guide__panel" id="companies" data-aqta-panel="companies">
        <p class="aqta-guide__eyebrow">Companies</p>
        <h2>Recognition that belongs on a desk.</h2>
        <p class="aqta-guide__panel-lead">Employee, sales, and service awards with a plate you can read from across the room.</p>
        {% render 'aqta-occasion-catalog', occasion: 'companies' %}
      </div>

      <div class="aqta-guide__panel" id="churches" data-aqta-panel="churches">
        <p class="aqta-guide__eyebrow">Churches</p>
        <h2>Service, volunteers, and years given.</h2>
        <p class="aqta-guide__panel-lead">Plaques for the names you want remembered, and a simple trophy when the moment calls for one.</p>
        {% render 'aqta-occasion-catalog', occasion: 'churches' %}
      </div>

      <div class="aqta-guide__panel" id="youth" data-aqta-panel="youth">
        <p class="aqta-guide__eyebrow">Youth leagues</p>
        <h2>One award for every player.</h2>
        <p class="aqta-guide__panel-lead">Matching medals for the roster, with a trophy for the players you want to single out.</p>
        {% render 'aqta-occasion-catalog', occasion: 'youth' %}
      </div>

      <div class="aqta-guide__panel" id="banquets" data-aqta-panel="banquets">
        <p class="aqta-guide__eyebrow">Banquets</p>
        <h2>A matching set for the whole room.</h2>
        <p class="aqta-guide__panel-lead">Same design, a different name on each award. Quote the set when you know the roster.</p>
        {% render 'aqta-occasion-catalog', occasion: 'banquets' %}
        <p class="aqta-guide__panel-action"><a href="/pages/bulk-orders">Request a bulk quote →</a></p>
      </div>
    </div>
  {%- else -%}
    <div class="aqta-guide__hero">
      <div class="aqta-guide__wrap aqta-guide__hero-grid">
        <div>
          {%- if kind == 'trophies' -%}
            <p class="aqta-guide__eyebrow">Trophies</p>
            <h1>Choose the trophy, then add the name.</h1>
            <p class="aqta-guide__lead">Every trophy below opens its product page. Design a custom trophy when you want to choose the figure, the plate, and the engraving.</p>
          {%- elsif kind == 'medals' -%}
            <p class="aqta-guide__eyebrow">Medals</p>
            <h1>A medal for every place on the roster.</h1>
            <p class="aqta-guide__lead">Pick a sport, a school event, or a set. Personalized medals open the custom medal designer, where you choose the center artwork and preview your wording.</p>
          {%- else -%}
            <p class="aqta-guide__eyebrow">Plaques</p>
            <h1>See the whole plaque before it is made.</h1>
            <p class="aqta-guide__lead">Each plaque style opens the custom plaque designer. Choose the layout, add the name, and review the finished award before you order.</p>
          {%- endif -%}
          <ol class="aqta-guide__steps">
            <li>Choose the award</li>
            <li>Open the product and pick the options</li>
            <li>Order one, or a name for every winner</li>
          </ol>
          <div class="aqta-guide__actions">
            {%- if kind == 'trophies' -%}
              <a class="aqta-guide__button" href="/products/custom-trophy">Design a trophy</a>
            {%- elsif kind == 'medals' -%}
              <a class="aqta-guide__button" href="/products/custom-medal">Design a medal</a>
            {%- else -%}
              <a class="aqta-guide__button" href="/products/custom-plaque">Design a plaque</a>
            {%- endif -%}
            <a class="aqta-guide__button aqta-guide__button--ghost" href="#aqta-styles">See the styles</a>
          </div>
        </div>
        <figure class="aqta-guide__designer">
          {%- if kind == 'trophies' -%}
            <img src="{{ 'aqta-trophy-designer.jpg' | asset_url }}" alt="Trophy designer showing a live engraving plate for a varsity soccer championship" width="1200" height="750">
            <figcaption>Open Design a trophy to choose the figure and write the plate.</figcaption>
          {%- elsif kind == 'plaques' -%}
            <img src="{{ 'aqta-plaque-designer.jpg' | asset_url }}" alt="Plaque designer showing a full wooden award with the name and service line" width="1200" height="800">
            <figcaption>Open Design a plaque to add the name and review the award.</figcaption>
          {%- else -%}
            <img src="{{ 'aqta-medal-set.png' | asset_url }}" alt="Gold, silver, and bronze victory medals with place ribbons" width="900" height="900">
            <figcaption>Gold, silver, and bronze are options on each medal.</figcaption>
          {%- endif -%}
        </figure>
      </div>
    </div>

    <div class="aqta-guide__wrap aqta-guide__body" id="aqta-styles">
      <div class="aqta-catalog" data-aqta-catalog data-kind="{{ kind }}">
        <div class="aqta-catalog__side">
          <div class="aqta-guide__toolbar">
            {%- if kind == 'trophies' -%}
              <h2>Trophy styles</h2>
              <p>Sports figures, cups, school awards, and workplace recognition.</p>
            {%- elsif kind == 'medals' -%}
              <h2>Medal styles</h2>
              <p>Sports, school, events, personalized medals, and place sets.</p>
            {%- else -%}
              <h2>Plaque styles</h2>
              <p>Each style opens the custom plaque designer.</p>
            {%- endif -%}
          </div>
          {% render 'aqta-catalog-filters', kind: kind %}
        </div>
        <div data-aqta-catalog-results>
          {%- if kind == 'trophies' -%}
            {% render 'aqta-trophy-catalog' %}
          {%- elsif kind == 'medals' -%}
            {% render 'aqta-medal-catalog' %}
          {%- else -%}
            <div class="aqta-guide__grid">
              {% render 'aqta-style-card', image: 'aqta-plaque-boss.jpg', title: 'Boss award', note: 'Wood plaque and easel', url: '/products/custom-plaque' %}
              {% render 'aqta-style-card', image: 'aqta-plaque-honor.jpg', title: 'Honor roll', note: 'Full board, not a crop', url: '/products/custom-plaque' %}
              {% render 'aqta-style-card', image: 'aqta-plaque-employee.jpg', title: 'Employee of the month', note: 'Black frame and easel', url: '/products/custom-plaque' %}
              {% render 'aqta-style-card', image: 'aqta-plaque-service.jpg', title: 'Service award', note: 'Patriotic plate', url: '/products/custom-plaque' %}
              {% render 'aqta-style-card', image: 'aqta-plaque-graduation.jpg', title: 'Graduation', note: 'Cap emblem and easel', url: '/products/custom-plaque' %}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="aqta-guide__more">
        <h2>Also for this award</h2>
        <div class="aqta-guide__more-row">
          {%- if kind != 'trophies' -%}<a href="/pages/trophies">Trophies</a>{%- endif -%}
          {%- if kind != 'medals' -%}<a href="/pages/medals">Medals</a>{%- endif -%}
          {%- if kind != 'plaques' -%}<a href="/pages/plaques">Plaques</a>{%- endif -%}
          <a href="/pages/occasions">Occasions</a>
          <a href="/pages/bulk-orders">Bulk orders</a>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .aqta-guide {
    --aqta-navy: #0f2744;
    --aqta-gold: #c9932e;
    --aqta-cream: #f5f1eb;
    --aqta-ink: #1b2433;
    --aqta-muted: #667085;
    overflow-x: clip;
    background: var(--aqta-cream);
    color: var(--aqta-ink);
    font-family: Arial, Helvetica, sans-serif;
  }
  .aqta-guide * { box-sizing: border-box; }
  .aqta-guide img { max-width: 100%; }
  .aqta-guide__wrap { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
  .aqta-guide__hero { padding: 48px 0 36px; background: var(--aqta-navy); color: #fff; }
  .aqta-guide__hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .aqta-guide__eyebrow { margin: 0 0 10px; color: var(--aqta-gold); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .aqta-guide h1,
  .aqta-guide h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-weight: 500; letter-spacing: -.025em; line-height: 1.08; }
  .aqta-guide h1 { max-width: 640px; font-size: clamp(36px, 5vw, 58px); }
  .aqta-guide h2 { color: var(--aqta-navy); font-size: clamp(28px, 4vw, 42px); }
  .aqta-guide__lead,
  .aqta-guide__panel-lead { max-width: 640px; margin: 14px 0 0; font-size: 17px; line-height: 1.6; }
  .aqta-guide__lead { color: #d7dfeb; }
  .aqta-guide__panel-lead { color: var(--aqta-muted); }
  .aqta-guide__steps { display: grid; margin: 22px 0 0; padding: 0; gap: 8px; list-style: none; counter-reset: aqta-step; }
  .aqta-guide__steps li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: center; }
  .aqta-guide__steps li::before { counter-increment: aqta-step; content: counter(aqta-step); display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: var(--aqta-gold); color: var(--aqta-navy); font-size: 13px; font-weight: 800; }
  .aqta-guide__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .aqta-guide__button { display: inline-flex; min-height: 48px; padding: 0 18px; align-items: center; border-radius: 7px; background: var(--aqta-gold); color: var(--aqta-navy); font-size: 14px; font-weight: 800; text-decoration: none; }
  .aqta-guide__button--ghost { border: 1px solid rgba(255, 255, 255, .35); background: transparent; color: #fff; }
  .aqta-guide__designer { min-width: 0; margin: 0; overflow: hidden; border-radius: 14px; background: #fff; }
  .aqta-guide__designer img { display: block; width: 100%; height: 360px; object-fit: contain; object-position: center top; background: #f7f4ee; }
  .aqta-guide__designer figcaption { padding: 12px 14px 14px; color: var(--aqta-navy); font-size: 13px; font-weight: 800; }
  .aqta-guide__body { padding: 32px 0 72px; }
  .aqta-guide__picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .aqta-guide__picker a { display: flex; min-width: 0; overflow: hidden; flex-direction: column; border: 1px solid #e4ddd1; border-radius: 12px; background: #fff; color: inherit; text-decoration: none; }
  .aqta-guide__picker a:hover,
  .aqta-guide__picker a.is-current { border-color: var(--aqta-gold); box-shadow: 0 12px 28px rgba(15, 39, 68, .1); }
  .aqta-guide__pick-image { display: flex; height: 140px; align-items: center; justify-content: center; background: #f7f4ee; }
  .aqta-guide__pick-image img { width: 100%; height: 100%; object-fit: contain; }
  .aqta-guide__pick-copy { display: grid; gap: 4px; padding: 14px; }
  .aqta-guide__pick-copy strong { color: var(--aqta-navy); font-size: 16px; }
  .aqta-guide__pick-copy span { color: var(--aqta-muted); font-size: 13px; line-height: 1.4; }
  .aqta-guide__toolbar { display: flex; margin: 28px 0 16px; align-items: end; justify-content: space-between; gap: 16px; }
  .aqta-guide__toolbar p { margin: 0; color: var(--aqta-muted); font-size: 14px; }
  .aqta-guide__toolbar button { display: none; min-height: 44px; padding: 0 16px; border: 1px solid #e4ddd1; border-radius: 8px; background: #fff; color: var(--aqta-navy); font-size: 14px; font-weight: 800; cursor: pointer; }
  .aqta-guide.has-selection .aqta-guide__toolbar button { display: inline-flex; align-items: center; }
  .aqta-guide.has-selection .aqta-guide__toolbar h2 { display: none; }
  .aqta-guide__panel { margin-top: 8px; padding-top: 22px; border-top: 1px solid #e4ddd1; scroll-margin-top: 110px; }
  .aqta-guide.has-selection .aqta-guide__panel { display: none; }
  .aqta-guide.has-selection .aqta-guide__panel.is-active { display: block; border-top: 0; }
  .aqta-guide__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 18px; }
  .aqta-catalog { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 36px; align-items: start; }
  .aqta-catalog__side .aqta-guide__toolbar { display: block; margin: 0 0 22px; }
  .aqta-catalog__side .aqta-guide__toolbar h2 { font-size: 32px; }
  .aqta-catalog__side .aqta-guide__toolbar p { margin-top: 8px; }
  .aqta-filters { position: sticky; top: 108px; margin: 0; padding: 0; }
  .aqta-filters__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .aqta-filters__head .aqta-filters__title { flex: 1; }
  .aqta-filters__head button { margin-top: 1px; padding: 0; border: 0; background: transparent; color: #9a6c17; font-size: 13px; font-weight: 600; white-space: nowrap; cursor: pointer; }
  .aqta-filters__group { margin-top: 28px; }
  .aqta-filters__title { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin: 0 0 4px; padding: 0 0 9px; border-bottom: 1px solid #e6e6e6; color: var(--aqta-navy); font-size: 14px; font-weight: 700; letter-spacing: .05em; line-height: 1.2; text-transform: uppercase; }
  .aqta-filters__title span { color: var(--aqta-muted); font-size: 12px; font-weight: 600; letter-spacing: 0; text-transform: none; }
  .aqta-filters__search input { width: 100%; min-height: 40px; margin-top: 8px; padding: 8px 0; border: 0; border-bottom: 1px solid #e6e6e6; border-radius: 0; background: transparent; color: var(--aqta-ink); font: inherit; font-size: 14px; }
  .aqta-filters__search input:focus { border-color: var(--aqta-gold); outline: none; }
  .aqta-filters__list { display: grid; }
  .aqta-filters__list button { padding: 7px 0 6px; border: 0; background: transparent; color: var(--aqta-navy); font: inherit; font-size: 14px; font-weight: 500; line-height: 1.35; text-align: left; cursor: pointer; }
  .aqta-filters__list button:hover,
  .aqta-filters__list button[aria-pressed="true"] { color: #9a6c17; }
  .aqta-filters__list button[aria-pressed="true"] { font-weight: 700; }
  .aqta-catalog .aqta-guide__grid { margin-top: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .aqta-catalog .aqta-guide__group-title { margin: 0 0 14px; }
  .aqta-filters__empty { margin: 18px 0 0; color: var(--aqta-muted); font-size: 14px; }
  .aqta-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .aqta-guide__group + .aqta-guide__group { margin-top: 34px; }
  .aqta-guide__group[hidden],
  .aqta-guide__card[hidden] { display: none; }
  .aqta-guide__group-title { margin: 0; color: var(--aqta-navy); font-family: Georgia, "Times New Roman", serif; font-size: clamp(24px, 3vw, 32px); font-weight: 500; }
  .aqta-guide__card { display: flex; min-width: 0; overflow: hidden; flex-direction: column; border: 1px solid #e4ddd1; border-radius: 12px; background: #fff; }
  a.aqta-guide__card { color: inherit; text-decoration: none; }
  a.aqta-guide__card:hover { border-color: var(--aqta-gold); box-shadow: 0 12px 28px rgba(15, 39, 68, .1); }
  .aqta-guide__card-image { display: flex; height: 180px; align-items: center; justify-content: center; background: #f7f4ee; }
  .aqta-guide__card-image img { width: 100%; height: 100%; object-fit: contain; }
  .aqta-guide__card-copy { display: grid; gap: 4px; padding: 14px 16px 16px; }
  .aqta-guide__card-copy strong { color: var(--aqta-navy); font-size: 15px; line-height: 1.35; }
  .aqta-guide__card-copy small { color: var(--aqta-gold); font-size: 13px; font-weight: 800; }
  .aqta-guide__panel-action { margin: 18px 0 0; }
  .aqta-guide__panel-action a,
  .aqta-guide__more-row a { color: var(--aqta-gold); font-size: 14px; font-weight: 800; text-decoration: none; }
  .aqta-guide__more { margin-top: 36px; }
  .aqta-guide__more-row { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 12px; }
  #aqta-styles { scroll-margin-top: 110px; }
  @media (max-width: 990px) {
    .aqta-guide__hero-grid,
    .aqta-guide__picker,
    .aqta-guide__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aqta-guide__hero-grid { grid-template-columns: 1fr; }
    .aqta-guide__designer img { height: 280px; }
    .aqta-catalog { grid-template-columns: 1fr; }
    .aqta-catalog .aqta-guide__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aqta-filters { position: static; }
  }
  @media (max-width: 640px) {
    .aqta-guide__wrap { width: min(100% - 28px, 1180px); }
    .aqta-guide__picker,
    .aqta-guide__grid,
    .aqta-catalog .aqta-guide__grid { grid-template-columns: 1fr; }
    .aqta-guide__hero { padding: 32px 0 28px; }
    .aqta-guide__toolbar { align-items: start; flex-direction: column; }
    .aqta-filters__head { align-items: flex-start; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const root = document.querySelector('[data-aqta-guide]');
    if (!root || root.dataset.aqtaGuideReady === 'true') return;
    root.dataset.aqtaGuideReady = 'true';

    const catalog = root.querySelector('[data-aqta-catalog]');
    if (catalog) {
      const kind = catalog.dataset.kind;
      const cards = Array.from(catalog.querySelectorAll('[data-aqta-card]'));
      const filters = Array.from(catalog.querySelectorAll('[data-aqta-filter]'));
      const search = catalog.querySelector('[data-aqta-filter-search]');
      const sort = catalog.querySelector('[data-aqta-sort]');
      const clear = catalog.querySelector('[data-aqta-filter-clear]');
      const count = catalog.querySelector('[data-aqta-filter-count]');
      const empty = catalog.querySelector('[data-aqta-filter-empty]');
      const groups = Array.from(catalog.querySelectorAll('.aqta-guide__group'));
      const grids = Array.from(catalog.querySelectorAll('.aqta-guide__grid'));

      const includesAny = (text, words) => words.some((word) => text.includes(word));
      const industryFor = (card) => {
        const group = card.closest('.aqta-guide__group');
        const category = group ? group.querySelector('.aqta-guide__group-title').textContent.trim().toLowerCase() : '';
        const text = `${card.dataset.title || ''} ${card.dataset.note || ''}`;
        if (category === 'sports') return 'sports';
        if (category === 'school') return 'school';
        if (category === 'workplace') return 'workplace';
        if (category === 'community') return 'community';
        if (category === 'events' || category === 'cups') return 'events';
        if (includesAny(text, ['soccer', 'baseball', 'softball', 'basketball', 'football', 'tennis', 'golf', 'bowling', 'swimming', 'track', 'running', '5k', '10k', 'boxing', 'weightlifting', 'pickleball', 'cornhole', 'water polo', 'team player', 'coach'])) return 'sports';
        if (includesAny(text, ['school', 'student', 'academic', 'spelling', 'honor roll', 'graduation', 'attendance', 'principal', 'music'])) return 'school';
        if (includesAny(text, ['employee', 'sales', 'boss', 'workplace'])) return 'workplace';
        if (includesAny(text, ['service', 'volunteer', 'deacon', 'church', 'community'])) return 'community';
        if (includesAny(text, ['bake', 'bbq', 'chili', 'competition', 'place', 'champion', 'winner', 'runner-up'])) return 'events';
        return 'general';
      };
      const styleFor = (card) => {
        const group = card.closest('.aqta-guide__group');
        const category = group ? group.querySelector('.aqta-guide__group-title').textContent.trim().toLowerCase() : '';
        const text = `${card.dataset.title || ''} ${card.dataset.note || ''}`;
        if (kind === 'trophies') {
          if (category === 'cups' || text.includes('cup')) return 'cup';
          if (text.includes('star')) return 'star';
          if (industryFor(card) === 'sports') return 'sports-figure';
          return 'figure';
        }
        if (kind === 'medals') {
          if (category === 'sets' || text.includes('set')) return 'set';
          if (category === 'personalized' || text.includes('personalized')) return 'personalized';
          if (text.includes('wreath')) return 'wreath';
          if (text.includes('star')) return 'stars';
          return '';
        }
        if (text.includes('black')) return 'black-frame';
        if (text.includes('patriotic')) return 'patriotic';
        if (text.includes('wood')) return 'wood';
        return '';
      };

      cards.forEach((card, index) => {
        card.dataset.originalIndex = index;
        card.dataset.industry = industryFor(card);
        card.dataset.style = styleFor(card);
      });

      const choice = (group) => {
        const current = group && group.querySelector('[aria-pressed="true"]');
        return current ? current.dataset.value || '' : '';
      };
      const choose = (group, value) => {
        if (!group) return;
        const buttons = Array.from(group.querySelectorAll('[data-value]'));
        const match = buttons.find((button) => button.dataset.value === value) || buttons[0];
        buttons.forEach((button) => button.setAttribute('aria-pressed', button === match ? 'true' : 'false'));
      };

      const update = () => {
        const query = (search ? search.value : '').trim().toLowerCase();
        const active = {};
        filters.forEach((filter) => { active[filter.dataset.aqtaFilter] = choice(filter); });
        let visible = 0;
        cards.forEach((card) => {
          const titleMatch = !query || (card.dataset.title || '').includes(query);
          const industryMatch = !active.industry || card.dataset.industry === active.industry;
          const styleMatch = !active.style || card.dataset.style === active.style;
          const show = titleMatch && industryMatch && styleMatch;
          card.hidden = !show;
          if (show) visible += 1;
        });
        groups.forEach((group) => {
          group.hidden = !group.querySelector('[data-aqta-card]:not([hidden])');
        });
        const hasFilters = Boolean(query || filters.some((filter) => choice(filter)));
        if (clear) clear.hidden = !hasFilters;
        if (count) count.textContent = `${visible} ${visible === 1 ? 'result' : 'results'}`;
        if (empty) empty.hidden = visible !== 0;
      };

      const sortCards = () => {
        const mode = sort ? choice(sort) || 'featured' : 'featured';
        grids.forEach((grid) => {
          const gridCards = Array.from(grid.querySelectorAll(':scope > [data-aqta-card]'));
          gridCards.sort((a, b) => {
            if (mode === 'title-asc') return a.dataset.title.localeCompare(b.dataset.title);
            if (mode === 'title-desc') return b.dataset.title.localeCompare(a.dataset.title);
            if (mode === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
            if (mode === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
            return Number(a.dataset.originalIndex) - Number(b.dataset.originalIndex);
          });
          gridCards.forEach((card) => grid.appendChild(card));
        });
        update();
      };

      catalog.addEventListener('click', (event) => {
        const button = event.target.closest('[data-value]');
        if (!button) return;
        const group = button.closest('[data-aqta-filter], [data-aqta-sort]');
        if (!group) return;
        choose(group, button.dataset.value);
        if (group.hasAttribute('data-aqta-sort')) sortCards();
        else update();
      });
      if (search) search.addEventListener('input', update);
      if (clear) {
        clear.addEventListener('click', () => {
          if (search) search.value = '';
          filters.forEach((filter) => choose(filter, ''));
          if (sort) choose(sort, 'featured');
          sortCards();
        });
      }
      const params = new URLSearchParams(window.location.search);
      if (search && params.get('q')) search.value = params.get('q');
      filters.forEach((filter) => {
        const value = params.get(filter.dataset.aqtaFilter);
        if (value) choose(filter, value);
      });
      if (sort && params.get('sort')) choose(sort, params.get('sort'));
      sortCards();
    }

    const panels = Array.from(root.querySelectorAll('[data-aqta-panel]'));
    if (panels.length > 0) {
      const links = Array.from(root.querySelectorAll('[data-aqta-occasion]'));
      const showAll = root.querySelector('[data-aqta-show-all]');
      const show = (id) => {
        const match = panels.some((panel) => panel.dataset.aqtaPanel === id);
        root.classList.toggle('has-selection', match);
        panels.forEach((panel) => panel.classList.toggle('is-active', match && panel.dataset.aqtaPanel === id));
        links.forEach((link) => link.classList.toggle('is-current', match && link.dataset.aqtaOccasion === id));
        if (match) {
          const panel = root.querySelector('[data-aqta-panel="' + id + '"]');
          if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
      links.forEach((link) => {
        link.addEventListener('click', (event) => {
          event.preventDefault();
          const id = link.dataset.aqtaOccasion;
          history.replaceState(null, '', '#' + id);
          show(id);
        });
      });
      if (showAll) {
        showAll.addEventListener('click', () => {
          history.replaceState(null, '', window.location.pathname + window.location.search);
          show('');
          const picker = root.querySelector('.aqta-guide__picker');
          if (picker) picker.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      show((window.location.hash || '').replace('#', ''));
    }
  })();
{% endjavascript %}

