{% doc %}
  Shared header for the All Quality Trophies and Awards theme pages.
  @param {string} section_id - Unique id so the mobile menu checkbox does not collide
  @param {string} [current] - Nav item to mark current: trophies, medals, plaques, occasions, or bulk
{% enddoc %}
{%- liquid
  assign account_url = routes.account_login_url
  if customer
    assign account_url = routes.account_url
  endif
  assign trophies_url = pages['trophies'].url | default: '/pages/trophies'
  assign medals_url = pages['medals'].url | default: '/pages/medals'
  assign plaques_url = pages['plaques'].url | default: '/pages/plaques'
  assign occasions_url = pages['occasions'].url | default: '/pages/occasions'
  assign bulk_url = pages['bulk-orders'].url | default: '/pages/bulk-orders'
-%}

<div class="aqta-home__utility">
  <div class="aqta-home__wrap aqta-home__utility-row">
    <p>Trophies, medals, and plaques for every kind of recognition</p>
    <p>Custom engraving · Made in California</p>
  </div>
</div>

<header class="aqta-home__header" data-aqta-header>
  <button type="button" class="aqta-home__scrim" data-aqta-scrim tabindex="-1" aria-hidden="true"></button>
  <div class="aqta-home__wrap aqta-home__bar">
    <a class="aqta-home__logo" href="{{ routes.root_url }}">
      <span>All Quality</span>
      <small>TROPHIES</small>
    </a>

    <input class="aqta-home__check" type="checkbox" id="aqta-menu-{{ section_id }}">
    <label class="aqta-home__burger" for="aqta-menu-{{ section_id }}">
      <span class="aqta-home__visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
    </label>

      <nav class="aqta-home__nav" aria-label="Primary">
      <details class="aqta-home__drop" data-aqta-drop>
        <summary{% if current == 'trophies' %} class="is-current"{% endif %}>Trophies</summary>
        <div class="aqta-home__drop-menu">
          <a href="{{ trophies_url }}">View all trophies</a>
          <a href="/products/custom-trophy">Design your own</a>
          <p>Industry</p>
          <a href="{{ trophies_url }}?industry=sports">Sports &amp; teams</a>
          <a href="{{ trophies_url }}?industry=school">Schools &amp; academics</a>
          <a href="{{ trophies_url }}?industry=workplace">Workplace</a>
          <a href="{{ trophies_url }}?industry=community">Community &amp; service</a>
          <a href="{{ trophies_url }}?industry=events">Events &amp; competitions</a>
          <a href="{{ trophies_url }}?industry=general">General recognition</a>
          <p>Type</p>
          <a href="{{ trophies_url }}?style=cup">Cup trophies</a>
          <a href="{{ trophies_url }}?style=sports-figure">Sports figures</a>
          <a href="{{ trophies_url }}?style=star">Star awards</a>
          <a href="{{ trophies_url }}?style=figure">General figures</a>
        </div>
      </details>
      <details class="aqta-home__drop" data-aqta-drop>
        <summary{% if current == 'medals' %} class="is-current"{% endif %}>Medals</summary>
        <div class="aqta-home__drop-menu">
          <a href="{{ medals_url }}">View all medals</a>
          <a href="/products/custom-medal">Design your own</a>
          <p>Industry</p>
          <a href="{{ medals_url }}?industry=sports">Sports &amp; teams</a>
          <a href="{{ medals_url }}?industry=school">Schools &amp; academics</a>
          <a href="{{ medals_url }}?industry=workplace">Workplace</a>
          <a href="{{ medals_url }}?industry=community">Community &amp; service</a>
          <a href="{{ medals_url }}?industry=events">Events &amp; competitions</a>
          <a href="{{ medals_url }}?industry=general">General recognition</a>
          <p>Design</p>
          <a href="{{ medals_url }}?style=stars">Stars design</a>
          <a href="{{ medals_url }}?style=wreath">Wreath design</a>
          <a href="{{ medals_url }}?style=set">Place sets</a>
          <a href="{{ medals_url }}?style=personalized">Personalized</a>
        </div>
      </details>
      <details class="aqta-home__drop" data-aqta-drop>
        <summary{% if current == 'plaques' %} class="is-current"{% endif %}>Plaques</summary>
        <div class="aqta-home__drop-menu">
          <a href="{{ plaques_url }}">View all plaques</a>
          <a href="/products/custom-plaque">Design your own</a>
          <p>Industry</p>
          <a href="{{ plaques_url }}?industry=sports">Sports &amp; teams</a>
          <a href="{{ plaques_url }}?industry=school">Schools &amp; academics</a>
          <a href="{{ plaques_url }}?industry=workplace">Workplace</a>
          <a href="{{ plaques_url }}?industry=community">Community &amp; service</a>
          <a href="{{ plaques_url }}?industry=events">Events &amp; competitions</a>
          <a href="{{ plaques_url }}?industry=general">General recognition</a>
          <p>Finish</p>
          <a href="{{ plaques_url }}?style=wood">Wood</a>
          <a href="{{ plaques_url }}?style=black-frame">Black frame</a>
          <a href="{{ plaques_url }}?style=black">Black</a>
          <a href="{{ plaques_url }}?style=acrylic">Acrylic</a>
          <a href="{{ plaques_url }}?style=patriotic">Patriotic</a>
          <a href="{{ plaques_url }}?style=leatherette">Leatherette</a>
          <a href="{{ plaques_url }}?style=marble">Marble</a>
        </div>
      </details>
      <a href="{{ occasions_url }}"{% if current == 'occasions' %} class="is-current"{% endif %}>Occasions</a>
      <a href="{{ bulk_url }}"{% if current == 'bulk' %} class="is-current"{% endif %}>Bulk orders</a>
      <details class="aqta-home__more" data-aqta-drop>
        <summary>More from LITA</summary>
        <div class="aqta-home__more-menu">
          <a href="https://signsbylita.com/" target="_blank" rel="noopener">
            <strong>Signs</strong>
            <span>Signs ByLITA</span>
          </a>
          <a href="https://allqualitybadges.com/" target="_blank" rel="noopener">
            <strong>Name badges</strong>
            <span>All Quality Badges</span>
          </a>
          <a href="https://www.gavelsfast.com/" target="_blank" rel="noopener">
            <strong>Gavels</strong>
            <span>Gavels Fast</span>
          </a>
          <a href="https://www.designsbylita.com/" target="_blank" rel="noopener">
            <strong>Home decor &amp; gifts</strong>
            <span>Designs ByLITA</span>
          </a>
        </div>
      </details>
    </nav>

    <div class="aqta-home__tools">
      <a class="aqta-home__icon" href="{{ routes.root_url }}#aqta-search" aria-label="Search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M16 16.5 20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="aqta-home__icon" href="{{ account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M5 19.2c1.4-3 3.8-4.4 7-4.4s5.6 1.4 7 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        </a>
      {%- endif -%}
      <a class="aqta-home__icon aqta-home__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l-.8 11.2a1 1 0 0 1-1 .8H8.3a1 1 0 0 1-1-.8L6.5 8z" fill="none" stroke="currentColor" stroke-width="1.8"></path><path d="M9 8V6.8A3 3 0 0 1 12 3.8 3 3 0 0 1 15 6.8V8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <span data-aqta-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  body:has(.aqta-home__header) { overflow-x: clip; }
  body:has(.aqta-home__header) > header [data-header-nav-group] { display: none; }
  html:root {
    --font-body: Arial, Helvetica, sans-serif;
    --font-heading: Georgia, "Times New Roman", serif;
    --color-surface: #f5f1eb;
    --color-on-surface: #1b2433;
    --color-surface-secondary: #ffffff;
    --color-accent: #c9932e;
    --color-interactive: #0f2744;
    --color-interactive-text: #ffffff;
    --color-button-primary: #0f2744;
    --color-button-primary-text: #ffffff;
    --color-button-outline-border: #0f2744;
    --color-button-outline-text: #0f2744;
  }
  .aqta-home__utility .aqta-home__wrap,
  .aqta-home__header .aqta-home__wrap { width: min(1240px, calc(100% - 48px)); margin: 0 auto; }
  main[data-template="product"] { padding-top: 32px; }
  main[data-template="product"] h1 { color: #0f2744; font-family: Georgia, "Times New Roman", serif; font-size: clamp(32px, 3.6vw, 46px); font-weight: 500; letter-spacing: -.02em; line-height: 1.1; }
  main[data-template="product"] [data-product-price] { color: #8a6416; }
  main[data-template="product"] button[name="add"] { background: #c9932e; color: #0f2744; font-weight: 800; }
  main[data-template="product"] button[name="add"]:hover { background: #b8832a; }
  .aqta-home__utility { background: #0a1c33; color: #e8dfcd; font-size: 13px; }
  .aqta-home__utility-row { display: flex; min-height: 38px; align-items: center; justify-content: space-between; gap: 16px; }
  .aqta-home__utility p { margin: 0; }
  .aqta-home__utility,
  .aqta-home__header { font-family: Arial, Helvetica, sans-serif; }
  .aqta-home__header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    background: #f3eee4;
    color: #0f2744;
    border-bottom: 3px solid #c9932e;
    box-shadow: 0 10px 28px rgba(15, 39, 68, .12);
  }
  .aqta-home__header * { box-sizing: border-box; }
  .aqta-home__scrim {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 3;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: default;
  }
  .aqta-home__header:has([data-aqta-drop][open]) .aqta-home__scrim { display: block; }
  .aqta-home__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    position: relative;
    z-index: 4;
    align-items: center;
    gap: 24px;
    width: min(1240px, calc(100% - 48px));
    max-width: 100%;
    min-height: 74px;
    margin: 0 auto;
  }
  .aqta-home__logo { display: inline-flex; align-items: baseline; gap: 8px; color: #0f2744; text-decoration: none; }
  .aqta-home__logo span { font-family: Georgia, "Times New Roman", serif; font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1; }
  .aqta-home__logo small { color: #8a6416; font-size: 11px; font-weight: 800; letter-spacing: .18em; }
  .aqta-home__check { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  .aqta-home__burger { display: none; }
  .aqta-home__nav { display: flex; min-width: 0; align-items: center; justify-content: center; gap: 18px; }
  .aqta-home__nav > a,
  .aqta-home__drop summary,
  .aqta-home__more summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #24344c;
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }
  .aqta-home__nav > a:hover,
  .aqta-home__drop summary:hover,
  .aqta-home__more summary:hover,
  .aqta-home__nav > a.is-current,
  .aqta-home__drop summary.is-current { color: #0f2744; }
  .aqta-home__nav > a.is-current,
  .aqta-home__drop summary.is-current { box-shadow: inset 0 -2px 0 #c9932e; }
  .aqta-home__drop,
  .aqta-home__more { position: relative; }
  .aqta-home__drop summary::-webkit-details-marker { display: none; }
  .aqta-home__drop summary { list-style: none; }
  .aqta-home__drop summary::after { content: ""; width: 7px; height: 7px; margin-top: -3px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: rotate(45deg); }
  .aqta-home__drop-menu {
    position: absolute;
    top: calc(100% + 16px);
    left: 0;
    z-index: 6;
    display: grid;
    width: 250px;
    max-height: min(70vh, 520px);
    padding: 8px;
    overflow: auto;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(8, 26, 48, .28);
  }
  .aqta-home__drop-menu a,
  .aqta-home__drop-menu span { display: block; padding: 9px 12px; border-radius: 8px; color: #0f2744; font-size: 14px; font-weight: 650; text-decoration: none; }
  .aqta-home__drop-menu a:hover { background: #f6f1e8; }
  .aqta-home__drop-menu span { color: #98a2b3; cursor: default; }
  .aqta-home__drop-menu p { margin: 8px 12px 2px; color: #8a6416; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .aqta-home__more summary::-webkit-details-marker { display: none; }
  .aqta-home__more summary::after { content: ""; width: 7px; height: 7px; margin-top: -3px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: rotate(45deg); }
  .aqta-home__more-menu {
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    z-index: 5;
    display: grid;
    width: 280px;
    padding: 8px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(8, 26, 48, .28);
  }
  .aqta-home__more-menu a { display: grid; gap: 2px; padding: 12px 14px; border-radius: 10px; color: #0f2744; text-decoration: none; }
  .aqta-home__more-menu a:hover { background: #f6f1e8; }
  .aqta-home__more-menu strong { font-size: 15px; }
  .aqta-home__more-menu span { color: #667085; font-size: 13px; font-weight: 500; }
  .aqta-home__tools { display: flex; align-items: center; gap: 4px; }
  .aqta-home__icon { display: inline-flex; width: 40px; height: 40px; align-items: center; justify-content: center; color: #0f2744; }
  .aqta-home__icon svg { width: 22px; height: 22px; }
  .aqta-home__cart { position: relative; }
  .aqta-home__cart span {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 99px;
    background: #c9932e;
    color: #0f2744;
    font-size: 10px;
    font-weight: 800;
    line-height: 16px;
    text-align: center;
  }
  .aqta-home__visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 1180px) {
    .aqta-home__nav { display: none; }
    .aqta-home__burger { display: inline-flex; width: 42px; height: 42px; align-items: center; justify-content: center; cursor: pointer; }
    .aqta-home__burger span[aria-hidden="true"],
    .aqta-home__burger span[aria-hidden="true"]::before,
    .aqta-home__burger span[aria-hidden="true"]::after { display: block; width: 18px; height: 2px; background: #0f2744; content: ""; }
    .aqta-home__burger span[aria-hidden="true"] { position: relative; }
    .aqta-home__burger span[aria-hidden="true"]::before,
    .aqta-home__burger span[aria-hidden="true"]::after { position: absolute; left: 0; }
    .aqta-home__burger span[aria-hidden="true"]::before { top: -6px; }
    .aqta-home__burger span[aria-hidden="true"]::after { top: 6px; }
    .aqta-home__check:checked ~ .aqta-home__nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      gap: 4px;
      padding: 12px 20px 18px;
      background: #f3eee4;
      box-shadow: 0 16px 30px rgba(15, 39, 68, .12);
    }
    .aqta-home__drop[open] { display: grid; }
    .aqta-home__drop-menu,
    .aqta-home__more-menu { position: static; width: 100%; max-height: none; margin-top: 8px; box-shadow: none; }
    .aqta-home__bar { position: relative; }
  }
  @media (max-width: 640px) {
    .aqta-home__utility-row { align-items: flex-start; flex-direction: column; padding: 8px 0; }
    .aqta-home__utility-row p:last-child { display: none; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    document.querySelectorAll('.aqta-home__header').forEach((header) => {
      if (header.dataset.aqtaHeaderReady === 'true') return;
      header.dataset.aqtaHeaderReady = 'true';
      const toggle = header.querySelector('.aqta-home__check');
      const drops = Array.from(header.querySelectorAll('[data-aqta-drop]'));
      drops.forEach((menu) => {
        menu.addEventListener('toggle', () => {
          if (!menu.open) return;
          drops.forEach((other) => {
            if (other !== menu) other.open = false;
          });
        });
      });
      const closeOutside = (event) => {
        const path = typeof event.composedPath === 'function' ? event.composedPath() : [];
        const target = event.target;
        drops.forEach((drop) => {
          if (!drop.open) return;
          const inside = path.length ? path.includes(drop) : target instanceof Node && drop.contains(target);
          if (!inside) drop.open = false;
        });
      };
      document.addEventListener('click', closeOutside, true);
      window.addEventListener('blur', () => {
        drops.forEach((drop) => { drop.open = false; });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        drops.forEach((drop) => { drop.open = false; });
      });
      header.querySelectorAll('.aqta-home__nav a').forEach((link) => {
        link.addEventListener('click', () => {
          if (toggle) toggle.checked = false;
        });
      });

      const cartLink = header.querySelector('.aqta-home__cart');
      const cartCount = header.querySelector('[data-aqta-cart-count]');
      const drawer = document.getElementById('cart-drawer');
      if (cartLink && drawer && typeof drawer.showModal === 'function') {
        cartLink.addEventListener('click', (event) => {
          event.preventDefault();
          if (!drawer.open) drawer.showModal();
        });
      }
      const drawerItems = document.getElementById('cart-drawer-items');
      if (cartCount && drawerItems) {
        let pending;
        const refreshCount = () => {
          clearTimeout(pending);
          pending = setTimeout(() => {
            fetch('/cart.js', { headers: { Accept: 'application/json' } })
              .then((response) => response.json())
              .then((cart) => { cartCount.textContent = cart.item_count; })
              .catch(() => {});
          }, 150);
        };
        new MutationObserver(refreshCount).observe(drawerItems, { childList: true, subtree: true });
      }
    });
  })();
{% endjavascript %}
