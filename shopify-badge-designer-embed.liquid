{% comment %}
  Badge Designer Iframe Embed Snippet
  Add this to your Shopify product page template or as a section
  
  Usage:
  1. Copy this file to your theme's snippets folder
  2. In your product template, add: {% render 'badge-designer-embed' %}
  
  Or add directly to product.liquid:
{% endcomment %}

{% comment %} Replace with your Vercel URL (e.g. https://badgedesigner.vercel.app) {% endcomment %}
{% assign badge_designer_url = 'https://badgedesigner.vercel.app' %}

<div class="badge-designer-container" style="width: 100%; margin: 20px 0;">
  <div style="background: white; border-radius: 8px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h2 style="margin-top: 0;">Customize Your Badge</h2>
    
    {% comment %} Pass variant IDs so the app adds the correct store variants to cart (order: Pin, Magnetic, Adhesive). Use first variant as fallback if product has fewer than 3 variants. {% endcomment %}
    {% assign v0 = product.variants[0] %}
    {% assign v1 = product.variants[1] | default: v0 %}
    {% assign v2 = product.variants[2] | default: v0 %}
    <iframe 
      id="badge-designer-iframe"
      src="{{ badge_designer_url }}?shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&variantIdPin={{ v0.id | url_param_escape }}&variantIdMagnetic={{ v1.id | url_param_escape }}&variantIdAdhesive={{ v2.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
      width="100%" 
      height="800px" 
      frameborder="0"
      style="border: none; border-radius: 4px;"
      allow="clipboard-read; clipboard-write">
    </iframe>
  </div>
</div>

<script>
  // Listen for messages from the badge designer iframe
  window.addEventListener('message', function(event) {
    // Verify origin (replace with your Vercel URL)
    if (event.origin !== '{{ badge_designer_url }}') {
      return;
    }
    
    const data = event.data;
    
    // Handle add-to-cart messages (single item - iframe redirects; log only)
    if (data.action === 'add-to-cart') {
      console.log('Add to cart received:', data.payload);
    }
    
    // Handle add-to-cart-multiple: add each badge as a separate line item via Cart API, then redirect to cart
    if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
      const items = data.payload.items.map(function(item) {
        return {
          id: item.variantId,
          quantity: item.quantity || 1,
          properties: item.properties || {}
        };
      });
      const cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
      const cartAddUrl = cartRoot.replace(/\/$/, '') + '/cart/add.js';
      fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function(res) { return res.json(); })
        .then(function() {
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        })
        .catch(function(err) {
          console.error('Badge designer: cart/add.js failed', err);
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        });
    }
    
    // Handle design saved messages
    if (data.action === 'design-saved') {
      console.log('Design saved:', data.payload);
    }
  });
</script>

<style>
  .badge-designer-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  @media (max-width: 768px) {
    .badge-designer-container iframe {
      height: 600px !important;
    }
  }
</style>
