{% comment %}
  Badge + Sign designer iframe embed
  - Badge: product handle custom-1x3-badge → loads app root with badge designer (default).
  - Sign: product handle custom-sign → same app URL with ?variant=sign so Shopify prices + Shape/Size variants work.
  Alternative: use path /sign-designer on your host instead of ?variant=sign (both set variant to sign).

  Usage: Copy to theme snippets, then in your product template add: {% render 'badge-designer-embed' %}
{% endcomment %}

{% comment %} Custom sign product (Shape × Size variants, live price from Shopify) {% endcomment %}
{% if product and product.handle == 'custom-sign' %}

{% assign badge_designer_url = 'https://all-quality-design-tool.vercel.app' %}
{% assign sign_v0 = product.selected_or_first_available_variant | default: product.variants[0] %}
<div style="width:100%; min-height:900px;">
  <iframe
    id="sign-designer-iframe"
    src="{{ badge_designer_url }}?variant=sign&shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&signProductHandle={{ product.handle | url_param_escape }}&variantIdSign={{ sign_v0.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
    style="width:100%; height:900px; border:0;"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>

<script>
  window.addEventListener('message', function(event) {
    if (event.origin !== '{{ badge_designer_url }}') return;
    var data = event.data;
    if (data.action === 'redirect-to-login') {
      var returnTo = window.location.pathname + window.location.search;
      window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent(returnTo);
      return;
    }
    if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
      var items = data.payload.items.map(function(item) {
        return { id: item.variantId, quantity: item.quantity || 1, properties: item.properties || {} };
      });
      var cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
      var cartAddUrl = cartRoot.replace(/\/$/, '') + '/cart/add.js';
      fetch(cartAddUrl, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function() { window.location.href = cartRoot.replace(/\/$/, '') + '/cart'; })
        .catch(function() { window.location.href = cartRoot.replace(/\/$/, '') + '/cart'; });
    }
  });
</script>

{% comment %} Custom badge product (pin / magnetic / adhesive variants) {% endcomment %}
{% elsif product and product.handle == 'custom-1x3-badge' %}

{% comment %}
  Replace with your actual Vercel app URL. Must match exactly where the iframe loads from.
  If you use a new Vercel link (e.g. new project or new deployment URL), update this so the
  parent accepts postMessages from the iframe (redirect-to-login, add-to-cart, etc.).
{% endcomment %}
{% assign badge_designer_url = 'https://all-quality-design-tool.vercel.app' %}

{% comment %} Pass variant IDs so the app adds the correct store variants to cart (order: Pin, Magnetic, Adhesive). Use first variant as fallback if product has fewer than 3 variants. {% endcomment %}
{% assign v0 = product.variants[0] %}
{% assign v1 = product.variants[1] | default: v0 %}
{% assign v2 = product.variants[2] | default: v0 %}
{% comment %} Duplicate product for upsell (unlisted): same variants at reduced price. Handle may be custom-1x3-badge-duplicate. {% endcomment %}
{% assign duplicate_product = all_products['custom-1x3-badge-duplicate'] %}
{% if duplicate_product and duplicate_product.variants.size >= 3 %}
  {% assign dup0 = duplicate_product.variants[0] %}
  {% assign dup1 = duplicate_product.variants[1] %}
  {% assign dup2 = duplicate_product.variants[2] %}
  {% assign duplicate_params = '&variantIdPinDuplicate=' | append: dup0.id %}
  {% assign duplicate_params = duplicate_params | append: '&variantIdMagneticDuplicate=' | append: dup1.id %}
  {% assign duplicate_params = duplicate_params | append: '&variantIdAdhesiveDuplicate=' | append: dup2.id %}
{% else %}
  {% assign duplicate_params = '' %}
{% endif %}
<div style="width:100%; min-height:900px;">
  <iframe
    id="badge-designer-iframe"
    src="{{ badge_designer_url }}?shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&variantIdPin={{ v0.id | url_param_escape }}&variantIdMagnetic={{ v1.id | url_param_escape }}&variantIdAdhesive={{ v2.id | url_param_escape }}{{ duplicate_params }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
    style="width:100%; height:900px; border:0;"
    loading="lazy"
    allow="clipboard-read; clipboard-write"
  ></iframe>
</div>

<script>
  // Listen for messages from the badge designer iframe.
  // IMPORTANT: badge_designer_url above must match your iframe's origin exactly (e.g. new Vercel URL).
  window.addEventListener('message', function(event) {
    if (event.origin !== '{{ badge_designer_url }}') {
      return;
    }
    
    const data = event.data;
    
    // Save design / Load design without being logged in: redirect to store login, then return to this page
    if (data.action === 'redirect-to-login') {
      var returnTo = window.location.pathname + window.location.search;
      window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent(returnTo);
      return;
    }
    
    // Handle add-to-cart messages (single item - iframe redirects; log only)
    if (data.action === 'add-to-cart') {
      console.log('Add to cart received:', data.payload);
    }
    
    // Handle add-to-cart-multiple: add each badge as a separate line item via Cart API, then redirect to cart
    if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
      const items = data.payload.items.map(function(item) {
        return {
          id: item.variantId,
          quantity: item.quantity || 1,
          properties: item.properties || {}
        };
      });
      const cartRoot = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
      const cartAddUrl = cartRoot.replace(/\/$/, '') + '/cart/add.js';
      fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function(res) { return res.json(); })
        .then(function() {
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        })
        .catch(function(err) {
          console.error('Badge designer: cart/add.js failed', err);
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        });
    }
    
    // Handle design saved messages
    if (data.action === 'design-saved') {
      console.log('Design saved:', data.payload);
    }
  });
</script>

{% endif %}
