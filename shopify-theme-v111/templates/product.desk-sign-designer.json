{
  "sections": {
    "designer_embed": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{% render 'badge-designer-embed' %}",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": ["designer_embed"]
}
