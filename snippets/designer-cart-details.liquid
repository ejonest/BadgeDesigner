{% comment %}
  Cart details for BadgeDesigner lines (badge / sign / plaque).
  Omits internal props (Design ID, Gadget ID, thumbnail URL, Proof PDF, Price duplicate).
  Pass: item (cart line)
{% endcomment %}
{%- if item.properties['Custom Badge Design'] != 'Yes' -%}
{%- else -%}
  <div
    class="designer-cart-details"
    style="margin-top: 8px; padding: 10px; background: #f8f9fa; border-radius: 6px; font-size: 0.9em;"
  >
    {%- assign designer_key = item.properties['Designer'] | default: '' | strip | downcase -%}
    {%- if designer_key != blank -%}
      <p style="margin: 2px 0;">
        <strong>Designer:</strong>
        {{ item.properties['Designer'] | escape }}
      </p>
    {%- endif -%}

    {%- assign idx = item.properties['Plaque Index'] | default: item.properties['Sign Index'] | default: item.properties['Badge Index'] | strip -%}
    {%- if idx != blank -%}
      <p style="margin: 2px 0;">
        <strong>Design slot:</strong> {{ idx | plus: 1 }}
      </p>
    {%- endif -%}

    {%- if item.product.has_only_default_variant == false -%}
      {%- for option in item.options_with_values -%}
        <p style="margin: 2px 0;">
          <strong>{{ option.name | escape }}:</strong> {{ option.value | escape }}
        </p>
      {%- endfor -%}
    {%- endif -%}

    {%- if item.properties['Badge Text Line 1'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 1:</strong> {{ item.properties['Badge Text Line 1'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 2'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 2:</strong> {{ item.properties['Badge Text Line 2'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 3'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 3:</strong> {{ item.properties['Badge Text Line 3'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 4'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 4:</strong> {{ item.properties['Badge Text Line 4'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 5'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 5:</strong> {{ item.properties['Badge Text Line 5'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 6'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 6:</strong> {{ item.properties['Badge Text Line 6'] }}</p>
    {%- endif -%}

    {%- if item.properties['Font Family'] != blank -%}
      <p style="margin: 2px 0;"><strong>Font:</strong> {{ item.properties['Font Family'] }}</p>
    {%- endif -%}

    {%- if item.properties['Backing Type'] != blank -%}
      <p style="margin: 2px 0;"><strong>Backing:</strong> {{ item.properties['Backing Type'] }}</p>
    {%- endif -%}

    {%- if item.properties['Background Color'] != blank -%}
      <p style="margin: 2px 0;">
        <strong>Background:</strong>
        <span
          style="display: inline-block; width: 14px; height: 14px; background: {{ item.properties['Background Color'] }}; border: 1px solid #ccc; border-radius: 2px; vertical-align: middle; margin-left: 4px;"
        ></span>
        {{ item.properties['Background Color'] }}
      </p>
    {%- endif -%}
  </div>
{%- endif -%}
