{% comment %}
  Cart details for BadgeDesigner lines (badge / sign / plaque).
  Shows only ordered variant options, customer text, uploaded logo, and backing.
  Pass: item (cart line)
{% endcomment %}
{%- assign is_custom_design = item.properties['_Custom Badge Design'] | default: item.properties['Custom Badge Design'] -%}
{%- if is_custom_design != 'Yes' -%}
{%- else -%}
  <div
    class="designer-cart-details"
    style="margin-top: 8px; padding: 10px; background: #f8f9fa; border-radius: 6px; font-size: 0.9em;"
  >
    {%- if item.product.has_only_default_variant == false -%}
      {%- for option in item.options_with_values -%}
        <p style="margin: 2px 0;">
          <strong>{{ option.name | escape }}:</strong> {{ option.value | escape }}
        </p>
      {%- endfor -%}
    {%- endif -%}

    {%- if item.properties['Badge Text Line 1'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 1:</strong> {{ item.properties['Badge Text Line 1'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 2'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 2:</strong> {{ item.properties['Badge Text Line 2'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 3'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 3:</strong> {{ item.properties['Badge Text Line 3'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 4'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 4:</strong> {{ item.properties['Badge Text Line 4'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 5'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 5:</strong> {{ item.properties['Badge Text Line 5'] }}</p>
    {%- endif -%}
    {%- if item.properties['Badge Text Line 6'] != blank -%}
      <p style="margin: 2px 0;"><strong>Line 6:</strong> {{ item.properties['Badge Text Line 6'] }}</p>
    {%- endif -%}

    {%- if item.properties['Uploaded Logo'] != blank -%}
      <p style="margin: 2px 0;"><strong>Uploaded logo:</strong> {{ item.properties['Uploaded Logo'] }}</p>
    {%- endif -%}

    {%- assign backing = item.properties['_Backing Type'] | default: item.properties['Backing Type'] -%}
    {%- if backing != blank -%}
      <p style="margin: 2px 0;"><strong>Backing:</strong> {{ backing }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
