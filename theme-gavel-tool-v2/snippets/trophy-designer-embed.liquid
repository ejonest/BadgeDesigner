{% doc %}
  Renders the Gavels Fast trophy designer for the current custom trophy product.
{% enddoc %}

{% assign trophy_designer_origin = 'https://all-quality-design-tool.vercel.app' %}

<style>
  .tf-designer-embed {
    width: var(--tf-bleed-width, 100%);
    max-width: var(--tf-bleed-width, 100%);
    margin: 0 0 40px calc(50% - (var(--tf-bleed-width, 100%) / 2));
    background: #f7f4ef;
  }

  .tf-designer-embed iframe {
    display: block;
    width: 100%;
    height: calc(100vh - var(--tf-header-height, 190px));
    height: calc(100dvh - var(--tf-header-height, 190px));
    min-height: 520px;
    border: 0;
  }

  @media screen and (min-width: 990px) {
    .tf-designer-embed iframe {
      height: max(calc(100dvh - var(--tf-header-height, 190px)), 900px);
    }
  }

  .tf-designer-info {
    margin: 0 0 48px;
    color: #232323;
  }

  .tf-designer-info h2 {
    margin: 32px 0 10px;
    font-size: 22px;
    line-height: 1.3;
  }

  .tf-designer-info h2:first-child {
    margin-top: 0;
  }

  .tf-designer-info p {
    margin: 0 0 14px;
    font-size: 15px;
    line-height: 1.7;
  }

  .tf-designer-info__steps {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }

  .tf-designer-info__steps li {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .tf-designer-info__steps strong {
    display: block;
    margin-bottom: 4px;
  }

  .tf-designer-info__note {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #e6e1d8;
    font-style: italic;
  }

  @media (max-width: 749px) {
    .tf-designer-info__steps {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    function syncBleedWidth() {
      document.documentElement.style.setProperty(
        '--tf-bleed-width',
        document.documentElement.clientWidth + 'px'
      );
    }

    function syncHeaderHeight() {
      var main = document.querySelector('main.main-content') || document.querySelector('main');
      if (!main) return;
      var offset = Math.round(
        main.getBoundingClientRect().top +
        (window.scrollY || window.pageYOffset || 0)
      );
      if (offset < 0 || offset > 600) return;
      document.documentElement.style.setProperty('--tf-header-height', offset + 'px');
    }

    function syncLayout() {
      syncBleedWidth();
      syncHeaderHeight();
    }

    syncBleedWidth();

    function watchLayout() {
      syncLayout();
      window.addEventListener('resize', syncLayout);
      window.addEventListener('load', syncLayout);
      setTimeout(syncLayout, 600);
      setTimeout(syncLayout, 2000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', watchLayout);
    } else {
      watchLayout();
    }
  })();
</script>

{% if product %}
  {% assign trophy_variant = product.selected_or_first_available_variant | default: product.variants.first %}
  {% assign trophy_unit_price = product.price | divided_by: 100.0 %}

  <div class="tf-designer-embed">
    <iframe
      id="trophy-designer-iframe"
      title="Design your custom trophy"
      src="{{ trophy_designer_origin }}/trophy-designer?embedded=1&amp;shop={{ shop.permanent_domain | url_param_escape }}&amp;storeUrl={{ shop.permanent_domain | url_param_escape }}&amp;product={{ product.id }}&amp;productHandle={{ product.handle | url_param_escape }}{% if trophy_variant %}&amp;variantId={{ trophy_variant.id }}{% endif %}&amp;price={{ trophy_unit_price }}{% if customer %}&amp;customerId={{ customer.id }}{% endif %}"
      allow="clipboard-read; clipboard-write; fullscreen"
    ></iframe>
  </div>

  <script>
    (function() {
      var DESIGNER_ORIGIN = {{ trophy_designer_origin | json }};
      var frame = document.getElementById('trophy-designer-iframe');
      if (!frame) return;

      function isAllowedDesignerOrigin(origin) {
        if (origin === DESIGNER_ORIGIN) return true;
        if (/^https?:\/\/localhost(:\d+)?$/.test(origin)) return true;
        return /^https:\/\/.*\.vercel\.app$/.test(origin);
      }

      function replyToDesigner(event, requestId, success, error) {
        if (!requestId || !event.source) return;
        event.source.postMessage({
          action: 'add-to-cart-result',
          requestId: requestId,
          success: success,
          error: error || null
        }, event.origin);
      }

      function removeReplacedCartLines(cartRoot, replaceDesignId) {
        if (!replaceDesignId) return Promise.resolve();
        var base = cartRoot.replace(/\/$/, '');
        return fetch(base + '/cart.js', { headers: { 'Accept': 'application/json' } })
          .then(function(response) { return response.json(); })
          .then(function(cart) {
            var stale = (cart.items || []).filter(function(item) {
              var properties = item.properties || {};
              return (properties['_Design ID'] || properties['Design ID']) === replaceDesignId;
            });
            return stale.reduce(function(chain, item) {
              return chain.then(function() {
                return fetch(base + '/cart/change.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ id: item.key, quantity: 0 })
                });
              });
            }, Promise.resolve());
          })
          .catch(function(error) {
            console.error('Trophy designer: could not remove replaced cart lines', error);
          });
      }

      function addToCart(items, event, requestId, replaceDesignId) {
        if (!items || !items.length) {
          replyToDesigner(event, requestId, false, 'No cart items to add');
          return;
        }
        var cartRoot =
          window.Shopify && window.Shopify.routes && window.Shopify.routes.root
            ? window.Shopify.routes.root
            : '/';
        var base = cartRoot.replace(/\/$/, '');
        var payload = {
          items: items.map(function(item) {
            return {
              id: parseInt(String(item.variantId), 10),
              quantity: item.quantity || 1,
              properties: item.properties || {}
            };
          })
        };

        fetch(base + '/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function(response) {
            return response.json().then(function(body) {
              if (!response.ok) {
                throw new Error(
                  (body && (body.description || body.message)) ||
                  ('HTTP ' + response.status)
                );
              }
              return body;
            });
          })
          .then(function() {
            return removeReplacedCartLines(cartRoot, replaceDesignId);
          })
          .then(function() {
            replyToDesigner(event, requestId, true);
            window.location.href = base + '/cart';
          })
          .catch(function(error) {
            var message = error && error.message ? error.message : String(error);
            console.error('Trophy designer: cart/add.js failed', error);
            replyToDesigner(event, requestId, false, message);
            alert('Could not add your trophy to the cart. Please try again.\n\n' + message);
          });
      }

      window.addEventListener('message', function(event) {
        if (!isAllowedDesignerOrigin(event.origin)) return;
        var data = event.data;
        if (!data || !data.action) return;

        if (data.action === 'add-to-cart' && data.payload) {
          addToCart(
            [data.payload],
            event,
            data.requestId,
            data.payload.replaceDesignId
          );
          return;
        }

        if (
          data.action === 'add-to-cart-multiple' &&
          data.payload &&
          Array.isArray(data.payload.items)
        ) {
          addToCart(
            data.payload.items,
            event,
            data.requestId,
            data.payload.replaceDesignId
          );
        }
      });
    })();
  </script>

  <div class="tf-designer-info">
    <h2>How it works</h2>
    <ul class="tf-designer-info__steps">
      <li>
        <strong>1. Choose your trophy</strong>
        Pick a trophy style and plate finish, then enter the wording for the personalized plate.
      </li>
      <li>
        <strong>2. Preview your design</strong>
        Switch between plate and trophy views to check the wording and placement before continuing.
      </li>
      <li>
        <strong>3. Choose your quantity</strong>
        Review the completed design and select how many matching trophies you need.
      </li>
    </ul>

    <p class="tf-designer-info__note">
      Questions about a team or volume order? Call (310) 534-1138 or email
      <a href="mailto:info@gavelsfast.com">info@gavelsfast.com</a>.
    </p>
  </div>
{% else %}
  <p>The trophy designer is only available on a product page.</p>
{% endif %}
