<div class="page-header">
  <div class="container">
    {% render 'breadcrumb' %}
    <h1>
      {% render 'multilang' with page.title %}
    </h1>
  </div>
</div>

<style>
  .page-header{
    {% if section.settings.background != blank %}
    background-image:url({{section.settings.background | img_url:'master'}});
    background-size: cover;
    background-position: center center;
    {% else %}
    background-color:#fff;
    {% endif %}
    color:{{section.settings.text_color}};
    text-align: center;
    padding-top: 50px;
    padding-bottom:67px;
  }
  .page-header .breadcrumb{
    -webkit-justify-content: center;
    -moz-justify-content: center;
    -ns-justify-content: center;
    justify-content: center;
    padding-bottom:5px;
  }
  .page-header h1{
    font-size: 30px;
    letter-spacing: 0.05em;
    margin-bottom: 0;
  }
  .breadcrumb *,.page-header h1{
    color:{{section.settings.text_color}};
  }
@media (max-width:992px) {
  .page-header h1{
    font-size: 20px;
  }
}
@media (max-width:767px) {
  .page-header h1{
    font-size: 18px;
  }
}
</style>

{% schema %}
{
  "name": "Page Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "background",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    }
  ]
}
{% endschema %}
