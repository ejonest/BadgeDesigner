{%- if section.settings.view_all_show != false -%}
  <a href="{{ section.settings.view_all_link | default: card_link }}" class="aqb-ds-prod-card aqb-ds-prod-card--view-all">
    <div class="aqb-ds-prod-card__view-all-icon" aria-hidden="true">+</div>
    <div class="aqb-ds-prod-card__view-all-title">{{ section.settings.view_all_heading | default: '36 more professions' | escape }}</div>
    <div class="aqb-ds-prod-card__view-all-sub">{{ section.settings.view_all_subtext | default: 'Nurse · Principal · Realtor · Engineer & more' | escape }}</div>
    <span class="aqb-ds-prod-card__add aqb-ds-prod-card__add--view-all">{{ section.settings.view_all_label | default: 'View All' | escape }}</span>
  </a>
{%- endif -%}
