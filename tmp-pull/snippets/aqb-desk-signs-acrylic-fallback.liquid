{%- liquid
  assign card_link = section.settings.cta_link | default: collections['acrylic-desk-signs'].url
  assign card_cta = section.settings.card_cta | default: 'Personalise'
-%}

<a href="{{ card_link }}" class="aqb-ds-prod-card" data-finish="acrylic">
  <div class="aqb-ds-prod-card__img">
    <img src="https://cdn.shopify.com/s/files/1/0511/0739/7783/files/db215041-2a6a-5d18-85df-d4710b032b44_1df6a4fd-fb47-4601-84b7-bc673241c4ab.jpg?v=1781185001" alt="Doctor / Physician" loading="lazy" width="500" height="120">
  </div>
  <div class="aqb-ds-prod-card__body">
    <div class="aqb-ds-prod-card__title">Doctor / Physician</div>
    <div class="aqb-ds-prod-card__meta">Acrylic · Medical Cross vector · 2×10"</div>
    <div class="aqb-ds-prod-card__footer">
      <span class="aqb-ds-prod-card__price">$24.99</span>
      <span class="aqb-ds-prod-card__add">{{ card_cta | escape }}</span>
    </div>
  </div>
</a>

