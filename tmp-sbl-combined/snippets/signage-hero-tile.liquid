{%- liquid
  assign tile_image = image | default: product.featured_image
  assign tile_label = label | default: product.title
  assign tile_prefix = class_prefix | default: 'sbl-sg-hero'
-%}
<a href="{{ product.url }}" class="{{ tile_prefix }}__tile" {{ attrs }}>
  {%- if tile_image != blank -%}
    {{
      tile_image
      | image_url: width: 500
      | image_tag: loading: 'eager', widths: '250,400,500', sizes: '(min-width: 990px) 15vw, 1px', alt: tile_label
    }}
  {%- endif -%}
  <span class="{{ tile_prefix }}__tile-label">{{ tile_label | escape }}</span>
</a>
