{%- liquid
  assign on_sale = false
  if product.compare_at_price_min > product.price_min
    assign on_sale = true
  endif
  assign sold_out = true
  if product.available
    assign sold_out = false
  endif
  assign option_color_swatch = settings.option_color_swatch | downcase
  assign url = ''
  for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_color_swatch contains option_name
          assign select = option.selected_value
          for variant in product.variants limit: 1
            if variant.image != null  
              assign url = variant.image.src
            endif
          endfor
      endif
  endfor
-%}

<div class="inner product-item{% if sold_out %} sold-out{% endif %}{% if on_sale %} on-sale{% endif %}" data-product-id="product-{{ product.id }}">
  <div class="inner-top">
    <div class="product-top">
      {%- liquid
        assign designer_fallback = blank
        if product.featured_image == blank
          if collection.handle == 'awards-and-plaques' or collection.handle == 'awards-plaques-plaques' or collection.handle == 'awards-plaques-medals' or template.suffix == 'grid-card'
            if product.handle == 'custom-plaque'
              assign designer_fallback = 'sbl-plaque-designer-shot.jpg'
            elsif product.handle == 'custom-trophy'
              assign designer_fallback = 'sbl-trophy-designer-shot.jpg'
            endif
          endif
        endif
      -%}
      {%- if designer_fallback != blank -%}
      <div class="product-image">
        <a href="{{ product.url | within: collection }}" class="product-grid-image adaptive_height" style="display:flex;align-items:center;justify-content:center;aspect-ratio:1/1;background:#eef3f6;overflow:hidden;">
          <img src="{{ designer_fallback | asset_url }}" alt="{{ product.title | escape }} online designer" loading="lazy" width="1600" height="1000" style="width:100%;height:100%;object-fit:contain;">
        </a>
      </div>
      {%- elsif sbl_quick_buy -%}
      <div class="product-image sbl-card-gallery" data-sbl-gallery>
        <a href="{{ product.url | within: collection }}" class="product-grid-image adaptive_height" data-collections-related="{{ routes.collections_url }}/{{ collection.handle }}?view=related" {% unless settings.product_image_resize %}style="padding-top: {{ 1 | divided_by: product.featured_image.aspect_ratio | times: 100 }}%"{% endunless %}>
          {%- for image in product.images limit: 8 -%}
          <img class="sbl-card-gallery__img{% if forloop.first %} is-active{% endif %}" src="{{ image | image_url: width: 600 }}" alt="{{ image.alt | default: product.title | escape }}" width="600" height="{{ 600 | divided_by: image.aspect_ratio | round }}" loading="lazy">
          {%- endfor -%}
        </a>
        {%- if product.images.size > 1 -%}
        <button type="button" class="sbl-card-gallery__nav sbl-card-gallery__nav--prev" data-sbl-gallery-prev aria-label="Previous photo"><span aria-hidden="true">&#8249;</span></button>
        <button type="button" class="sbl-card-gallery__nav sbl-card-gallery__nav--next" data-sbl-gallery-next aria-label="Next photo"><span aria-hidden="true">&#8250;</span></button>
        {%- endif -%}
      </div>
      {%- else -%}
      <div class="product-image{% if product.images.size > 1 and settings.image_swap %} image-swap{% endif %}">
        <a href="{{ product.url | within: collection }}" class="product-grid-image adaptive_height" data-collections-related="{{ routes.collections_url }}/{{collection.handle}}?view=related" {% unless settings.product_image_resize %}style="padding-top: {{ 1 | divided_by: product.featured_image.aspect_ratio | times: 100 }}%"{% endunless %}>
          {% render 'image-size', product: product, img: url %}
        </a>
      </div>
      {%- endif -%}

      {% render 'product-label' with product as product %}

      {% comment %} Use for productGrid {% endcomment %}
      <div class="product-des abs-center">
        {% render 'wishlist-product' with product as product %}

        {% if settings.display_button and sbl_quick_buy != true %}
        <div class="action">
          {% render 'add-to-cart-form', product: product, sold_out: sold_out, id: 'grid-product-form-' %}
        </div>
        {% endif %}

        {% if settings.display_product_reviews %}
        <span class="shopify-product-reviews-badge" data-id="{{ product.id }}"></span>
        {% endif %}
      </div>

      {% if settings.display_item_size or settings.enable_quick_view %}
      <div class="product-des abs-bottom">
        {% if settings.display_item_size %}
        {% render 'items-size' with product as product %}
        {% endif %}

        {% if settings.enable_quick_view %}
        <a class="quickview-button" href="javascript:void(0)" id="{{ product.handle }}" title="{{ 'products.product.quick_view' | t }}" {% if settings.enable_multilang %}data-translate="products.product.quick_view" translate-item="title"{% endif %}>
          <span {% if settings.enable_multilang %}data-translate="products.product.quick_view"{% endif %}>
            {{ 'products.product.quick_view' | t }}
          </span>
        </a>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {% comment %} Use for productGrid {% endcomment %}
    <div class="product-bottom">
      
      <div class="wrapper-compare">
        {% if settings.show_vendor %}
          <div class="product-vendor">
            {{ product.vendor | link_to_vendor }}
          </div>
        {% endif %}
        {% if settings.enable_compare_product and template == 'collection' %}
          {% render 'compare-product' with product as product %}
        {% endif %}
      </div>

      <a class="product-title {% if select != blank %}change-text{% endif %}" href="{{ product.url | within: collection }}">
        {% render 'multilang' with product.title %}
        {% if select != blank %}<span data-change-title> - {{ select }}</span>{% endif %}
      </a>

      <div class="price-box">
        {% if on_sale %}
        <div class="price-sale">
          {% if settings.enable_quick_shop %}
            <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
            <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
          {% else %}
            <span class="old-price" >{{ product.compare_at_price_min | money }}</span>
            <span class="special-price">
              {% if product.price_varies %}{% render 'varies_from' %}{% endif %}{{ product.price_min | money }}
            </span>
          {% endif %}
        </div>
        {% else %}
          {% if settings.enable_quick_shop %}
          <div class="price-regular">
            <span data-price-grid>{{ product.variants[0].price | money }}</span>
          </div>
          {% else %}
          <div class="price-regular">
            <span>{% if product.price_varies %}{% render 'varies_from' %}{% endif %}{{ product.price_min | money }}</span>
          </div>
          {% endif %}
        {% endif %}
      </div>

      {% if sbl_quick_buy %}
        {% assign sbl_card_variant = product.selected_or_first_available_variant %}
        {% assign sbl_variant_count = product.variants.size %}
        {% if sbl_variant_count > 24 %}
          <a class="btn sbl-card-buy__choose" href="{{ product.url | within: collection }}">Choose options</a>
        {% elsif sbl_card_variant %}
          <form action="{{ routes.cart_url }}/add" method="post" class="sbl-card-buy" id="sbl-card-{{ product.id }}" enctype="multipart/form-data">
            {% if sbl_variant_count > 1 and product.variants.first.title != 'Default Title' %}
              <label class="sbl-card-buy__option">
                <span class="sbl-card-buy__label">Options</span>
                <select name="id" aria-label="Options">
                  {% for variant in product.variants %}
                    <option value="{{ variant.id }}" {% if variant.id == sbl_card_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}</option>
                  {% endfor %}
                </select>
              </label>
            {% else %}
              <input type="hidden" name="id" value="{{ sbl_card_variant.id }}">
            {% endif %}
            <div class="sbl-card-buy__row">
              <input class="sbl-card-buy__qty" type="text" inputmode="numeric" pattern="[0-9]*" name="quantity" value="1" data-sbl-qty aria-label="Quantity" autocomplete="off">
              <button class="btn add-to-cart-btn sbl-card-buy__submit" type="submit" data-btn-addToCart data-form-id="#sbl-card-{{ product.id }}" {% unless sbl_card_variant.available %}disabled="disabled"{% endunless %}>
                {% if sbl_card_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
              </button>
            </div>
          </form>
        {% endif %}
      {% endif %}

      {% if settings.display_item_swatch %}
      {% render 'item-swatch' with product as product %}
      {% endif %}
    </div>

    {% comment %} Use for productList {% endcomment %}
    <div class="product-details">
      {% if settings.show_vendor %}
      <div class="product-vendor">
        {{ product.vendor | link_to_vendor }}
      </div>
      {% endif %}

      <a class="product-title {% if select != blank %}change-text{% endif %}" href="{{ product.url | within: collection }}">
        {% render 'multilang' with product.title %}
        {% if select != blank %}<span data-change-title> - {{ select }}</span>{% endif %}
      </a>

      {% if settings.display_product_reviews %}
      <span class="shopify-product-reviews-badge" data-id="{{ product.id }}" style="min-height: 20px; display: block; margin-bottom: 9px;"></span>
      {% endif %}

      <div class="short-description">
        {% if product.description contains '[countdown]' %}
        {% assign des = product.description | split:'[/countdown]' | last %}
        {% else %}
        {% assign des = product.description %}
        {% endif %}

        {% if settings.enable_multilang and des contains '[lang2]' %}
        <div class="lang1">
          {{ des | split: '[lang2]' | first | strip_html | truncatewords: 40 }}
        </div>
        <div class="lang2">
          {{ des | split: '[lang2]' | last | strip_html | truncatewords: 40 }}
        </div>
        {% else %}
        <div>
          {{ des | split: '[lang2]' | first | strip_html | truncatewords: 40 }}
        </div>
        {% endif %}
      </div>

      <div class="price-box">
        {% if on_sale %}
        <div class="price-sale">
          {% if settings.enable_quick_shop %}
            <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
            <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
          {% else %}
            <span class="old-price" >{{ product.compare_at_price_min | money }}</span>
            <span class="special-price">
              {% if product.price_varies %}{% render 'varies_from' %}{% endif %}{{ product.price_min | money }}
            </span>
          {% endif %}
        </div>
        {% else %}
          {% if settings.enable_quick_shop %}
          <div class="price-regular">
            <span data-price-grid>{{ product.variants[0].price | money }}</span>
          </div>
          {% else %}
          <div class="price-regular">
            <span>{% if product.price_varies %}{% render 'varies_from' %}{% endif %}{{ product.price_min | money }}</span>
          </div>
          {% endif %}
        {% endif %}
      </div>

      {% if settings.display_item_swatch %}
      {% render 'item-swatch' with product as product %}
      {% endif %}

      {% if settings.display_button %}
      <div class="action">
        {% render 'add-to-cart-form', product: product, sold_out: sold_out, id: 'list-product-form', list: 'list' %}
      </div>
      {% endif %}

      {% render 'wishlist-product' with product as product %}
    </div>
  </div>
</div>
