{% comment %}
  Plaque designer — ONE iframe only (no wrapper div: theme CSS was forcing 100vh on both iframe and
  an inner div, which looked like two stacked “viewports”).

  Catalog: parent page fetches /products/HANDLE.js (same-origin) and postMessages into the iframe.

  DUPLICATE / WRONG PAGE SAFETY
  - This snippet only outputs when the current product is the plaque-designer product (same rule as
    main-product’s is_plaque_designer_product). A stray {% render 'plaque-designer-embed' %} in Custom
    liquid or another template will not show on other products or twice on the plaque product.
  - Sync the handle/title check below with sections/main-product.liquid if you change the product slug.

  Optional: {% render 'plaque-designer-embed', plaque_designer_force: true %} to bypass the product check
  (advanced / debugging only).

  Set plaque_designer_url to your Vercel origin (no path, no trailing slash).
{% endcomment %}
{% liquid
  assign plaque_designer_url = 'https://all-quality-design-tool.vercel.app'
  assign plaque_designer_match = false
  if plaque_designer_force
    assign plaque_designer_match = true
  elsif product != blank
    if product.handle == 'custom-plaque' or product.title == 'Custom Plaque Design'
      assign plaque_designer_match = true
    endif
  endif
%}
{% if plaque_designer_match %}
{% assign plaque_fallback_variant = product.selected_or_first_available_variant | default: product.variants[0] %}
<iframe
  class="plaque-designer-iframe"
  data-plaque-designer-embed-root
  title="Plaque designer"
  src="{{ plaque_designer_url }}?variant=plaque&shop={{ shop.permanent_domain | url_param_escape }}&storeUrl={{ shop.permanent_domain | url_param_escape }}&product={{ product.id | url_param_escape }}&plaqueProductHandle={{ product.handle | url_param_escape }}&variantIdSign={{ plaque_fallback_variant.id | url_param_escape }}{% if customer %}&customerId={{ customer.id | url_param_escape }}{% endif %}"
  style="display:block;width:100%;height:min(90vh,900px);border:0;"
  loading="lazy"
  allow="clipboard-read; clipboard-write"
></iframe>

<script>
(function () {
  var iframeEl = document.currentScript && document.currentScript.previousElementSibling;
  if (!iframeEl || iframeEl.tagName !== 'IFRAME' || iframeEl.getAttribute('data-plaque-designer-embed-root') == null) {
    return;
  }
  var all = document.querySelectorAll('iframe.plaque-designer-iframe[data-plaque-designer-embed-root]');
  if (all.length > 1) {
    for (var d = 1; d < all.length; d++) {
      all[d].remove();
    }
  }
  if (!iframeEl.isConnected) {
    return;
  }

  var designerOrigin = '{{ plaque_designer_url }}'.replace(/\/$/, '');
  var iframe = iframeEl;

  function sendProductJsonToIframe() {
    var win = iframe.contentWindow;
    if (!win) return;
    fetch('/products/{{ product.handle | url_param_escape }}.js')
      .then(function (r) {
        if (!r.ok) throw new Error('product.js ' + r.status);
        return r.json();
      })
      .then(function (product) {
        win.postMessage(
          { type: 'PLAQUE_DESIGNER_SHOPIFY_PRODUCT', payload: product },
          designerOrigin
        );
      })
      .catch(function (e) {
        console.warn('[plaque-designer-embed] Could not load /products/{{ product.handle }}.js for iframe catalog', e);
      });
  }

  iframe.addEventListener('load', sendProductJsonToIframe);

  if (window.__plaqueDesignerEmbedMessageBound) {
    return;
  }
  window.__plaqueDesignerEmbedMessageBound = true;

  window.addEventListener('message', function (event) {
    if (event.origin !== designerOrigin) return;
    var data = event.data;
    if (data.action === 'redirect-to-login') {
      var returnTo = window.location.pathname + window.location.search;
      window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent(returnTo);
      return;
    }
    if (data.action === 'add-to-cart-multiple' && data.payload && Array.isArray(data.payload.items)) {
      var items = data.payload.items.map(function (item) {
        return { id: item.variantId, quantity: item.quantity || 1, properties: item.properties || {} };
      });
      var cartRoot = window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/';
      var cartAddUrl = cartRoot.replace(/\/$/, '') + '/cart/add.js';
      fetch(cartAddUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function () { window.location.href = cartRoot.replace(/\/$/, '') + '/cart'; })
        .catch(function (err) {
          console.error('Plaque designer: cart/add.js failed', err);
          window.location.href = cartRoot.replace(/\/$/, '') + '/cart';
        });
    }
  });
})();
</script>
{% endif %}
