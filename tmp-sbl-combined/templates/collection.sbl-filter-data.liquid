{%- layout none -%}
{%- paginate collection.products by 250 -%}
{
  "page": {{ paginate.current_page | json }},
  "pages": {{ paginate.pages | json }},
  "products": [
    {%- assign emitted = false -%}
    {%- for product in collection.products -%}
      {%- if emitted -%},{%- endif -%}
      {%- assign emitted = true -%}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "image": {% if product.featured_image %}{{ product.featured_image.src | json }}{% else %}null{% endif %},
        "images": [{% for image in product.images limit: 8 %}{% unless forloop.first %},{% endunless %}{{ image | image_url: width: 600 | json }}{% endfor %}],
        "variants": [{% for variant in product.variants limit: 24 %}{% unless forloop.first %},{% endunless %}{"id":{{ variant.id | json }},"title":{{ variant.title | json }},"available":{{ variant.available | json }}}{% endfor %}],
        "variantCount": {{ product.variants.size | json }},
        "price": {{ product.price_min | divided_by: 100.0 | json }},
        "priceVaries": {{ product.price_varies | json }},
        "tags": {{ product.tags | json }}
      }
    {%- endfor -%}
  ]
}
{%- endpaginate -%}
