{%- comment -%}
  Desk Signs collection hero. The visual is a screenshot of the real desk-sign designer,
  not a mockup. The regular collection grid remains below this section.
{%- endcomment -%}

{%- liquid
  assign tool_url = section.settings.primary_link | default: '/products/custom-desk-sign'
  assign browse_url = section.settings.secondary_link | default: '#desk-signs-collection-products'
-%}

<section
  id="sbl-ds-hero-{{ section.id }}"
  class="sbl-ds-hero"
  aria-label="{{ section.settings.heading | strip_html | escape }}"
>
  <div class="sbl-ds-hero__inner">
    <div class="sbl-ds-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sbl-ds-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="sbl-ds-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="sbl-ds-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <div class="sbl-ds-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ tool_url }}" class="sbl-ds-hero__btn sbl-ds-hero__btn--primary">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ browse_url }}" class="sbl-ds-hero__btn sbl-ds-hero__btn--ghost">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="sbl-ds-hero__stats">
        {%- if section.settings.show_product_count and collection.products_count > 0 -%}
          <div class="sbl-ds-hero__stat">
            <div class="sbl-ds-hero__stat-val">{{ collection.products_count }}+</div>
            <div class="sbl-ds-hero__stat-label">{{ section.settings.product_count_label | escape }}</div>
          </div>
        {%- endif -%}
        <div class="sbl-ds-hero__stat">
          <div class="sbl-ds-hero__stat-val">{{ section.settings.stat_1_value | escape }}</div>
          <div class="sbl-ds-hero__stat-label">{{ section.settings.stat_1_label | escape }}</div>
        </div>
        <div class="sbl-ds-hero__stat">
          <div class="sbl-ds-hero__stat-val">{{ section.settings.stat_2_value | escape }}</div>
          <div class="sbl-ds-hero__stat-label">{{ section.settings.stat_2_label | escape }}</div>
        </div>
      </div>
    </div>

    <a
      href="{{ tool_url }}"
      class="sbl-ds-hero__designer"
      aria-label="{{ section.settings.primary_label | default: 'Open the custom desk sign designer' | escape }}"
    >
      {%- if section.settings.designer_image != blank -%}
        {{
          section.settings.designer_image
          | image_url: width: 1800
          | image_tag: class: 'sbl-ds-hero__designer-image', loading: 'eager', widths: '700,1000,1300,1600,1800', sizes: '(min-width: 990px) 48vw, 100vw', alt: section.settings.designer_image_alt
        }}
      {%- else -%}
        <img
          class="sbl-ds-hero__designer-image"
          src="{{ 'sbl-desk-sign-designer-real.png' | asset_url }}"
          alt="{{ section.settings.designer_image_alt | escape }}"
          width="1300"
          height="720"
          loading="eager"
        >
      {%- endif -%}
      {%- if section.settings.image_label != blank -%}
        <span class="sbl-ds-hero__image-label">{{ section.settings.image_label | escape }}</span>
      {%- endif -%}
    </a>
  </div>
</section>

{%- if section.settings.show_steps -%}
  <section class="sbl-ds-steps" id="sbl-ds-steps-{{ section.id }}" aria-label="{{ section.settings.steps_heading | escape }}">
    <div class="sbl-ds-steps__inner">
      <div class="sbl-ds-steps__intro">
        {%- if section.settings.steps_heading != blank -%}
          <h2>{{ section.settings.steps_heading | escape }}</h2>
        {%- endif -%}
        <a href="{{ tool_url }}" class="sbl-ds-steps__link">{{ section.settings.steps_link_label | escape }}</a>
      </div>
      <ol class="sbl-ds-steps__list">
        <li><span>1</span><div><strong>{{ section.settings.step_1_title | escape }}</strong><p>{{ section.settings.step_1_text | escape }}</p></div></li>
        <li><span>2</span><div><strong>{{ section.settings.step_2_title | escape }}</strong><p>{{ section.settings.step_2_text | escape }}</p></div></li>
        <li><span>3</span><div><strong>{{ section.settings.step_3_title | escape }}</strong><p>{{ section.settings.step_3_text | escape }}</p></div></li>
      </ol>
    </div>
  </section>
{%- endif -%}

<style>
  #sbl-ds-hero-{{ section.id }},
  #sbl-ds-steps-{{ section.id }} {
    --ds-navy: {{ section.settings.background_color }};
    --ds-accent: {{ section.settings.accent_color }};
    --ds-btn: {{ section.settings.button_color }};
    --ds-btn-text: {{ section.settings.button_text_color }};
    --ds-white: #fefcf9;
    --ds-max: 1170px;
  }

  #sbl-ds-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: 64px 20px 56px;
    background: var(--ds-navy);
  }
  #sbl-ds-hero-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 65% 85% at 82% 50%, rgba(121, 201, 198, 0.16) 0%, transparent 70%);
    pointer-events: none;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 52px;
    align-items: center;
    max-width: var(--ds-max);
    margin: 0 auto;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__content { min-width: 0; }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__eyebrow {
    margin: 0 0 16px;
    color: var(--ds-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.6px;
    text-transform: uppercase;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__heading {
    margin: 0 0 20px;
    color: var(--ds-white);
    font-size: clamp(32px, 4vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0;
    text-transform: none;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__heading em {
    color: var(--ds-accent);
    font-style: italic;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__sub {
    max-width: 440px;
    margin: 0 0 30px;
    color: rgba(254, 252, 249, 0.75);
    font-size: 16px;
    line-height: 1.7;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 0.15s, border-color 0.2s, background 0.2s;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__btn--primary {
    border: 2px solid var(--ds-btn);
    background: var(--ds-btn);
    color: var(--ds-btn-text);
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__btn--primary:hover {
    transform: translateY(-1px);
    filter: brightness(1.06);
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__btn--ghost {
    border: 1.5px solid rgba(254, 252, 249, 0.35);
    background: transparent;
    color: var(--ds-white);
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__btn--ghost:hover {
    border-color: rgba(254, 252, 249, 0.7);
    background: rgba(254, 252, 249, 0.06);
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid rgba(254, 252, 249, 0.15);
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__stat-val {
    color: var(--ds-accent);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__stat-label {
    margin-top: 2px;
    color: rgba(254, 252, 249, 0.55);
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__designer {
    position: relative;
    display: block;
    overflow: hidden;
    min-width: 0;
    height: 440px;
    border: 10px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: #f3f1ed;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    transition: transform 0.2s;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__designer:hover { transform: translateY(-2px); }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__designer-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__image-label {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 7px 12px;
    border-radius: 6px;
    background: var(--ds-btn);
    color: var(--ds-btn-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  #sbl-ds-steps-{{ section.id }} {
    margin-bottom: 24px;
    padding: 28px 20px;
    border-bottom: 1px solid #e5e9ee;
    background: #f4f7f9;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__inner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: center;
    max-width: var(--ds-max);
    margin: 0 auto;
  }
  #sbl-ds-steps-{{ section.id }} h2 {
    margin: 0 0 6px;
    color: #12263f;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__link {
    color: #0688e2;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__link:hover { text-decoration: underline; }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 0;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list span {
    flex: 0 0 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--ds-navy);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list strong {
    display: block;
    color: #12263f;
    font-size: 15px;
  }
  #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list p {
    margin: 2px 0 0;
    color: #556270;
    font-size: 13px;
    line-height: 1.5;
  }

  @media (max-width: 989px) {
    #sbl-ds-hero-{{ section.id }} { padding: 48px 20px 40px; }
    #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__inner {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__designer { height: min(58vw, 440px); }
    #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__inner {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
  @media (max-width: 640px) {
    #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
    #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__stats { gap: 20px; }
    #sbl-ds-hero-{{ section.id }} .sbl-ds-hero__designer {
      height: 300px;
      border-width: 6px;
    }
    #sbl-ds-steps-{{ section.id }} .sbl-ds-steps__list {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Desk Signs hero",
  "tag": "div",
  "class": "section-desk-signs-collection-hero",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom Desk Sign Designer · Design It Online" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "A desk sign that's<br><em>uniquely yours.</em>" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose acrylic, piano-finished rosewood, or a classic desk sign. Add your wording and see the real design process before ordering."
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Design Your Desk Sign" },
    { "type": "url", "id": "primary_link", "label": "Primary button link", "info": "Defaults to /products/custom-desk-sign" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Shop Desk Signs ↓" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "info": "Defaults to the product grid below the hero" },
    { "type": "header", "content": "Stats" },
    { "type": "checkbox", "id": "show_product_count", "label": "Show collection product count", "default": true },
    { "type": "text", "id": "product_count_label", "label": "Product count label", "default": "Desk signs" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "3" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Material styles" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "Live" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Design process" },
    { "type": "header", "content": "Designer screenshot" },
    { "type": "image_picker", "id": "designer_image", "label": "Designer screenshot", "info": "Leave empty to use the included screenshot of the real desk-sign designer." },
    { "type": "text", "id": "designer_image_alt", "label": "Image alt text", "default": "The real desk sign designer showing acrylic, piano-finished rosewood, and classic materials" },
    { "type": "text", "id": "image_label", "label": "Image label", "default": "Real designer — click to try" },
    { "type": "header", "content": "How it works strip" },
    { "type": "checkbox", "id": "show_steps", "label": "Show steps strip", "default": true },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "Create a desk sign in 3 steps" },
    { "type": "text", "id": "steps_link_label", "label": "Link label", "default": "Open the desk sign designer →" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "Choose material" },
    { "type": "text", "id": "step_1_text", "label": "Step 1 text", "default": "Select acrylic, rosewood, or a classic desk sign." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "Choose size & colors" },
    { "type": "text", "id": "step_2_text", "label": "Step 2 text", "default": "Pick the available dimensions and finish for your material." },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Add your wording" },
    { "type": "text", "id": "step_3_text", "label": "Step 3 text", "default": "Enter your name and title, then add the finished design to your cart." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Hero background", "default": "#12263f" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#79c9c6" },
    { "type": "color", "id": "button_color", "label": "Primary button", "default": "#79c9c6" },
    { "type": "color", "id": "button_text_color", "label": "Primary button text", "default": "#12263f" }
  ]
}
{% endschema %}
