{%- liquid
  assign path = request.path
  assign pen_product = all_products['custom-daxmoor-pen']
  if section.settings.pen_url != blank
    assign pen_url = section.settings.pen_url
  elsif pen_product != blank
    assign pen_url = pen_product.url
  else
    assign pen_url = '/products/custom-daxmoor-pen'
  endif
  assign industry_page = routes.all_products_collection_url | append: '?view=sbl-industries'
  assign catalog_url = routes.all_products_collection_url
  assign search_base = routes.search_url | append: '?type=product&q='
  assign home_popular = routes.root_url | append: '#sbl-popular'
  assign desk_listing = collections['custom-engraved-desk-nameplates'].url | default: '/collections/custom-engraved-desk-nameplates'
  assign awards_listing = collections['awards-and-plaques'].url | default: '/collections/awards-and-plaques'
  assign bulk_listing = pages['bulk-orders'].url | default: '/pages/bulk-orders'

  assign industries_current = false
  if template.suffix == 'sbl-industries'
    assign industries_current = true
  endif
  assign desk_current = false
  if path contains '/products/custom-desk-sign' or collection.handle == 'custom-engraved-desk-nameplates' or collection.handle == 'standard-acrylic-desk-signs' or collection.handle == 'designer-school-student-desk-signs'
    assign desk_current = true
  endif
  assign plaques_current = false
  if collection.handle == 'awards-and-plaques' or collection.handle contains 'awards-plaques-' or path contains '/products/custom-plaque' or path contains '/products/custom-trophy'
    assign plaques_current = true
  endif
  assign bulk_current = false
  if template.suffix == 'bulk-orders' or page.handle == 'bulk-orders' or page.handle == 'bulk'
    assign bulk_current = true
  endif

  assign popular_groups = 'Restroom & hygiene%%sbl:category:restroom-hygiene%%Please Do Not Flush;;Employees Must Wash Hands;;All Gender Restroom;;Restroom@@Safety & compliance%%sbl:category:safety-compliance%%Please Watch Your Step;;Electrical Room;;Electrical Panel;;Fire Sprinkler Riser Room@@Security & surveillance%%sbl:category:security-camera%%Property Under 24hr Video Recording;;Smile You Are On Camera;;No Unauthorized Recording;;Video Surveillance@@Employees only & private%%sbl:category:staff-private%%Employees Only Beyond This Point;;Employees Only;;Staff Only;;Authorized Personnel Only@@Entrance, exit & doors%%sbl:category:entrance-exit%%Exit;;Emergency Exit Only;;Please Knock Before Entering;;Not An Exit@@Retail & customer service%%sbl:category:retail-customer%%We Reserve The Right To Refuse Service;;Please Ring Bell For Assistance;;All Sales Final;;Open Closed@@Office & room ID%%sbl:category:office-door%%Conference Room;;Mail Drop;;Laundry Room;;No Storage Permitted@@Property & no trespassing%%sbl:category:property-notices%%No Soliciting;;Beware Of Dog;;No Trespassing Private Property;;Private Residence@@No smoking%%sbl:category:no-smoking%%No Smoking;;Smoke Free;;No Vaping;;Smoking Area@@Kitchen & break room%%sbl:category:kitchen-break-room%%Break Room;;Kitchen;;Microwave;;Coffee Station@@Do not disturb%%sbl:category:do-not-disturb%%Do Not Disturb;;Please Knock;;Quiet Please;;Session In Progress@@Push & pull%%sbl:category:push-pull%%Push;;Pull;;Push Pull@@Parking & traffic%%sbl:category:parking-traffic%%Reserved Parking;;No Parking;;Tow Away Zone;;Loading Zone@@Waste & recycling%%sbl:category:waste-recycling%%Recycling;;Trash;;Compost;;Garbage@@Accessibility & ADA%%sbl:category:accessibility-ada%%Wheelchair Accessible;;Service Animals Welcome;;Accessible Entrance;;Braille@@Pool, pet & facility%%sbl:category:pool-pet-facility%%Pool Rules;;No Diving;;No Pets;;Locker Room@@Wayfinding%%sbl:category:wayfinding-directory%%You Are Here;;This Way;;Directory;;Other Door@@Door hangers%%sbl:family:door-hanger%%Do Not Disturb;;Please Knock;;Privacy;;Room Service@@Hanging, wall & table%%url:/collections/hanging-wall-table-signs%%Hanging Signs;;Wall Signs;;Table Signs;;Desk Signs@@Novelty%%sbl:category:novelty%%Funny Signs;;Gag Gifts;;Joke Signs@@Social distancing%%sbl:category:social-distancing%%Six Feet Apart;;Face Mask Required;;No Handshake;;Stay Apart'

  assign industry_groups = 'Business & offices%%sbl:industry:business-office%%Conference Room;;Reception;;Suite;;Lobby@@Healthcare%%sbl:industry:healthcare%%Exam Room;;Patients Only;;Laboratory;;Pharmacy@@Care homes & senior living%%sbl:industry:senior-living%%Memory Care;;Assisted Living;;Residents;;Nursing Station@@Therapy & counseling%%sbl:industry:therapy-counseling%%Session In Progress;;Counseling;;Therapy Room;;Please Knock@@Schools%%sbl:industry:education-school%%Principal;;Classroom;;Faculty Lounge;;Library@@Universities & colleges%%sbl:industry:education-university%%Faculty;;Dean;;Lecture Hall;;Campus@@Cafés & coffee shops%%sbl:industry:cafe-coffee%%Order Here;;Barista;;Espresso;;Employees Must Wash Hands@@Restaurants%%sbl:industry:restaurant%%Please Wait To Be Seated;;Host Stand;;No Outside Food;;Menu@@Commercial kitchens%%sbl:industry:commercial-kitchen%%Employees Must Wash Hands;;Food Preparation;;Hair Net;;Dish Room@@Warehouses & industrial%%sbl:industry:warehouse-industrial%%Hard Hat Area;;Loading Dock;;Forklift Traffic;;Receiving@@Government%%sbl:industry:public-safety-government%%City Hall;;Public Safety;;Visitors;;Employees Only@@Police departments%%sbl:industry:police%%Police;;Sheriff;;Precinct;;Authorized Personnel@@Correctional facilities%%sbl:industry:correctional%%Visitation;;Detention;;Authorized Personnel;;No Weapons@@Churches & ministries%%sbl:industry:faith%%Pastor;;Chapel;;Prayer Room;;Fellowship Hall@@Homes & vacation rentals%%sbl:industry:home-rental%%Welcome;;Wifi;;Remove Your Shoes;;Beware Of Dog@@Hotels%%url:' | append: industry_page | append: '#hotels%%Front Desk;;Guest Rooms;;Do Not Disturb;;Housekeeping'

  assign desk_groups = 'Desk nameplates%%sbl:category:desk-nameplates%%Doctor;;Manager;;Receptionist;;Director@@Names & titles%%sbl:category:names-titles%%Principal;;Pastor;;Professor;;Supervisor@@Engraved nameplates%%url:/collections/custom-engraved-desk-nameplates%%Rosewood;;Piano Finish;;Executive;;Reception@@Standard acrylic%%url:/collections/standard-acrylic-desk-signs%%Acrylic Desk Sign;;Classic Desk Sign;;Office Nameplate@@School desk signs%%url:/collections/designer-school-student-desk-signs%%Student;;Teacher;;Principal;;Classroom@@Design your own%%url:/products/custom-desk-sign%%Preview Your Name;;Add A Title;;Choose A Finish'

  assign plaque_groups = 'Plaques%%url:/collections/awards-plaques-plaques%%Employee Of The Month;;Service Award;;Graduation;;Recognition@@Medals%%url:/collections/awards-plaques-medals%%Gold Medal;;Sports Medal;;Academic Medal;;Participation@@Trophies%%q:trophy%%Baseball Trophy;;Soccer Trophy;;Star Trophy;;Team Trophy@@All awards%%sbl:family:plaque-award%%Employee Of The Year;;Achievement;;Coach;;Honor@@Custom plaque%%url:/products/custom-plaque%%Add A Logo;;Add A Name;;Add A Message@@Custom trophy%%url:/products/custom-trophy%%Preview The Award;;Add Engraving;;Team Awards'

  assign bulk_groups = 'Wall & door signs%%url:/products/custom-sign%%One Design, Many Rooms;;Matching Finishes;;Offices And Clinics@@Desk nameplates%%url:/products/custom-desk-sign%%A Name For Every Desk;;Same Finish Across The Office@@Plaques & trophies%%url:/products/custom-plaque%%Ceremony Sets;;Employee Awards;;Team Trophies@@How a quote works%%url:/pages/bulk-orders%%Tell Us The Quantity;;Pricing And Lead Time;;No Commitment'

  assign sign_styles = 'Classic Framed|classic framed;;Designer|designer sign;;Fancy|fancy sign;;Portrait Round|portrait round;;Standard|standard sign;;Basic|basic sign;;Square|square sign;;Circle|circle sign;;Victorian|victorian sign;;Plus Full-Color|full color sign'
  assign desk_finishes = 'Acrylic|acrylic desk sign;;Rosewood|rosewood desk;;Piano finish|piano desk sign;;Classic|classic desk sign'
-%}

<header class="sbl-header" data-sbl-header>
  <button type="button" class="sbl-header__scrim" data-sbl-scrim tabindex="-1" aria-hidden="true"></button>
  <div class="sbl-header__bar">
    <a class="sbl-header__logo" href="{{ routes.root_url }}">
      <span>Signs</span>
      <small>BYLITA</small>
    </a>

    <input class="sbl-header__check" type="checkbox" id="sbl-header-menu-{{ section.id }}">
    <label class="sbl-header__burger" for="sbl-header-menu-{{ section.id }}">
      <span class="sbl-header__visually-hidden">Menu</span>
      <span aria-hidden="true"></span>
    </label>

    <nav class="sbl-header__nav" aria-label="Primary">
      <a class="sbl-header__cta sbl-header__cta--menu" href="/products/custom-sign">
        Design your sign
        <span aria-hidden="true">→</span>
      </a>

      {% render 'sbl-mega-panel',
        summary: 'Popular signs',
        menu_id: 'popular',
        section_id: section.id,
        groups: popular_groups,
        catalog_url: catalog_url,
        search_base: search_base,
        placeholder: 'Search 3,000+ signs',
        cta_title: "Can't find your wording?",
        cta_label: 'Design your own sign',
        cta_url: '/products/custom-sign',
        styles_heading: 'Shop by style',
        styles: sign_styles,
        extra_label: 'Shop popular signs',
        extra_url: home_popular,
        view_all_url: home_popular
      %}
      {% render 'sbl-mega-panel',
        summary: 'Industries',
        menu_id: 'industries',
        section_id: section.id,
        groups: industry_groups,
        catalog_url: catalog_url,
        search_base: search_base,
        current: industries_current,
        placeholder: 'Search industries',
        cta_title: "Don't see your building?",
        cta_label: 'Design your own sign',
        cta_url: '/products/custom-sign',
        extra_label: 'Browse all industries',
        extra_url: industry_page,
        view_all_url: industry_page
      %}
      {% render 'sbl-mega-panel',
        summary: 'Desk signs',
        menu_id: 'desk',
        section_id: section.id,
        groups: desk_groups,
        catalog_url: catalog_url,
        search_base: search_base,
        current: desk_current,
        placeholder: 'Search desk signs',
        cta_title: 'Need a different name?',
        cta_label: 'Design your desk sign',
        cta_url: '/products/custom-desk-sign',
        styles_heading: 'Shop by finish',
        styles: desk_finishes,
        extra_label: 'Design a wall sign instead',
        extra_url: '/products/custom-sign',
        view_all_url: desk_listing
      %}
      {% render 'sbl-mega-panel',
        summary: 'Plaques & awards',
        menu_id: 'plaques',
        section_id: section.id,
        groups: plaque_groups,
        catalog_url: catalog_url,
        search_base: search_base,
        current: plaques_current,
        placeholder: 'Search plaques and awards',
        cta_title: 'Making a set of awards?',
        cta_label: 'Design a plaque',
        cta_url: '/products/custom-plaque',
        extra_label: 'Design a trophy',
        extra_url: '/products/custom-trophy',
        view_all_url: awards_listing
      %}
      {% render 'sbl-mega-panel',
        summary: 'Bulk orders',
        menu_id: 'bulk',
        section_id: section.id,
        groups: bulk_groups,
        catalog_url: catalog_url,
        search_base: search_base,
        current: bulk_current,
        placeholder: 'Search signs for a whole order',
        cta_title: 'Ready for pricing?',
        cta_label: 'Request a quote',
        cta_url: '/pages/bulk-orders#bulk-quote-form',
        extra_label: 'Design one sign first',
        extra_url: '/products/custom-sign',
        view_all_url: bulk_listing
      %}

      <details class="sbl-header__more" data-sbl-drop>
        <summary>More from LITA</summary>
        <div class="sbl-header__more-menu">
          <a href="https://allqualitybadges.com/" target="_blank" rel="noopener">
            <strong>Name badges</strong>
            <span>All Quality Badges · design live in minutes</span>
          </a>
          <a href="https://www.gavelsfast.com/" target="_blank" rel="noopener">
            <strong>Gavels & presentation sets</strong>
            <span>Gavels Fast · personalized gavels</span>
          </a>
          <a href="{{ collections['rubber-stamps'].url }}">
            <strong>Rubber stamps</strong>
            <span>Office, address and date stamps</span>
          </a>
          <a href="https://www.designsbylita.com/" target="_blank" rel="noopener">
            <strong>Home decor & gifts</strong>
            <span>Designs ByLITA · prints, mugs, seasonal</span>
          </a>
          <a href="{{ pen_url }}">
            <strong>Executive pens</strong>
            <span>Daxmoor · corporate gifts</span>
          </a>
        </div>
      </details>
    </nav>

    <div class="sbl-header__tools">
      <form class="sbl-header__searchbar" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16.5L20 20.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <label class="sbl-header__visually-hidden" for="sbl-header-search-{{ section.id }}">Search signs</label>
        <input id="sbl-header-search-{{ section.id }}" type="search" name="q" placeholder="Search signs" autocomplete="off">
        <input type="hidden" name="type" value="product">
      </form>

      <a class="sbl-header__icon" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M5 19.2c1.4-3 3.8-4.4 7-4.4s5.6 1.4 7 4.4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>

      <div data-cart-header-02>
        <a class="sbl-header__icon sbl-header__cart" href="{{ routes.cart_url }}" data-cart-toggle aria-label="Cart">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l-.8 11.2a1 1 0 0 1-1 .8H8.3a1 1 0 0 1-1-.8L6.5 8z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M9 8V6.8A3 3 0 0 1 12 3.8 3 3 0 0 1 15 6.8V8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span data-cart-count>{{ cart.item_count }}</span>
        </a>
      </div>
      <a class="sbl-header__cta sbl-header__cta--bar" href="/products/custom-sign">
        Design your sign
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .sbl-header {
    --sbl-navy: #0f2744;
    --sbl-gold: #c9932e;
    --sbl-header: #f3eee4;
    position: sticky;
    top: 0;
    z-index: 40;
    overflow: visible;
    background: var(--sbl-header);
    color: var(--sbl-navy);
    font-family: Arial, Helvetica, sans-serif;
    border-bottom: 3px solid var(--sbl-gold);
    box-shadow: 0 10px 28px rgba(15, 39, 68, .12);
  }
  .sbl-header * { box-sizing: border-box; }
  .sbl-header__scrim {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 3;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: default;
  }
  .sbl-header:has([data-sbl-drop][open]) .sbl-header__scrim { display: block; }
  .sbl-header__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 28px;
    width: min(1440px, calc(100% - 32px));
    min-height: 74px;
    margin: 0 auto;
  }
  .sbl-header a { color: inherit; text-decoration: none; }
  .sbl-header__logo { display: inline-flex; align-items: baseline; gap: 8px; color: var(--sbl-navy); }
  .sbl-header__logo span { font-family: Georgia, 'Times New Roman', serif; font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1; }
  .sbl-header__logo small { color: #8a6416; font-size: 11px; font-weight: 800; letter-spacing: .2em; }
  .sbl-header input[type="checkbox"].sbl-header__check {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    appearance: none;
    opacity: 0;
    pointer-events: none;
  }
  .sbl-header__burger { display: none; }
  .sbl-header__nav { display: flex; align-items: center; justify-content: center; gap: 24px; min-width: 0; }
  .sbl-header__drop summary,
  .sbl-header__more summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #24344c;
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .sbl-header__drop summary:hover,
  .sbl-header__more summary:hover,
  .sbl-header__drop summary.is-current { color: var(--sbl-navy); }
  .sbl-header__drop summary.is-current { box-shadow: inset 0 -2px 0 var(--sbl-gold); }
  .sbl-header__drop,
  .sbl-header__more { position: static; }
  .sbl-header__more { position: relative; }
  .sbl-header__drop summary,
  .sbl-header__more summary { list-style: none; }
  .sbl-header__drop summary::-webkit-details-marker,
  .sbl-header__more summary::-webkit-details-marker { display: none; }
  .sbl-header__drop summary::after,
  .sbl-header__more summary::after { content: ""; width: 6px; height: 6px; margin-top: -3px; border-right: 1.6px solid currentColor; border-bottom: 1.6px solid currentColor; transform: rotate(45deg); }
  .sbl-header__drop[open] summary,
  .sbl-header__more[open] summary { color: var(--sbl-navy); }
  .sbl-header__drop[open] summary::after,
  .sbl-header__more[open] summary::after { margin-top: 2px; transform: rotate(225deg); }
  .sbl-header__more-menu {
    position: absolute;
    top: calc(100% + 16px);
    right: 0;
    z-index: 5;
    display: grid;
    width: 320px;
    padding: 8px;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 22px 50px rgba(8, 26, 48, .28);
  }
  .sbl-header__more-menu a {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--sbl-navy);
  }
  .sbl-header__more-menu a:hover { background: #f6f1e8; color: var(--sbl-navy); }
  .sbl-header__more-menu strong { font-size: 15px; font-weight: 800; }
  .sbl-header__more-menu span { color: #667085; font-size: 13px; font-weight: 500; line-height: 1.35; }
  .sbl-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 6;
    max-height: min(78vh, 760px);
    overflow: auto;
    background: #fff;
    box-shadow: 0 22px 50px rgba(8, 26, 48, .18);
  }
  .sbl-mega__find {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto;
    padding: 16px 0 8px;
    background: #fff;
  }
  .sbl-mega__find svg { width: 18px; height: 18px; color: #667085; flex: none; }
  .sbl-mega__find input[type="search"] {
    width: min(420px, 100%);
    height: 42px;
    padding: 0 14px;
    border: 1px solid #e4ddd1;
    border-radius: 999px;
    color: var(--sbl-navy);
    font: inherit;
    font-size: 15px;
  }
  .sbl-mega__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 28px;
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto;
    padding: 8px 0 28px;
  }
  .sbl-mega__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px 26px; align-content: start; }
  .sbl-mega__group { display: grid; align-content: start; gap: 2px; }
  .sbl-header .sbl-mega__group a { color: #24344c; font-size: 14.5px; font-weight: 500; line-height: 1.45; }
  .sbl-header .sbl-mega__group a:hover { color: var(--sbl-navy); }
  .sbl-header .sbl-mega__group a.sbl-mega__title { margin-bottom: 6px; color: #8a6416; font-size: 14px; font-weight: 800; line-height: 1.3; }
  .sbl-header .sbl-mega__group a.sbl-mega__all { margin-top: 6px; color: var(--sbl-gold); font-size: 13.5px; font-weight: 800; }
  .sbl-header .sbl-mega__group a.sbl-mega__all:hover { color: #8a6416; }
  .sbl-mega__rail { position: sticky; top: 66px; align-self: start; display: grid; gap: 14px; }
  .sbl-mega__styles p { margin: 0 0 10px; color: #8a6416; font-size: 14px; font-weight: 800; }
  .sbl-mega__styles div { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 16px; }
  .sbl-mega__style { color: #24344c; font-size: 14.5px; font-weight: 600; }
  .sbl-mega__style:hover { color: var(--sbl-navy); }
  .sbl-header .sbl-mega__own {
    display: grid;
    gap: 14px;
    padding: 18px 16px;
    border-radius: 16px;
    background: #1c2430;
    color: #fff;
  }
  .sbl-header .sbl-mega__own:hover { color: #fff; }
  .sbl-mega__own-kicker { font-size: 18px; font-weight: 700; line-height: 1.3; }
  .sbl-header .sbl-mega__own-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 8px;
    background: var(--sbl-gold);
    color: #1c2430;
    font-size: 15px;
    font-weight: 800;
  }
  .sbl-header .sbl-mega__extra { color: var(--sbl-gold); font-size: 14px; font-weight: 800; }
  .sbl-header .sbl-mega__extra:hover { color: #8a6416; }
  .sbl-mega__empty {
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto 22px;
    color: #667085;
    font-size: 14px;
  }
  .sbl-mega__empty button {
    margin-left: 8px;
    border: 0;
    background: transparent;
    color: var(--sbl-navy);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .sbl-mega a[hidden],
  .sbl-mega__group[hidden],
  .sbl-mega__empty[hidden] { display: none; }
  .sbl-header__tools { display: flex; align-items: center; gap: 4px; }
  .sbl-header__searchbar {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 156px;
    height: 40px;
    margin-right: 4px;
    padding: 0 12px;
    border: 1px solid #e4ddd1;
    border-radius: 999px;
    background: #fff;
  }
  .sbl-header__searchbar svg { width: 16px; height: 16px; color: #667085; flex: none; }
  .sbl-header__searchbar input[type="search"] {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sbl-navy);
    font: inherit;
    font-size: 13px;
  }
  .sbl-header a.sbl-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 12px;
    border-radius: 6px;
    background: var(--sbl-gold);
    color: var(--sbl-navy);
    font-size: 14.5px;
    font-weight: 800;
    white-space: nowrap;
  }
  .sbl-header a.sbl-header__cta:hover { background: #dba849; color: var(--sbl-navy); }
  .sbl-header a.sbl-header__cta--menu { display: none; }
  .sbl-header a.sbl-header__cta--bar { margin-left: 6px; }
  .sbl-header__icon {
    display: inline-flex;
    width: 38px;
    height: 38px;
