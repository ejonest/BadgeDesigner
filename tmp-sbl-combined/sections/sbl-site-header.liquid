{% javascript %}
  (() => {
    const header = document.querySelector('[data-sbl-header]');
    if (!header || header.dataset.sblNavReady === 'true') return;
    header.dataset.sblNavReady = 'true';
    const drops = Array.from(header.querySelectorAll('[data-sbl-drop]'));

    drops.forEach((drop) => {
      const summary = drop.querySelector('summary');
      const viewAll = drop.dataset.sblViewAll;
      if (summary && viewAll) {
        summary.addEventListener('click', (event) => {
          if (!drop.open) return;
          event.preventDefault();
          window.location.assign(viewAll);
        });
      }
      drop.addEventListener('toggle', () => {
        if (!drop.open) return;
        drops.forEach((other) => {
          if (other !== drop) other.open = false;
        });
      });
    });

    const closeOutside = (event) => {
      const path = typeof event.composedPath === 'function' ? event.composedPath() : [];
      const target = event.target;
      drops.forEach((drop) => {
        if (!drop.open) return;
        const inside = path.length ? path.includes(drop) : target instanceof Node && drop.contains(target);
        if (!inside) drop.open = false;
      });
    };
    document.addEventListener('click', closeOutside, true);
    window.addEventListener('blur', () => {
      drops.forEach((drop) => { drop.open = false; });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      drops.forEach((drop) => { drop.open = false; });
    });

    header.querySelectorAll('[data-sbl-mega]').forEach((panel) => {
      const input = panel.querySelector('[data-sbl-mega-filter]');
      const empty = panel.querySelector('[data-sbl-empty]');
      if (!input) return;
      const apply = () => {
        const query = input.value.trim().toLowerCase();
        panel.querySelectorAll('[data-sbl-group]').forEach((group) => {
          const title = (group.dataset.sblGroup || '').toLowerCase();
          const titleHit = query !== '' && title.includes(query);
          let any = titleHit;
          group.querySelectorAll('[data-sbl-item]').forEach((link) => {
            const hit = query === '' || titleHit || link.textContent.toLowerCase().includes(query);
            link.hidden = !hit;
            if (hit) any = true;
          });
          group.hidden = query !== '' && !any;
        });
        panel.querySelectorAll('[data-sbl-style]').forEach((link) => {
          link.hidden = query !== '' && !link.textContent.toLowerCase().includes(query);
        });
        if (!empty) return;
        const groups = Array.from(panel.querySelectorAll('[data-sbl-group]'));
        const styles = Array.from(panel.querySelectorAll('[data-sbl-style]'));
        const visibleGroup = groups.some((group) => !group.hidden);
        const visibleStyle = styles.length === 0 || styles.some((link) => !link.hidden);
        empty.hidden = !(query && !visibleGroup && !visibleStyle);
      };
      input.addEventListener('input', apply);
    });
  })();
{% endjavascript %}

