{% javascript %}
  (() => {
    document.querySelectorAll('[data-sbl-spaces]').forEach((root) => {
      if (root.dataset.sblSpacesReady === 'true') return;
      root.dataset.sblSpacesReady = 'true';
      const viewer = root.querySelector('[data-sbl-viewer]');
      const image = root.querySelector('[data-sbl-viewer-image]');
      const caption = root.querySelector('[data-sbl-viewer-caption]');
      const close = root.querySelector('[data-sbl-viewer-close]');
      if (!viewer || !image || typeof viewer.showModal !== 'function') return;
      root.querySelectorAll('[data-sbl-space]').forEach((button) => {
        button.addEventListener('click', () => {
          const photo = button.querySelector('img');
          if (!photo) return;
          image.src = photo.currentSrc || photo.src;
          image.alt = button.dataset.caption || photo.alt;
          image.width = photo.naturalWidth || photo.width;
          image.height = photo.naturalHeight || photo.height;
          if (caption) caption.textContent = button.dataset.caption || '';
          viewer.showModal();
        });
      });
      if (close) close.addEventListener('click', () => viewer.close());
      viewer.addEventListener('click', (event) => {
        if (event.target === viewer) viewer.close();
      });
    });
  })();

  (() => {
    document.querySelectorAll('[data-sbl-ind]').forEach((section) => {
      if (section.dataset.sblIndReady === 'true') return;
      section.dataset.sblIndReady = 'true';
      const input = section.querySelector('[data-sbl-ind-filter]');
      const empty = section.querySelector('[data-sbl-ind-empty]');
      const cards = Array.from(section.querySelectorAll('[data-sbl-ind-card]'));
      if (!input) return;
      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach((card) => {
          const hit = query === '' || card.dataset.keywords.includes(query);
          card.hidden = !hit;
          if (hit) visible += 1;
        });
        if (empty) empty.hidden = visible > 0;
      });
    });
  })();

  (() => {
    const roots = document.querySelectorAll('[data-sbl-home]');
    roots.forEach((root) => {
      if (root.dataset.sblReady === 'true') return;
      root.dataset.sblReady = 'true';
      const rotator = root.querySelector('[data-sbl-rotator-label]');
      const toggle = root.querySelector('[data-sbl-rotator]');
      const menu = root.querySelector('[data-sbl-menu]');
      const cardWord = root.querySelector('[data-sbl-card-word]');
      const links = Array.from(root.querySelectorAll('[data-sbl-slide-link]'));
      const slides = Array.from(root.querySelectorAll('[data-sbl-slide]'));
      const card = root.querySelector('.sbl-home__designer-card');
      if (!rotator || links.length === 0) return;

      let index = 0;
      let paused = false;
      let menuOpen = false;
      const setMenu = (open) => {
        menuOpen = open;
        paused = open;
        if (!menu || !toggle) return;
        menu.hidden = !open;
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const show = (next) => {
        index = next;
        const word = links[index].textContent.trim();
        rotator.textContent = word;
        if (cardWord) cardWord.textContent = word;
        links.forEach((link, i) => link.setAttribute('aria-current', i === index ? 'true' : 'false'));
        slides.forEach((slide) => {
          slide.dataset.active = String(Number(slide.dataset.sblSlide) === index);
        });
      };
      show(0);

      if (toggle && menu) {
        toggle.addEventListener('click', () => setMenu(!menuOpen));
        const close = root.querySelector('[data-sbl-menu-close]');
        if (close) close.addEventListener('click', () => setMenu(false));
        document.addEventListener('click', (event) => {
          if (menuOpen && !root.querySelector('.sbl-home__picker').contains(event.target)) setMenu(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menuOpen) setMenu(false);
        });
        menu.addEventListener('mouseenter', () => { paused = true; });
        menu.addEventListener('mouseleave', () => { if (!menuOpen) paused = false; });
      }

      links.forEach((link, i) => {
        link.addEventListener('mouseenter', () => { paused = true; show(i); });
        link.addEventListener('focus', () => { paused = true; show(i); });
        link.addEventListener('mouseleave', () => { if (!menuOpen) paused = false; });
        link.addEventListener('blur', () => { if (!menuOpen) paused = false; });
      });
      if (card) {
        card.addEventListener('mouseenter', () => { paused = true; });
        card.addEventListener('mouseleave', () => { if (!menuOpen) paused = false; });
      }

      if (links.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      window.setInterval(() => {
        if (!paused) show((index + 1) % links.length);
      }, 2800);
    });
  })();
{% endjavascript %}

