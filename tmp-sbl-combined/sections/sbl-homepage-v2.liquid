    .sbl-home__trophy .sbl-home__plaque-grid { grid-template-columns: 1fr; }
    .sbl-home__trophy .sbl-home__plaque-image { order: -1; }
    .sbl-home__hero-grid { gap: 44px; }
    .sbl-home__designer-card { width: min(620px, 100%); margin: 0 auto; }
    .sbl-home__category-grid,
    .sbl-home__product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sbl-home__industry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sbl-home__proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
