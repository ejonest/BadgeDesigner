  .sbl-home__trophy { background: var(--sbl-cream); color: var(--sbl-ink); }
  .sbl-home__trophy .sbl-home__plaque-grid { grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr); }
  .sbl-home .sbl-home__trophy h2 { color: var(--sbl-navy); }
  .sbl-home__trophy .sbl-home__plaque-grid > div > p:not(.sbl-home__section-label) { color: var(--sbl-muted); }
  .sbl-home__trophy .sbl-home__plaque-image img { height: 420px; }
  @media (max-width: 990px) {
