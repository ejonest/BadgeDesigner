  .sbl-home__product-copy span { color: var(--sbl-gold); font-weight: 800; }
  .sbl-home__industry-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .sbl-home__industry-card { position: relative; display: block; overflow: hidden; min-height: 260px; border-radius: 12px; color: #fff; text-decoration: none; }
  .sbl-home__industry-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .sbl-home__industry-card:hover img { transform: scale(1.045); }
  .sbl-home__industry-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(8,26,48,.08), rgba(8,26,48,.92)); }
  .sbl-home__industry-copy { position: absolute; inset: auto 0 0; display: flex; padding: 24px; flex-direction: column; color: #fff; }
  .sbl-home__industry-copy strong { font-family: Georgia, 'Times New Roman', serif; font-size: 25px; font-weight: 500; }
  .sbl-home__industry-copy small { margin-top: 4px; color: #d4deeb; font-size: 13px; line-height: 1.4; }
  .sbl-home__industry-copy b { margin-top: 12px; color: #f2cf78; font-size: 13px; }
  .sbl-home__bulk,
  .sbl-home__plaque-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .85fr); gap: 70px; align-items: center; }
  .sbl-home__bulk-copy > p:not(.sbl-home__section-label),
