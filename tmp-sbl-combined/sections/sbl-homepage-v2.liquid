    .sbl-home__hero { padding: 48px 0 70px; }
    .sbl-home__hero-title { font-size: 43px; }
    .sbl-home__hero-text { font-size: 16px; }
    .sbl-home__start { align-items: stretch; flex-direction: column; }
    .sbl-home__start-copy { padding: 8px; }
    .sbl-home__designer-image-wrap { height: 390px; }
    .sbl-home__search { flex-wrap: wrap; }
    .sbl-home__search button { width: 100%; min-height: 48px; }
    .sbl-home__proof-grid,
    .sbl-home__category-grid,
    .sbl-home__product-grid,
    .sbl-home__industry-grid { grid-template-columns: 1fr; }
    .sbl-home__heading-row { align-items: start; flex-direction: column; }
    .sbl-home__section { padding: 60px 0; }
    .sbl-home__category-image,
    .sbl-home__product-image { height: 250px; }
    .sbl-home__industry-card { min-height: 290px; }
    .sbl-home__actions { align-items: stretch; flex-direction: column; }
    .sbl-home__text-link { text-align: center; }
    .sbl-home__plaque-image img,
    .sbl-home__trophy .sbl-home__plaque-image img { height: 280px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sbl-home__category-card,
    .sbl-home__product-card,
    .sbl-home__designer-card,
    .sbl-home img { transition: none !important; }
    .sbl-home__designer-card:hover,
    .sbl-home__designer-card:focus-visible { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const roots = document.querySelectorAll('[data-sbl-home]');
    roots.forEach((root) => {
      if (root.dataset.sblReady === 'true') return;
      root.dataset.sblReady = 'true';
      const rotator = root.querySelector('[data-sbl-rotator-label]');
      const cardWord = root.querySelector('[data-sbl-card-word]');
      const links = Array.from(root.querySelectorAll('[data-sbl-slide-link]'));
      const slides = Array.from(root.querySelectorAll('[data-sbl-slide]'));
      const card = root.querySelector('.sbl-home__designer-card');
      if (!rotator || links.length === 0) return;

      let index = 0;
      let paused = false;
      const show = (next) => {
        index = next;
        const word = links[index].textContent.trim();
        rotator.textContent = word;
        if (cardWord) cardWord.textContent = word;
        links.forEach((link, i) => link.setAttribute('aria-current', i === index ? 'true' : 'false'));
        slides.forEach((slide) => {
          slide.dataset.active = String(Number(slide.dataset.sblSlide) === index);
        });
      };
      show(0);

      links.forEach((link, i) => {
        link.addEventListener('mouseenter', () => { paused = true; show(i); });
        link.addEventListener('focus', () => { paused = true; show(i); });
        link.addEventListener('mouseleave', () => { paused = false; });
        link.addEventListener('blur', () => { paused = false; });
      });
      if (card) {
        card.addEventListener('mouseenter', () => { paused = true; });
        card.addEventListener('mouseleave', () => { paused = false; });
      }

      if (links.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      window.setInterval(() => {
        if (!paused) show((index + 1) % links.length);
      }, 2800);
    });
  })();
{% endjavascript %}

