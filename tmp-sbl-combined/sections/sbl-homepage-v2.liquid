  .sbl-home__bulk-image img { display: block; width: 100%; max-height: 520px; object-fit: cover; object-position: center 45%; }
  .sbl-home__plaque { padding: 82px 0; background: var(--sbl-navy-dark); color: #fff; }
  .sbl-home__plaque-grid { grid-template-columns: minmax(360px, .9fr) minmax(0, 1fr); }
  .sbl-home__plaque-image img { display: block; width: 100%; height: 390px; object-fit: cover; object-position: center; }
