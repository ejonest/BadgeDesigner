{%- liquid
  assign designer_url = section.settings.designer_url | default: '/products/custom-sign'
  assign bulk_url = section.settings.bulk_url | default: '/pages/bulk-orders'
  assign industry_page = routes.all_products_collection_url | append: '?view=sbl-industries'
  assign featured_collection = collections[section.settings.featured_collection]
-%}

<section id="sbl-home-{{ section.id }}" class="sbl-home" data-sbl-home>
  <div class="sbl-home__hero">
    <div class="sbl-home__hero-grid">
      <div class="sbl-home__hero-copy">
        <p class="sbl-home__eyebrow sbl-home__eyebrow--live">
          <span class="sbl-home__live-dot" aria-hidden="true"></span>
          {{ section.settings.hero_eyebrow | escape }}
        </p>
        <h1 class="sbl-home__hero-title">
          <strong>{{ section.settings.hero_heading | escape }}</strong><br>
          {{ section.settings.hero_subheading | escape }}
        </h1>
        <p class="sbl-home__hero-accent">{{ section.settings.hero_accent | escape }}</p>
        <p class="sbl-home__hero-text">{{ section.settings.hero_text | escape }}</p>
        <div class="sbl-home__hero-trust">
          <p>10+ years making signs <span aria-hidden="true">·</span> <strong>Over 1 million signs sold across the USA</strong></p>
          <p class="sbl-home__hero-reviews">
            <span class="sbl-home__stars" aria-hidden="true">★★★★★</span>
            <span>Thousands of 5-star reviews</span>
          </p>
        </div>
      </div>

      <div class="sbl-home__hero-art">
        <img
          class="sbl-home__hero-photo"
          src="{{ 'sbl-hero-sign-range.jpg' | asset_url }}"
          alt="Personalized office signs in blue, black, white, red, gold, brushed silver and woodgrain finishes"
          width="1024"
          height="640"
          loading="eager"
        >
      </div>
      <div class="sbl-home__hero-actions">
        <a href="{{ designer_url }}" class="sbl-home__button sbl-home__button--gold sbl-home__button--hero">
          {{ section.settings.designer_button | escape }}
          <span aria-hidden="true">→</span>
        </a>
        <a href="#sbl-popular" class="sbl-home__button sbl-home__button--outline">
          {{ section.settings.shop_button | escape }}
        </a>
      </div>
    </div>
  </div>

  <div class="sbl-home__search-wrap">
    <div class="sbl-home__wrap">
      <form class="sbl-home__search" action="{{ routes.search_url }}" method="get" role="search">
        <span class="sbl-home__search-icon" aria-hidden="true">⌕</span>
        <label class="sbl-home__visually-hidden" for="sbl-home-search-{{ section.id }}">
          {{ section.settings.search_placeholder | escape }}
        </label>
        <input
          id="sbl-home-search-{{ section.id }}"
          type="search"
          name="q"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit">Search</button>
      </form>
    </div>
  </div>

  <div class="sbl-home__benefits">
    <div class="sbl-home__wrap sbl-home__benefits-grid">
      <div class="sbl-home__benefit">
        <span class="sbl-home__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 4v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
        </span>
        <div><strong>Free US shipping</strong><span>On every order, to your door</span></div>
      </div>
      <div class="sbl-home__benefit">
        <span class="sbl-home__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg>
        </span>
        <div><strong>Shipped fast</strong><span>Most orders ship within 48 hours</span></div>
      </div>
      <div class="sbl-home__benefit">
        <span class="sbl-home__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m5 16-1 5 5-1L20 9l-4-4L5 16ZM14 7l4 4"/></svg>
        </span>
        <div><strong>Made your way</strong><span>Your wording, colors and size</span></div>
      </div>
      <div class="sbl-home__benefit">
        <span class="sbl-home__benefit-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 21V4h14v17M9 8h2m2 0h2M9 12h2m2 0h2M10 21v-5h4v5"/></svg>
        </span>
        <div><strong>Bulk made easy</strong><span>From one sign to a whole building</span></div>
      </div>
    </div>
  </div>

  {%- liquid
    assign retail_url = collections['general-business-signs'].url | default: ''
    if retail_url == ''
      assign retail_url = industry_page | append: '#offices'
    endif
    assign industry_cards = 'office%%Offices & Businesses%%From the front desk to the meeting room.%%office business corporate conference reception suite%%#offices@@school%%Schools & Universities%%Clear directions for every campus.%%school university college education classroom faculty%%#schools@@church%%Churches & Congregations%%A welcoming place for your community.%%church congregation religious worship pastor ministry%%#churches@@restaurant%%Restaurants & Cafés%%Make every visit feel effortless.%%restaurant cafe café food dining coffee kitchen hospitality%%#restaurants@@clinic%%Medical & Dental%%Help patients find their way.%%medical dental clinic hospital healthcare doctor exam%%#clinics@@warehouse%%Warehouses & Facilities%%Keep busy spaces clearly marked.%%warehouse facility industrial factory safety storage%%#offices@@retail%%Retail & Shops%%Set the tone from the door onward.%%retail shop store boutique shopping%%' | append: retail_url | append: '@@hotel%%Hotels & Property%%Thoughtful details for shared spaces.%%hotel property management apartment residential rental real estate%%#hotels'
    assign industry_cards = industry_cards | split: '@@'
  -%}
  <div class="sbl-home__ind" id="sbl-industries" data-sbl-ind>
    <div class="sbl-home__wrap">
      <div class="sbl-home__ind-head">
        <div>
          <p class="sbl-home__section-label">Made for the way you work</p>
          <h2>Find signs for your industry.</h2>
          <p>From a single door to a whole building, make every space feel considered.</p>
        </div>
        <label class="sbl-home__ind-search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 6 6"/></svg>
          <span class="sbl-home__visually-hidden">Find your industry</span>
          <input type="search" placeholder="Find your industry…" autocomplete="off" data-sbl-ind-filter>
        </label>
      </div>
      <div class="sbl-home__ind-grid">
        {%- for row in industry_cards -%}
          {%- assign parts = row | split: '%%' -%}
          {%- assign card_url = parts[4] -%}
          {%- assign url_start = card_url | slice: 0 -%}
          {%- if url_start == '#' -%}
            {%- assign card_url = industry_page | append: card_url -%}
          {%- endif -%}
          <a class="sbl-home__ind-card" href="{{ card_url }}" data-sbl-ind-card data-keywords="{{ parts[1] | downcase | escape }} {{ parts[3] }}">
            <span class="sbl-home__ind-art">{% render 'sbl-industry-icon', name: parts[0] %}</span>
            <span class="sbl-home__ind-name">{{ parts[1] }}</span>
            <span class="sbl-home__ind-text">{{ parts[2] }}</span>
            <span class="sbl-home__ind-link">Explore sign ideas <span aria-hidden="true">↗</span></span>
          </a>
        {%- endfor -%}
      </div>
      <p class="sbl-home__ind-empty" role="status" hidden data-sbl-ind-empty>No matching industries. Try “office”, “church”, “retail” or “medical”.</p>
      <p class="sbl-home__ind-help">
        <span>Don’t see your industry? Your sign can say anything.</span>
        <a href="{{ designer_url }}">Create a custom sign →</a>
      </p>
    </div>
  </div>

  <div class="sbl-home__spaces" id="sbl-real-signs" data-sbl-spaces>
    <div class="sbl-home__wrap">
      <div class="sbl-home__spaces-head">
        <div>
          <p class="sbl-home__section-label">The details that make a place</p>
          <h2>Real signs. Real spaces.</h2>
          <p>See the finishing touches in real spaces. Select a photo to take a closer look.</p>
        </div>
        <span class="sbl-home__spaces-label">Signs in everyday spaces</span>
      </div>
      <div class="sbl-home__spaces-grid">
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Decorative signs on a wall">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-welcome.jpg' | asset_url }}" alt="Green Hello sign, burgundy Garden Room plaque, and gold custom sign on a textured wall" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>A personal welcome</strong><small>Decorative signs on a wall</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Restroom sign on a door">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-restroom.jpg' | asset_url }}" alt="Brushed gold restroom sign with an arrow on a navy door" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Easy to find</strong><small>Restroom sign on a door</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Private property sign on a gate">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-property.jpg' | asset_url }}" alt="Wood private property sign on a green gate beside house number 128" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>A clear boundary</strong><small>Private property sign on a gate</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Video surveillance sign at an entrance">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-surveillance.jpg' | asset_url }}" alt="Notice sign for 24 hour video surveillance mounted on a brick wall" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>A little peace of mind</strong><small>Video surveillance sign at an entrance</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Conference room and main office signs">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-office.jpg' | asset_url }}" alt="Brushed metal conference room sign beside a main office sign on a wood door" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Set the tone</strong><small>Conference room and main office</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Push and pull signs on glass doors">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-push-pull.jpg' | asset_url }}" alt="Gold push and pull signs on glass entry doors" width="1000" height="1000" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Every detail covered</strong><small>Push and pull signs on glass doors</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Classroom and library signs">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-classroom.jpg' | asset_url }}" alt="Classroom 12 sign on a blue door beside a gold library plaque" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Find the room</strong><small>Classroom and library signs</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Clinic signs at the door">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-clinic.jpg' | asset_url }}" alt="Family Care sign and please check in sign on a clinic wall" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>A calm arrival</strong><small>Clinic signs at the door</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Nurses' station and staff only signs">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-nurses.jpg' | asset_url }}" alt="Nurses' station sign above a staff only sign outside a clinic hallway" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Clear for the team</strong><small>Nurses’ station and staff only</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Reception and meeting room directions">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-wayfinding.jpg' | asset_url }}" alt="Directional signs for reception and meeting rooms on an office wall" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Point the way</strong><small>Reception and meeting rooms</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="House number and private property sign">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-gate.jpg' | asset_url }}" alt="Private property sign on a black gate beside gold house number 24" width="1600" height="703" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>At the gate</strong><small>House number and private property</small></span>
        </button>
        <button type="button" class="sbl-home__space" data-sbl-space data-caption="Security sign on a fence">
          <span class="sbl-home__space-image">
            <img src="{{ 'sbl-space-monitored.jpg' | asset_url }}" alt="Blue this property is monitored sign on a chain-link fence" width="1254" height="1254" loading="lazy">
            <span class="sbl-home__space-expand" aria-hidden="true">↗</span>
          </span>
          <span class="sbl-home__space-copy"><strong>Watched from the street</strong><small>Security sign on a fence</small></span>
        </button>
      </div>
    </div>
    <dialog class="sbl-home__viewer" data-sbl-viewer aria-label="Photo">
      <div class="sbl-home__viewer-head">
        <p data-sbl-viewer-caption></p>
        <button type="button" data-sbl-viewer-close aria-label="Close photo">×</button>
      </div>
      <img data-sbl-viewer-image alt="" width="1254" height="1254">
    </dialog>
  </div>

  <div class="sbl-home__section sbl-home__section--cream" id="sbl-popular">
    <div class="sbl-home__wrap">
      <div class="sbl-home__heading-row">
        <div>
          <p class="sbl-home__section-label">{{ section.settings.categories_label | escape }}</p>
          <h2>{{ section.settings.categories_heading | escape }}</h2>
        </div>
        <a href="{{ routes.all_products_collection_url }}">{{ section.settings.categories_link | escape }} →</a>
      </div>

      <div class="sbl-home__category-grid">
        {%- assign form_collection = collections['hanging-wall-table-signs'] -%}
        {%- if form_collection != blank and form_collection.products_count > 0 -%}
          {%- assign form_product = form_collection.products.first -%}
          <a href="{{ form_collection.url }}" class="sbl-home__category-card">
            <div class="sbl-home__category-image">
              {%- if form_product.featured_image -%}
                {{
                  form_product.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 800',
                    sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                    alt: form_product.featured_image.alt
                }}
              {%- endif -%}
            </div>
            <div class="sbl-home__category-copy">
              <h3>Hanging, wall &amp; table</h3>
              <p>Hanging signs, wall signs, table signs and desk signs</p>
              <span>Shop these signs →</span>
            </div>
          </a>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'category' -%}
            {%- assign category_collection = collections[block.settings.collection] -%}
            {%- assign category_product = category_collection.products | first -%}
            <a
              href="{{ category_collection.url | default: routes.all_products_collection_url }}"
              class="sbl-home__category-card"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.product != blank -%}
                {%- assign category_product = block.settings.product -%}
              {%- endif -%}
              <div class="sbl-home__category-image">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                      alt: block.settings.title
                  }}
                {%- elsif category_product.featured_image -%}
                  {{
                    category_product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800',
                      sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                      alt: category_product.featured_image.alt
                  }}
                {%- endif -%}
              </div>
              <div class="sbl-home__category-copy">
                <h3>{{ block.settings.title | default: category_collection.title | escape }}</h3>
                <p>{{ block.settings.subtitle | escape }}</p>
                <span>{{ block.settings.link_label | escape }} →</span>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <form class="sbl-home__search sbl-home__search--repeat" action="{{ routes.search_url }}" method="get" role="search">
        <span class="sbl-home__search-icon" aria-hidden="true">⌕</span>
        <label class="sbl-home__visually-hidden" for="sbl-home-search-popular-{{ section.id }}">
          Search signs by wording
        </label>
        <input
          id="sbl-home-search-popular-{{ section.id }}"
          type="search"
          name="q"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          autocomplete="off"
        >
        <input type="hidden" name="type" value="product">
        <button type="submit">Search</button>
      </form>
    </div>
  </div>

  {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
    <div class="sbl-home__section sbl-home__section--white">
      <div class="sbl-home__wrap">
        <div class="sbl-home__heading-row">
          <div>
            <p class="sbl-home__section-label">{{ section.settings.products_label | escape }}</p>
            <h2>{{ section.settings.products_heading | escape }}</h2>
          </div>
          <a href="{{ featured_collection.url }}">{{ section.settings.products_link | escape }} →</a>
        </div>
        <div class="sbl-home__product-grid">
          {%- for featured_product in featured_collection.products limit: 8 -%}
            <a class="sbl-home__product-card" href="{{ featured_product.url }}">
              <div class="sbl-home__product-image">
                {%- if featured_product.featured_image -%}
                  {{
                    featured_product.featured_image
                    | image_url: width: 720
                    | image_tag:
                      loading: 'lazy',
                      widths: '280, 420, 560, 720',
                      sizes: '(min-width: 990px) 25vw, (min-width: 600px) 50vw, 100vw',
                      alt: featured_product.featured_image.alt
                  }}
                {%- endif -%}
              </div>
              <div class="sbl-home__product-copy">
                <h3>{{ featured_product.title | escape }}</h3>
                <span>{{ featured_product.price | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="sbl-home__section sbl-home__section--cream" id="sbl-bulk">
    <div class="sbl-home__wrap sbl-home__bulk">
      <div class="sbl-home__bulk-copy">
        <p class="sbl-home__section-label">{{ section.settings.bulk_label | escape }}</p>
        <h2>{{ section.settings.bulk_heading | escape }}</h2>
        <p>{{ section.settings.bulk_text | escape }}</p>
        <ul>
          <li>✓ {{ section.settings.bulk_point_one | escape }}</li>
          <li>✓ {{ section.settings.bulk_point_two | escape }}</li>
          <li>✓ {{ section.settings.bulk_point_three | escape }}</li>
        </ul>
        <div class="sbl-home__actions">
          <a href="{{ bulk_url }}" class="sbl-home__button sbl-home__button--navy">
            {{ section.settings.bulk_button | escape }} →
          </a>
          <a href="{{ designer_url }}" class="sbl-home__text-link">{{ section.settings.bulk_secondary | escape }}</a>
        </div>
      </div>
      <a class="sbl-home__bulk-image" href="{{ bulk_url }}">
        <img
          src="{{ 'sbl-sign-designer-real.png' | asset_url }}"
          alt="{{ section.settings.bulk_image_alt | escape }}"
          width="780"
          height="1024"
          loading="lazy"
        >
      </a>
    </div>
  </div>

  <div class="sbl-home__plaque">
    <div class="sbl-home__wrap sbl-home__plaque-grid">
      <a class="sbl-home__plaque-image" href="{{ section.settings.plaque_url }}">
        <img
          src="{{ 'sbl-plaque-designer-shot.jpg' | asset_url }}"
          alt="{{ section.settings.plaque_image_alt | escape }}"
          width="1600"
          height="835"
          loading="lazy"
        >
      </a>
      <div>
        <p class="sbl-home__section-label">{{ section.settings.plaque_label | escape }}</p>
        <h2>{{ section.settings.plaque_heading | escape }}</h2>
        <p>{{ section.settings.plaque_text | escape }}</p>
        <a href="{{ section.settings.plaque_url }}" class="sbl-home__button sbl-home__button--gold">
          {{ section.settings.plaque_button | escape }} →
        </a>
      </div>
    </div>
  </div>

  {%- assign trophy_url = section.settings.trophy_url | default: '/products/custom-trophy' -%}
  <div class="sbl-home__plaque sbl-home__trophy">
    <div class="sbl-home__wrap sbl-home__plaque-grid">
      <div>
        <p class="sbl-home__section-label">Trophies & awards</p>
        <h2>{{ section.settings.trophy_heading | escape }}</h2>
        <p>Pick a trophy style, add your logo and engraving, and see the finished award before you order.</p>
        <a href="{{ trophy_url }}" class="sbl-home__button sbl-home__button--gold">
          Design a trophy →
        </a>
      </div>
      <a class="sbl-home__plaque-image" href="{{ trophy_url }}">
        <img
          src="{{ 'sbl-trophy-designer-shot.jpg' | asset_url }}"
          alt="Signs ByLITA trophy designer showing a personalized award trophy"
          width="1600"
          height="1070"
          loading="lazy"
        >
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .sbl-home {
    --sbl-navy: #0f2744;
    --sbl-navy-dark: #081a30;
    --sbl-gold: #c9932e;
    --sbl-cream: #f5f1eb;
