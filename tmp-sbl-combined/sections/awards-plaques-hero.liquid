{%- comment -%}
  Awards & Plaques hero: spotlights the plaque and trophy designers above the combined
  awards collection grid. Rendered by templates/collection.liquid for awards-and-plaques only.
{%- endcomment -%}

{%- liquid
  assign plaque_product = all_products[section.settings.plaque_product_handle]
  assign trophy_product = all_products[section.settings.trophy_product_handle]

  assign plaque_url = section.settings.plaque_link
  if plaque_url == blank and plaque_product != blank
    assign plaque_url = plaque_product.url
  endif
  if plaque_url == blank
    assign plaque_url = '/products/custom-plaque'
  endif

  assign trophy_url = section.settings.trophy_link
  if trophy_url == blank and trophy_product != blank
    assign trophy_url = trophy_product.url
  endif
  if trophy_url == blank
    assign trophy_url = '/products/custom-trophy'
  endif

  assign plaque_mockup = section.settings.plaque_mockup
  if plaque_mockup == blank and plaque_product != blank
    assign plaque_mockup = plaque_product.featured_image
  endif
  assign trophy_mockup = section.settings.trophy_mockup
  if trophy_mockup == blank and trophy_product != blank
    assign trophy_mockup = trophy_product.featured_image
  endif
-%}

<section id="sbl-ap-{{ section.id }}" class="sbl-ap" aria-labelledby="sbl-ap-title-{{ section.id }}">
  <div class="sbl-ap__intro">
    <div class="sbl-ap__wrap">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sbl-ap__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="sbl-ap-title-{{ section.id }}" class="sbl-ap__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="sbl-ap__lead">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      <div class="sbl-ap__benefits" aria-label="Designer benefits">
        <span>Live previews</span>
        <span>No artwork fees</span>
        <span>Fast personalization</span>
      </div>
    </div>
  </div>

  <div class="sbl-ap__wrap sbl-ap__cards">
    <article class="sbl-ap-card">
      <a class="sbl-ap-card__visual" href="{{ plaque_url }}" aria-label="{{ section.settings.plaque_button | escape }}">
        <div class="sbl-ap-card__browser">
          <div class="sbl-ap-card__browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          {%- if section.settings.plaque_designer_image != blank -%}
            {{ section.settings.plaque_designer_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'eager', alt: section.settings.plaque_image_alt }}
          {%- else -%}
            <img src="{{ 'sbl-plaque-designer-shot.jpg' | asset_url }}" alt="{{ section.settings.plaque_image_alt | escape }}" width="1600" height="835" loading="eager">
          {%- endif -%}
        </div>
        {%- if plaque_mockup != blank -%}
          <div class="sbl-ap-card__mockup">
            {{ plaque_mockup | image_url: width: 440 | image_tag: widths: '220, 320, 440', sizes: '180px', loading: 'lazy', alt: 'Custom plaque example' }}
          </div>
        {%- endif -%}
      </a>
      <div class="sbl-ap-card__content">
        <p class="sbl-ap-card__number">01</p>
        <h2>{{ section.settings.plaque_heading | escape }}</h2>
        <p class="sbl-ap-card__copy">{{ section.settings.plaque_text | escape }}</p>
        <ul>
          <li>Choose a plaque layout, size, and finish</li>
          <li>Add names, titles, dates, and your logo</li>
          <li>Review the live preview before ordering</li>
        </ul>
        <a class="sbl-ap__button" href="{{ plaque_url }}">{{ section.settings.plaque_button | escape }}</a>
      </div>
    </article>

    <article class="sbl-ap-card sbl-ap-card--reverse">
      <a class="sbl-ap-card__visual" href="{{ trophy_url }}" aria-label="{{ section.settings.trophy_button | escape }}">
        <div class="sbl-ap-card__browser">
          <div class="sbl-ap-card__browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          {%- if section.settings.trophy_designer_image != blank -%}
            {{ section.settings.trophy_designer_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', alt: section.settings.trophy_image_alt }}
          {%- else -%}
            <img src="{{ 'sbl-trophy-designer-shot.jpg' | asset_url }}" alt="{{ section.settings.trophy_image_alt | escape }}" width="1600" height="1070" loading="lazy">
          {%- endif -%}
        </div>
        {%- if trophy_mockup != blank -%}
          <div class="sbl-ap-card__mockup">
            {{ trophy_mockup | image_url: width: 440 | image_tag: widths: '220, 320, 440', sizes: '180px', loading: 'lazy', alt: 'Custom trophy example' }}
          </div>
        {%- endif -%}
      </a>
      <div class="sbl-ap-card__content">
        <p class="sbl-ap-card__number">02</p>
        <h2>{{ section.settings.trophy_heading | escape }}</h2>
        <p class="sbl-ap-card__copy">{{ section.settings.trophy_text | escape }}</p>
        <ul>
          <li>Pick the award and plate finish</li>
          <li>Personalize one trophy or import a team list</li>
          <li>Switch between plate and trophy previews</li>
        </ul>
        <a class="sbl-ap__button" href="{{ trophy_url }}">{{ section.settings.trophy_button | escape }}</a>
      </div>
    </article>

    <div class="sbl-ap__shop-heading">
      {%- if section.settings.shop_eyebrow != blank -%}
        <p>{{ section.settings.shop_eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.shop_heading | escape }}</h2>
      {%- if section.settings.shop_text != blank -%}
        <div>{{ section.settings.shop_text | escape }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #sbl-ap-{{ section.id }} {
    --ap-navy: {{ section.settings.background_color }};
    --ap-navy-2: #18365c;
    --ap-accent: {{ section.settings.accent_color }};
    --ap-btn: {{ section.settings.button_color }};
    --ap-btn-text: {{ section.settings.button_text_color }};
    --ap-ink: #0f2744;
    --ap-muted: #5a6577;
    color: var(--ap-ink);
    background: #f5f1eb;
    margin: 0 0 32px;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__wrap {
    max-width: 1170px;
    margin: 0 auto;
    padding: 0 20px;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__intro {
    padding: clamp(56px, 8vw, 104px) 0 clamp(112px, 13vw, 160px);
    color: #fff;
    text-align: center;
    background:
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(201, 147, 46, 0.2) 0%, transparent 70%),
      linear-gradient(160deg, var(--ap-navy) 0%, #0a1c33 100%);
  }
  #sbl-ap-{{ section.id }} .sbl-ap__eyebrow,
  #sbl-ap-{{ section.id }} .sbl-ap__shop-heading p {
    margin: 0 0 14px;
    color: var(--ap-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__heading {
    max-width: 860px;
    margin: 0 auto 20px;
    color: #fff;
    font-size: clamp(36px, 5.6vw, 64px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.5px;
    text-transform: none;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__heading em {
    color: var(--ap-accent);
    font-style: italic;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__lead {
    max-width: 700px;
    margin: 0 auto;
    color: rgba(245, 241, 235, 0.82);
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.7;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__benefits {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 28px;
    color: rgba(245, 241, 235, 0.9);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__benefits span::before {
    content: "✓";
    margin-right: 8px;
    color: var(--ap-accent);
  }
  #sbl-ap-{{ section.id }} .sbl-ap__cards {
    display: grid;
    gap: 32px;
    margin-top: clamp(-100px, -9vw, -72px);
    padding-bottom: 48px;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    min-height: 460px;
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(15, 39, 68, 0.14);
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card--reverse .sbl-ap-card__visual { order: 2; }
  #sbl-ap-{{ section.id }} .sbl-ap-card__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 420px;
    padding: clamp(26px, 4.5vw, 54px);
    background: #eee7da;
    text-decoration: none;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card--reverse .sbl-ap-card__visual { background: #e6e0d4; }
  #sbl-ap-{{ section.id }} .sbl-ap-card__browser {
    width: 100%;
    overflow: hidden;
    border: 1px solid rgba(15, 39, 68, 0.12);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 20px 45px rgba(15, 39, 68, 0.18);
    transition: transform 0.2s;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__visual:hover .sbl-ap-card__browser { transform: translateY(-2px); }
  #sbl-ap-{{ section.id }} .sbl-ap-card__browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border-bottom: 1px solid #e3dccd;
    background: #fff;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__browser-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #cfc6b5;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__browser img {
    display: block;
    width: 100%;
    height: 330px;
    object-fit: contain;
    background: #fff;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__mockup {
    position: absolute;
    right: clamp(8px, 2vw, 22px);
    bottom: clamp(8px, 2vw, 22px);
    width: clamp(104px, 14vw, 160px);
    padding: 8px;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 15px 35px rgba(15, 39, 68, 0.2);
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__mockup img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 5.5vw, 64px);
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__number {
    margin: 0 0 16px;
    color: #9a6c17;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__content h2 {
    margin: 0 0 16px;
    color: var(--ap-ink);
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.3px;
    text-transform: none;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__copy {
    margin: 0;
    color: var(--ap-muted);
    font-size: 16px;
    line-height: 1.7;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__content ul {
    display: grid;
    gap: 9px;
    margin: 22px 0 26px;
    padding: 0;
    list-style: none;
    color: #3c4658;
  }
  #sbl-ap-{{ section.id }} .sbl-ap-card__content li { margin: 0; }
  #sbl-ap-{{ section.id }} .sbl-ap-card__content li::before {
    content: "✓";
    margin-right: 9px;
    color: #9a6c17;
    font-weight: 700;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__button {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    min-height: 48px;
    padding: 0 26px;
    border: 2px solid var(--ap-btn);
    border-radius: 8px;
    background: var(--ap-btn);
    color: var(--ap-btn-text);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s, filter 0.2s;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__button:hover,
  #sbl-ap-{{ section.id }} .sbl-ap__button:focus-visible {
    color: var(--ap-btn-text);
    filter: brightness(1.06);
    transform: translateY(-1px);
  }
  #sbl-ap-{{ section.id }} .sbl-ap__shop-heading {
    max-width: 720px;
    margin: 18px auto 0;
    text-align: center;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__shop-heading h2 {
    margin: 0 0 10px;
    color: var(--ap-ink);
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0;
  }
  #sbl-ap-{{ section.id }} .sbl-ap__shop-heading div {
    color: var(--ap-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  @media (max-width: 989px) {
    #sbl-ap-{{ section.id }} .sbl-ap-card { grid-template-columns: 1fr; }
    #sbl-ap-{{ section.id }} .sbl-ap-card--reverse .sbl-ap-card__visual { order: 0; }
    #sbl-ap-{{ section.id }} .sbl-ap-card__visual { min-height: 340px; }
  }
  @media (max-width: 549px) {
    #sbl-ap-{{ section.id }} .sbl-ap__cards { margin-top: -80px; }
    #sbl-ap-{{ section.id }} .sbl-ap-card__visual { min-height: 260px; padding: 18px; }
    #sbl-ap-{{ section.id }} .sbl-ap-card__browser img { height: 220px; }
    #sbl-ap-{{ section.id }} .sbl-ap-card__content { padding: 30px 22px 36px; }
    #sbl-ap-{{ section.id }} .sbl-ap__button { width: 100%; }
  }
</style>

{% schema %}
{
  "name": "Awards & Plaques hero",
  "tag": "div",
  "class": "section-awards-plaques-hero",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Awards & Plaques · Design It Online" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Awards as individual as<br><em>the people receiving them.</em>" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Build a personalized plaque or trophy online, see your wording before you order, and create recognition that feels genuinely personal." },
    { "type": "header", "content": "Plaque designer" },
    { "type": "text", "id": "plaque_product_handle", "label": "Custom plaque product handle", "default": "custom-plaque" },
    { "type": "text", "id": "plaque_heading", "label": "Heading", "default": "Design a custom plaque" },
    { "type": "textarea", "id": "plaque_text", "label": "Description", "default": "Create an award plaque with your own wording, logo, and finish. The live designer shows exactly how your plaque will look before it reaches our shop." },
    { "type": "image_picker", "id": "plaque_designer_image", "label": "Designer screenshot", "info": "Leave empty to use the included screenshot of the real plaque designer." },
    { "type": "image_picker", "id": "plaque_mockup", "label": "Product mockup" },
    { "type": "text", "id": "plaque_image_alt", "label": "Designer image alt text", "default": "The custom plaque designer with a live plaque preview" },
    { "type": "url", "id": "plaque_link", "label": "Design button link" },
    { "type": "text", "id": "plaque_button", "label": "Button label", "default": "Design a plaque" },
    { "type": "header", "content": "Trophy designer" },
    { "type": "text", "id": "trophy_product_handle", "label": "Custom trophy product handle", "default": "custom-trophy" },
    { "type": "text", "id": "trophy_heading", "label": "Heading", "default": "Build a personalized trophy" },
    { "type": "textarea", "id": "trophy_text", "label": "Description", "default": "Choose the trophy, plate finish, type style, and wording. Design one award or prepare an entire team list in the same guided tool." },
    { "type": "image_picker", "id": "trophy_designer_image", "label": "Designer screenshot", "info": "Leave empty to use the included screenshot of the real trophy designer." },
    { "type": "image_picker", "id": "trophy_mockup", "label": "Product mockup" },
    { "type": "text", "id": "trophy_image_alt", "label": "Designer image alt text", "default": "The custom trophy designer with a live engraved plate preview" },
    { "type": "url", "id": "trophy_link", "label": "Design button link" },
    { "type": "text", "id": "trophy_button", "label": "Button label", "default": "Design a trophy" },
    { "type": "header", "content": "Product grid introduction" },
    { "type": "text", "id": "shop_eyebrow", "label": "Eyebrow", "default": "More ways to recognize" },
    { "type": "text", "id": "shop_heading", "label": "Heading", "default": "Shop awards & plaques" },
    { "type": "textarea", "id": "shop_text", "label": "Text", "default": "Prefer a ready-made format? Browse our medals, plaques, and trophies below." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Hero background", "default": "#0f2744" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#c9932e" },
    { "type": "color", "id": "button_color", "label": "Buttons", "default": "#c9932e" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#0f2744" }
  ]
}
{% endschema %}
